<Project>
  <!-- Central Package Management: every package version lives here, once (ADR 0003). The
       rule: no new package without asking (the kit's rule "Packages"), and every package
       gets a "why" here, an entry in THIRD-PARTY-NOTICES.md and, for the core, one in
       ThirdParty.cs (the rule "Package notices", ADR 0023). ThirdPartyTests reads the
       PackageReference names from AstroPhotoAnalyzer.Core.csproj; the versions are here. -->
  <ItemGroup>
    <!-- Decodes TIFF, PNG and JPEG (the pixels every measurement runs on) and encodes JPEG
         and TIFF for the export table. Pinned to 3.1.x on purpose: 4.x adds a licence-key
         MSBuild task that errors on Release builds (ADR 0009, docs/design/dependencies.md). -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.11" />
    <!-- Evaluates the tables of an ICC printer profile (v2 lut8/lut16, v4 lutAToB), from which
         the paper's Dmax is read (ADR 0030). MIT, pure managed, no dependencies. Chosen over a
         hand-written reader after it matched one to the last digit on two real profiles. -->
    <PackageVersion Include="Wacton.Unicolour" Version="8.0.0" />
    <!-- The diagnostic log beside each executable (R-170 to R-173, ADR 0069): configured in
         code, a size-rolled text file, BSD-3-Clause, purely managed, so the console stays one
         copyable file. The version every tool of the suite pins for the same log (FlatCheck's
         ADR 0070, DarksCheck's ADR 0025): AstroDarkroom publishes the windows into one folder,
         where a second version of NLog.dll would stop its release. The owner asked for NLog by
         name on 2026-10-31. -->
    <PackageVersion Include="NLog" Version="6.2.2" />
    <!-- NLog's own file target with the operating system's atomic append, so two windows
         writing one log at once lose no line (R-173): FlatCheck measured NLog's plain target
         losing 33 to 48 lines of 4000 and this one none (its ADR 0070). Same project, commit
         and licence as NLog, no native file of its own; taken at the owner's word of
         2026-10-31. Keep its version equal to NLog's. -->
    <PackageVersion Include="NLog.Targets.AtomicFile" Version="6.2.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test host and runner (xUnit 2: no dynamic skip, which is why an absent reference
         image returns early with a message instead of skipping). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>
</Project>
