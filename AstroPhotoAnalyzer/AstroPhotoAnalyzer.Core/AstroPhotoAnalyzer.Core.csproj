<Project Sdk="Microsoft.NET.Sdk">

  <!-- The core: everything that computes and everything that formats. It knows nothing about
       the console or about windows, and it must not - that is why two applications can sit
       on top of it without a single figure being duplicated. The boundary is one of
       compilation, not of goodwill: nothing here CAN reach Console, because there is no entry
       point to call it.

       The version and the copyright are NOT here: they come from Directory.Build.props, so
       that they are the same in every assembly. See the comment there. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AstroPhotoAnalyzer</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The external dependencies. The rule is the kit's ("Packages", in
       .claude/rules/kit/process.md) and the project's ("Package notices", in CLAUDE.md), with
       the reasons in ADR 0009 and in docs/design/dependencies.md: they are discussed
       beforehand and approved, neither avoided nor added in silence. The licence of each one
       and WHY it is compatible with GPLv3 are written in THIRD-PARTY-NOTICES.md.

       SixLabors.ImageSharp decodes TIFF and PNG (8 and 16 bits, with the ICC profile) and
       JPEG (8 bits), and, for the export table, encodes JPEG and the 8-bit LZW TIFF and
       decodes the JPEG back. Unlike in FlatCheck, here the package is NOT peripheral: the
       pixels on which all the measurements are made pass through it,
       and the figures in the JPEG table are its encoder's. The alternative - a hand-written
       TIFF reader (LZW, Deflate, strips, tiles, predictor) plus a JPEG encoder of our own -
       would have been weeks of work to reproduce something that exists and is tested. The
       FITS reader stays hand-written, because there it is honest: it is a format of 2880
       bytes per block.

       The version is PINNED to 3.1.x for both legal reasons (the grant comes with the
       version taken) and practical ones: from 4.0.0 the package brings an MSBuild task that
       asks for a licence key at compile time - a warning on Debug, an ERROR on Release. 3.1.x
       has exactly the same terms and no task. See THIRD-PARTY-NOTICES.md.

       The version number no longer sits here: it is in Directory.Packages.props, beside the
       solution, once for all the projects (central package management, ADR 0003). Only the
       package's name stays here, which ThirdPartyTests reads. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- The tables of ICC printer profiles, for the Dmax from the profile (ADR 0030). -->
    <PackageReference Include="Wacton.Unicolour" />
  </ItemGroup>

  <!-- The embedded data: the Lynds catalogue of dark nebulae (ADR 0025), a 52 KB text file
       read by DarkNebulaCatalogue. It is not a package, but it is written by others: its
       entry in ThirdParty.cs and its notice in THIRD-PARTY-NOTICES.md are required just the
       same (ThirdPartyTests reads this list too). -->
  <ItemGroup>
    <EmbeddedResource Include="Input\ldn.txt" LogicalName="ldn.txt" />
  </ItemGroup>

  <!-- The core stays internal in its entirety: its consumers are in the same repo and are
       compiled together. The list below is not a loophole, it is the contract. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AstroPhotoAnalyzer" />
    <InternalsVisibleTo Include="AstroPhotoAnalyzer.Tests" />
    <InternalsVisibleTo Include="AstroPhotoAnalyzer.Wpf" />
    <InternalsVisibleTo Include="AstroPhotoAnalyzer.Wpf.Tests" />
  </ItemGroup>

</Project>
