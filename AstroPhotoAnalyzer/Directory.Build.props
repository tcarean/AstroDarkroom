<Project>

  <!-- Proprietatile comune tuturor proiectelor din solutie.

       De ce aici si nu in fiecare csproj: nucleul e o biblioteca separata
       (AstroPhotoAnalyzer.Core), iar versiunea trebuie sa fie aceeasi in toate
       assembly-urile. VersionInfo o citeste din assembly-ul in care sta el - adica din
       Core - dar exe-ul de consola si aplicatia WPF si-o poarta si ele pe a lor, care se
       vede in proprietatile fisierului. Doua locuri de editat inseamna, mai devreme sau
       mai tarziu, doua valori diferite.

       Deci: UN SINGUR loc de editat. Nu muta <Version> sau <Copyright> intr-un csproj.
       VersionTests verifica fisierul asta. -->

  <PropertyGroup>
    <!-- Versiunea uneltei. Se incrementeaza MANUAL, de mana, la fiecare feature/fix. -->
    <Version>1.0.0</Version>

    <!-- Copyright-ul si licenta. <Copyright> ajunge in AssemblyCopyrightAttribute, de
         unde il citeste VersionInfo.Copyright si il tipareste sub banner. Programul e
         GPLv3; textul complet e in LICENSE, langa solutie. -->
    <Copyright>Copyright (C) 2026 Tudor Carean</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Reproductibilitate (ADR 0003): aceleasi surse, aceiasi octeti; versiunea fiecarui
       pachet o singura data, in Directory.Packages.props; graful complet in
       packages.lock.json, pe care CI-ul il restaureaza in modul blocat. Strictetea
       (avertismentele ca erori) o aplica scripts/verify.ps1 din linia de comanda, nu
       fisierul asta, ca un build din IDE sa ramana ingaduitor, iar gate-ul nu. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Runtime-ul pentru care publica release-ul (kit.json, release.publish: -r win-x64).
         Declarat aici, fiecare restore ii scrie sectiunea in packages.lock.json; altfel un
         publish pentru el rescrie fisierele lock si release-ul se opreste pe ele. Proiectele de
         teste nu se publica niciodata, deci nu il declara (ADR 0031). -->
    <RuntimeIdentifiers Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">win-x64</RuntimeIdentifiers>

    <!-- Analizorul single-file, pe care PublishSingleFile il porneste la publish-ul consolei,
         isi aduce pachetul (Microsoft.NET.ILLink.Tasks, la versiunea SDK-ului instalat) in
         fisierele lock. Oprit, un publish le lasa neatinse (ADR 0031). -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>

    <!-- Avertismentele de audit NuGet (NU1902 moderat, NU1903 ridicat: un pachet are un
         advisory publicat) raman avertismente si cand gate-ul cere -warnaserror: gate-ul le
         arata, nu le ascunde, dar nu se inroseste pe ele. ImageSharp 3.1.11 e tintuit (ADR
         0009) si singura versiune cu cele cinci advisory-uri din 2026 reparate e 4.1.2, pe care
         ADR 0009 o refuza; fiecare advisory e citit si judecat in ADR 0036 si in
         docs/design/dependencies.md, unde intra si urmatorul. -->
    <MSBuildWarningsNotAsErrors>NU1902;NU1903</MSBuildWarningsNotAsErrors>

    <!-- Fisierul de documentatie XML (ADR 0038). Generat, compilatorul verifica fiecare
         comentariu ///, si gate-ul (-warnaserror) face din fiecare abatere o eroare: XML
         stricat (CS1570), un <param> sau <paramref> care nu numeste niciun parametru (CS1572,
         CS1734), un parametru fara tag langa altele cu tag (CS1573), un cref care nu se
         rezolva sau e ambiguu (CS1574, CS0419). CS1591 (comentariu lipsa) ramane oprit:
         regula "Documentation comments" cere comentariul pe fiecare tip si metoda, si pe cele
         private, si nimic nu o verifica; CS1591 ar cere doar membrii publici, proprietatile
         cu tot, iar nucleul e internal in intregime (ADR 0035 al kit-ului). Nimic nu citeste
         fisierele XML la rulare, deci niciun publish nu le livreaza: consola ramane un singur
         fisier. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>

</Project>
