<Project>

  <!-- The properties common to all the projects in the solution.

       Why here and not in each csproj: the core is a separate library
       (AstroPhotoAnalyzer.Core), and the version must be the same in all the assemblies.
       VersionInfo reads it from the assembly it sits in - that is, from Core - but the
       console exe and the WPF application carry their own too, which shows in the file's
       properties. Two places to edit mean, sooner or later, two different values.

       So: ONE SINGLE place to edit. Do not move <Version> or <Copyright> into a csproj.
       VersionTests checks this file. -->

  <PropertyGroup>
    <!-- The tool's version. It changes only at the owner's word, at a release
         (scripts/release.ps1), never with a feature or a fix (the kit's rule "Version and
         year are the owner's"). -->
    <Version>1.0.0</Version>

    <!-- The copyright and the licence. <Copyright> ends up in AssemblyCopyrightAttribute,
         from where VersionInfo.Copyright reads it and prints it under the banner. The program
         is GPLv3; the full text is in LICENSE, beside the solution. -->
    <Copyright>Copyright (C) 2026 Tudor Carean</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Reproducibility (ADR 0003): the same sources, the same bytes; each package's version
       once, in Directory.Packages.props; the complete graph in packages.lock.json, which CI
       restores in locked mode. The strictness (warnings as errors) is applied by
       scripts/verify.ps1 from the command line, not by this file, so that a build from the
       IDE stays lenient, and the gate does not. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- The runtime the release publishes for (kit.json, release.publish: -r win-x64).
         Declared here, every restore writes its section into packages.lock.json; otherwise a
         publish for it rewrites the lock files and the release stops on them. The test
         projects are never published, so they do not declare it (ADR 0031). -->
    <RuntimeIdentifiers Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">win-x64</RuntimeIdentifiers>

    <!-- The single-file analyzer, which PublishSingleFile starts at the console's publish,
         brings its package (Microsoft.NET.ILLink.Tasks, at the installed SDK's version) into
         the lock files. Turned off, a publish leaves them untouched (ADR 0031). -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>

    <!-- The NuGet audit warnings (NU1902 moderate, NU1903 high: a package has a published
         advisory) stay warnings even when the gate asks for -warnaserror: the gate shows
         them, it does not hide them, but it does not turn red on them. ImageSharp 3.1.11 is
         pinned (ADR 0009) and the only version with the five advisories of 2026 fixed is
         4.1.2, which ADR 0009 refuses; each advisory is read and judged in ADR 0036 and in
         docs/design/dependencies.md, where the next one goes too. -->
    <MSBuildWarningsNotAsErrors>NU1902;NU1903</MSBuildWarningsNotAsErrors>

    <!-- The XML documentation file (ADR 0038). When it is generated, the compiler checks
         every /// comment, and the gate (-warnaserror) turns every deviation into an error:
         broken XML (CS1570), a <param> or <paramref> that names no parameter (CS1572,
         CS1734), a parameter without a tag beside others with tags (CS1573), a cref that does
         not resolve or is ambiguous (CS1574, CS0419), a /// on something that is not a
         member, for instance a local function (CS1587). CS1591 (a missing comment) stays off:
         the rule "Documentation comments" asks for the comment on every type and method,
         private ones too, and nothing checks it; CS1591 would ask only for the public
         members, properties included, and the core is internal in its entirety (the kit's
         ADR 0035). Nothing reads the XML files at run time, so no publish ships them: the
         console stays a single file. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>

</Project>
