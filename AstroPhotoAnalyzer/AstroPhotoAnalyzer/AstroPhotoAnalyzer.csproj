<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aplicatia de consola. Nu contine decat punctul de intrare, parsarea argumentelor
       si dispeceratul; tot ce calculeaza si tot ce formateaza sta in
       AstroPhotoAnalyzer.Core.

       Versiunea si copyright-ul vin din Directory.Build.props - un singur loc pentru
       toate proiectele. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AstroPhotoAnalyzer</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AstroPhotoAnalyzer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Icoana din proprietatile fisierului si din Explorer. Acelasi fisier ca la
         aplicatia WPF, din Icon/ la radacina - generat de Icon/make_icon.py. -->
    <ApplicationIcon>..\Icon\AstroPhotoAnalyzer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstroPhotoAnalyzer.Core\AstroPhotoAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstroPhotoAnalyzer.Tests" />
  </ItemGroup>

</Project>
