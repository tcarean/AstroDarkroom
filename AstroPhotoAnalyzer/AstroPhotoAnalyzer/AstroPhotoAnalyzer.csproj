<Project Sdk="Microsoft.NET.Sdk">

  <!-- The console application. It contains nothing but the entry point, the argument
       parsing and the dispatch; everything that computes and everything that formats sits
       in AstroPhotoAnalyzer.Core.

       The version and the copyright come from Directory.Build.props - a single place for
       all the projects. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AstroPhotoAnalyzer</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AstroPhotoAnalyzer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The icon in the file's properties and in Explorer. The same file as the WPF
         application's, from Icon/ at the root - generated by Icon/make_icon.py. -->
    <ApplicationIcon>..\Icon\AstroPhotoAnalyzer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstroPhotoAnalyzer.Core\AstroPhotoAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstroPhotoAnalyzer.Tests" />
  </ItemGroup>

</Project>
