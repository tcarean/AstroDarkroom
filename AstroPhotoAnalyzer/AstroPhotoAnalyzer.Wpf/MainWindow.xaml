<!-- MainWindow - bara cu fisierul, panoul de parametri in stanga, cele sase taburi in
     dreapta. Fara imagine, in locul taburilor sta o invitatie; cu eroare, un card. -->

<Window x:Class="AstroPhotoAnalyzer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf"
        Title="AstroPhotoAnalyzer" Height="860" Width="1400" WindowState="Maximized"
        Icon="/AstroPhotoAnalyzer.Wpf;component/Icon/AstroPhotoAnalyzer.ico"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="ShowAbout" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================================================ bara de sus -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Faint}" Text="IMAGINE" />
          <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Path}"
                     Visibility="{Binding HasPath, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="(niciuna aleasa)"
                     Visibility="{Binding HasPath, Converter={StaticResource NotBoolToVis}}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Deschide imagine..." Click="ChooseImage" IsEnabled="{Binding IsIdle}" />
          <Button Content="Salveaza raportul..." Click="SaveReport" IsEnabled="{Binding CanSave}" Margin="10,0,0,0" />
          <Button Content="Despre" Command="Help" ToolTip="Versiune, licenta, componente (F1)" Margin="10,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ continut -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- parametrii -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Margin="16" DataContext="{Binding Parameters}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="PARAMETRI" />

            <TextBlock Style="{StaticResource Faint}" Text="Mediu de print" />
            <ComboBox ItemsSource="{Binding Media}" SelectedItem="{Binding Medium, Mode=TwoWay}" Margin="0,3,0,10" />

            <TextBlock Style="{StaticResource Faint}" Text="Dmax explicit (gol = din mediu)" />
            <TextBox Style="{StaticResource Field}" Text="{Binding Dmax, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />

            <TextBlock Style="{StaticResource Faint}" Text="Distanta de privire, m (gol = 1.5 x diagonala)" ToolTip="{Binding DistanceHelp}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     ToolTip="{Binding DistanceHelp}" />

            <TextBlock Style="{StaticResource Faint}" Text="Latimi candidate, cm" />
            <TextBox Style="{StaticResource Field}" Text="{Binding Sizes, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />

            <TextBlock Style="{StaticResource Faint}" Text="Raport de aspect tinta, ex. 50:35 (gol = nativ)" ToolTip="{Binding AspectHelp}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding Aspect, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     ToolTip="{Binding AspectHelp}" />

            <TextBlock Style="{StaticResource Faint}" Text="Fundal-tinta in plus in simulare (0..1, gol = doar grila)" ToolTip="{Binding TargetBgHelp}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding TargetBg, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     ToolTip="{Binding TargetBgHelp}" />

            <TextBlock Style="{StaticResource Faint}" Text="WCS din FITS (optional, aceeasi marime)" ToolTip="{Binding WcsHelp}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding WcsPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     ToolTip="{Binding WcsHelp}" />

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" ToolTip="{Binding PassepartoutHelp}">
                <TextBlock Style="{StaticResource Faint}" Text="Passepartout, cm" />
                <TextBox Style="{StaticResource Field}" Text="{Binding Passepartout, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"
                         ToolTip="{Binding PassepartoutHelp}" />
              </StackPanel>
              <StackPanel Grid.Column="2" ToolTip="{Binding FrameHelp}">
                <TextBlock Style="{StaticResource Faint}" Text="Rama, cm" />
                <TextBox Style="{StaticResource Field}" Text="{Binding Frame, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"
                         ToolTip="{Binding FrameHelp}" />
              </StackPanel>
            </Grid>

            <Button Content="Analizeaza" Click="Analyze" Margin="0,6,0,0"
                    IsEnabled="{Binding DataContext.CanRun, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Numerele cu punct zecimal. Parametrii se aplica la urmatoarea analiza." />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- rezultatul -->
      <Grid Grid.Column="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasResult}" Value="False" />
                    <Condition Binding="{Binding HasError}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="Deschide o imagine finita" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                     Text="TIFF, PNG sau FITS deja stretch-uit - ce ai exporta din Siril pentru print. Unealta masoara si recomanda; nu scrie niciun fisier de trimis la laborator." />
          <Button Content="Deschide imagine..." Margin="0,22,0,0" HorizontalAlignment="Center" Click="ChooseImage" />
        </StackPanel>

        <Border MaxWidth="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource Card}" BorderBrush="#5A3A3A" Background="#2A2224" Margin="24"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Analiza nu a mers" FontSize="15" FontWeight="SemiBold" Foreground="#F0857E" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding Error}" />
          </StackPanel>
        </Border>

        <TabControl Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
          <TabItem Header="Raport">
            <local:ReportView DataContext="{Binding Report}" />
          </TabItem>
          <TabItem Header="Tonuri">
            <local:TonesView DataContext="{Binding Tones}" />
          </TabItem>
          <TabItem Header="Export">
            <local:ExportView DataContext="{Binding Export}" />
          </TabItem>
          <TabItem Header="Rezolutie">
            <local:ResolutionView DataContext="{Binding Resolution}" />
          </TabItem>
          <TabItem Header="Culoare">
            <local:BackgroundView DataContext="{Binding Background}" />
          </TabItem>
          <TabItem Header="Preview">
            <local:PreviewView DataContext="{Binding Preview}" />
          </TabItem>
        </TabControl>

        <local:BusyOverlay />
      </Grid>
    </Grid>
  </Grid>
</Window>
