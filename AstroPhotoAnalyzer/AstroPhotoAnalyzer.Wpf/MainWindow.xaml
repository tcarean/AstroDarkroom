<!-- MainWindow - the bar with the file, the parameter panel on the left, the seven tabs on
     the right. Without an image, an invitation stands in place of the tabs; with an error,
     a card. -->

<Window x:Class="AstroPhotoAnalyzer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf"
        Title="AstroPhotoAnalyzer" Height="860" Width="1400" WindowState="Maximized"
        Icon="/AstroPhotoAnalyzer.Wpf;component/Icon/AstroPhotoAnalyzer.ico"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="ShowAbout" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================================================ top bar -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Faint}" Text="{local:T En=IMAGE, Ro=IMAGINE}" />
          <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Path}"
                     Visibility="{Binding HasPath, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{local:T En='(none chosen)', Ro='(niciuna aleasa)'}"
                     Visibility="{Binding HasPath, Converter={StaticResource NotBoolToVis}}" />
          <!-- The ICC profile in use (R-155): the name and the core's sentence, red when its file
               can no longer be read (R-156), muted when there is none; "Scoate" only beside a
               profile, and never during a run, as the choice that re-runs is. -->
          <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" Text="{local:T En='ICC PROFILE', Ro='PROFIL ICC'}" />
          <!-- A grid, not a horizontal StackPanel: in a panel of infinite width a long reason
               would push the button out of the column instead of being trimmed. -->
          <Grid Margin="0,3,0,0" DataContext="{Binding Parameters}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MaxWidth="700" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProfileText" Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ProfileText}" ToolTip="{Binding ProfileText}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasProfile}" Value="False">
                      <Setter Property="Foreground" Value="{StaticResource MutedBr}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ProfileIsProblem}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource BadBr}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button x:Name="ClearProfileButton" Grid.Column="1" Content="{local:T En='Clear', Ro='Scoate'}" Click="ClearProfile" Padding="8,2" FontSize="11" Margin="10,0,0,0"
                    Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}"
                    IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{local:T En='Stops using the profile: the Dmax of the medium is back, and the analysis runs again', Ro='Nu mai foloseste profilul: revine Dmax-ul mediului, si analiza se reia'}" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <StackPanel x:Name="TopButtons" Orientation="Horizontal">
            <Button Content="{local:T En='Open image...', Ro='Deschide imagine...'}" Click="ChooseImage" IsEnabled="{Binding IsIdle}" />
            <Button Content="{local:T En='Save the report...', Ro='Salveaza raportul...'}" Click="SaveReport" IsEnabled="{Binding CanSave}" Margin="10,0,0,0" />
            <Button Content="{local:T En='About', Ro='Despre'}" Command="Help" ToolTip="{local:T En='Version, licence, components (F1)', Ro='Versiune, licenta, componente (F1)'}" Margin="10,0,0,0" />
          </StackPanel>
          <!-- A fixed place, two lines high, for the save outcome: its appearance does not move
               the buttons. The width is the button row's: the column is Auto, and without a
               finite width the text would neither wrap nor be shortened, but would widen the
               column until it runs out of the window. -->
          <Grid Height="34" Margin="0,4,0,0" Width="{Binding ActualWidth, ElementName=TopButtons}">
            <TextBlock x:Name="SaveMessageText" Style="{StaticResource Faint}" Text="{Binding SaveMessage}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SaveMessage}" />
            <TextBlock x:Name="SaveErrorText" Text="{Binding SaveError}" Foreground="{StaticResource BadBr}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SaveError}" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- the parameters -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Margin="16" DataContext="{Binding Parameters}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{local:T En='PARAMETERS', Ro='PARAMETRI'}" />

            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='Print medium', Ro='Mediu de print'}" />
            <ComboBox ItemsSource="{Binding Media}" SelectedItem="{Binding Medium, Mode=TwoWay}" Margin="0,3,0,10" />

            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='Dmax (of the chosen medium; can be changed)', Ro='Dmax (al mediului ales; se poate schimba)'}" />
            <Grid Margin="0,3,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Style="{StaticResource Field}" Text="{Binding Dmax, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="{local:T En='From ICC profile...', Ro='Din profil ICC...'}" Click="ChooseProfile"
                      IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                      ToolTip="{local:T En='Reads the Dmax from the ICC profile of the paper on its printer: the list of installed profiles, or a file; the analysis then runs again', Ro='Citeste Dmax-ul din profilul ICC al hartiei pe imprimanta ei: lista profilelor instalate, sau un fisier; analiza se reia apoi'}" />
            </Grid>

            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='Viewing distance, m (empty = 1.5 x diagonal)', Ro='Distanta de privire, m (gol = 1.5 x diagonala)'}" ToolTip="{Binding DistanceHelp}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     ToolTip="{Binding DistanceHelp}" />

            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='Candidate widths, cm', Ro='Latimi candidate, cm'}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding Sizes, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />

            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='Target aspect ratio, e.g. 50:35 (empty = native)', Ro='Raport de aspect tinta, ex. 50:35 (gol = nativ)'}" ToolTip="{Binding AspectHelp}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding Aspect, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     ToolTip="{Binding AspectHelp}" />

            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='Extra target background in the simulation (0..1, empty = grid only)', Ro='Fundal-tinta in plus in simulare (0..1, gol = doar grila)'}" ToolTip="{Binding TargetBgHelp}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding TargetBg, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     ToolTip="{Binding TargetBgHelp}" />

            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='WCS from a FITS (optional, same size)', Ro='WCS din FITS (optional, aceeasi marime)'}" ToolTip="{Binding WcsHelp}" />
            <TextBox Style="{StaticResource Field}" Text="{Binding WcsPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     ToolTip="{Binding WcsHelp}" />

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" ToolTip="{Binding PassepartoutHelp}">
                <TextBlock Style="{StaticResource Faint}" Text="Passepartout, cm" />
                <TextBox Style="{StaticResource Field}" Text="{Binding Passepartout, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"
                         ToolTip="{Binding PassepartoutHelp}" />
              </StackPanel>
              <StackPanel Grid.Column="2" ToolTip="{Binding FrameHelp}">
                <TextBlock Style="{StaticResource Faint}" Text="{local:T En='Frame, cm', Ro='Rama, cm'}" />
                <TextBox Style="{StaticResource Field}" Text="{Binding Frame, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"
                         ToolTip="{Binding FrameHelp}" />
              </StackPanel>
            </Grid>

            <Button Content="{local:T En='Analyse', Ro='Analizeaza'}" Click="Analyze" Margin="0,6,0,0"
                    IsEnabled="{Binding DataContext.CanRun, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="{local:T En='Numbers with a decimal point. The parameters apply to the next analysis.', Ro='Numerele cu punct zecimal. Parametrii se aplica la urmatoarea analiza.'}" />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- the result -->
      <Grid Grid.Column="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasResult}" Value="False" />
                    <Condition Binding="{Binding HasError}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{local:T En='Open a finished image', Ro='Deschide o imagine finita'}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                     Text="{local:T En='An already stretched TIFF, PNG or FITS - what you would export from Siril for print. The tool measures and recommends; it writes no file to send to the lab.', Ro='TIFF, PNG sau FITS deja stretch-uit - ce ai exporta din Siril pentru print. Unealta masoara si recomanda; nu scrie niciun fisier de trimis la laborator.'}" />
          <Button Content="{local:T En='Open image...', Ro='Deschide imagine...'}" Margin="0,22,0,0" HorizontalAlignment="Center" Click="ChooseImage" />
        </StackPanel>

        <Border MaxWidth="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource Card}" BorderBrush="#5A3A3A" Background="#2A2224" Margin="24"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="{local:T En='The analysis failed', Ro='Analiza nu a mers'}" FontSize="15" FontWeight="SemiBold" Foreground="#F0857E" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding Error}" />
          </StackPanel>
        </Border>

        <local:AccessibleTabControl x:Name="Tabs" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
          <TabItem Header="{local:T En='Report', Ro='Raport'}">
            <local:ReportView DataContext="{Binding Report}" />
          </TabItem>
          <TabItem Header="{local:T En='Tones', Ro='Tonuri'}">
            <local:TonesView DataContext="{Binding Tones}" />
          </TabItem>
          <TabItem Header="Export">
            <local:ExportView DataContext="{Binding Export}" />
          </TabItem>
          <TabItem Header="{local:T En='Resolution', Ro='Rezolutie'}">
            <local:ResolutionView DataContext="{Binding Resolution}" />
          </TabItem>
          <TabItem Header="{local:T En='Colour', Ro='Culoare'}">
            <local:BackgroundView DataContext="{Binding Background}" />
          </TabItem>
          <TabItem Header="Preview">
            <local:PreviewView DataContext="{Binding Preview}" />
          </TabItem>
          <TabItem x:Name="CurvesTabItem" Header="{local:T En='Curves Editing', Ro='Editare Curbe'}">
            <local:CurvesView DataContext="{Binding Curves}" />
          </TabItem>
        </local:AccessibleTabControl>

        <local:BusyOverlay />
      </Grid>
    </Grid>
  </Grid>
</Window>
