<!-- Dark.xaml - paleta si stilurile implicite. Aceeasi tema ca FlatCheck, din acelasi
     motiv: unealta se foloseste seara, langa monitorul calibrat, iar o fereastra alba
     strica adaptarea ochiului. Culorile de verdict NU se definesc aici, ci in
     VerdictPalette.cs, din etichetele pe care le scrie nucleul. -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">

  <!-- Convertoarele stau AICI, ca sa fie vizibile sabloanelor de mai jos. -->
  <local:BoolToVisibilityConverter x:Key="BoolToVis" />
  <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
  <local:InverseBoolConverter x:Key="Not" />
  <local:NotNullToVisibilityConverter x:Key="NotNullToVis" />
  <local:FileNameConverter x:Key="FileName" />
  <local:VerdictToBrushConverter x:Key="VerdictToBrush" />

  <!-- ============================================================ paleta -->

  <SolidColorBrush x:Key="WindowBg"  Color="#1B1B1D" />
  <SolidColorBrush x:Key="PanelBg"   Color="#232326" />
  <SolidColorBrush x:Key="PanelBg2"  Color="#2B2B2F" />
  <SolidColorBrush x:Key="HoverBg"   Color="#33333A" />
  <SolidColorBrush x:Key="BorderBr"  Color="#3A3A40" />
  <SolidColorBrush x:Key="TextBr"    Color="#E4E4E7" />
  <SolidColorBrush x:Key="MutedBr"   Color="#9A9AA3" />
  <SolidColorBrush x:Key="FaintBr"   Color="#6E6E77" />
  <SolidColorBrush x:Key="AccentBr"  Color="#4EA8DE" />
  <SolidColorBrush x:Key="BadBr"     Color="#F85149" />
  <SolidColorBrush x:Key="WarnBr"    Color="#E3B341" />

  <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>

  <!-- ============================================================ text -->

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="Foreground" Value="{StaticResource FaintBr}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style x:Key="Number" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" MaxWidth="360">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="Foreground" Value="{StaticResource TextBr}" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource AccentBr}" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource AccentBr}" />
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ panouri si campuri -->

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBr}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBr}" />
  </Style>

  <!-- Raportul: text mono, doar citire, pe fundalul ferestrei. -->
  <Style x:Key="LogBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource WindowBg}" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBr}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBr}" />
  </Style>

  <!-- ============================================================ butoane -->

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ taburi -->

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{StaticResource WindowBg}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource WindowBg}"
                    BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True" Margin="12,6,12,0" />
            </Border>
            <ContentPresenter ContentSource="SelectedContent" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource MutedBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="bd" Background="Transparent" Padding="16,8"
                  BorderBrush="Transparent" BorderThickness="0,0,0,2">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextBr}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextBr}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ combo -->

  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="{StaticResource PanelBg2}"
                  BorderBrush="{StaticResource BorderBr}" BorderThickness="1" CornerRadius="4">
            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{StaticResource MutedBr}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
              <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBr}"
                      BorderThickness="1" CornerRadius="4"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                <ScrollViewer>
                  <StackPanel IsItemsHost="True" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="10,6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ progres si scroll -->

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{StaticResource AccentBr}" />
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
            <Grid>
              <Rectangle x:Name="PART_Track" />
              <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                         Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="#4A4A52" CornerRadius="4" Margin="3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ sabloane -->

  <!-- Pastila de verdict: culoarea vine prin VerdictToBrush, din eticheta nucleului. -->
  <DataTemplate x:Key="VerdictChip">
    <Border Background="{Binding Converter={StaticResource VerdictToBrush}}"
            CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
      <TextBlock Text="{Binding}" Foreground="#16161A" FontSize="11" FontWeight="SemiBold" />
    </Border>
  </DataTemplate>

  <!-- O recomandare: semnul, textul, si "fiindca" sub el, mai mic. -->
  <DataTemplate x:Key="RecommendationRowTemplate">
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Mark}" FontWeight="Bold"
                 Foreground="{Binding VerdictLabel, Converter={StaticResource VerdictToBrush}}" />
      <StackPanel Grid.Column="1">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" TextWrapping="Wrap">
          <Run Text="fiindca: " FontWeight="SemiBold" />
          <Run Text="{Binding Because, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- O sectiune a raportului: numar, titlu, pastila, apoi recomandarile ei. -->
  <DataTemplate x:Key="SectionTemplate">
    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <ContentControl DockPanel.Dock="Right" Content="{Binding VerdictLabel}"
                          ContentTemplate="{StaticResource VerdictChip}" />
          <TextBlock FontSize="14" FontWeight="SemiBold">
            <Run Text="{Binding Number, Mode=OneWay}" />
            <Run Text=". " />
            <Run Text="{Binding Title, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Recommendations}"
                      ItemTemplate="{StaticResource RecommendationRowTemplate}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Un rand eticheta / valoare / nota, folosit de toate anexele. -->
  <DataTemplate x:Key="MetricRowTemplate">
    <Grid Margin="0,0,0,7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" MinWidth="110" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Value}" Margin="12,0,0,0" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Faint}" Margin="0,2,0,0"
                 Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource NotNullToVis}}" />
    </Grid>
  </DataTemplate>

  <!-- Un rand de tabel cu celule mono: coloanele le da ViewModel-ul ca un singur sir
       aliniat, exact cum le scrie raportul. Un tabel adevarat ar fi cerut un sablon pe
       fiecare din cele cinci tabele, pentru acelasi text. -->
  <DataTemplate x:Key="MonoRowTemplate">
    <TextBlock Style="{StaticResource Mono}" Text="{Binding}" Margin="0,0,0,2" />
  </DataTemplate>

  <!-- O previzualizare: titlu, imagine la pixel, nota. -->
  <DataTemplate x:Key="PreviewTileTemplate">
    <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="10">
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Image Source="{Binding Image}" Stretch="None" HorizontalAlignment="Left"
               RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
        <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0" Text="{Binding Note}"
                   Visibility="{Binding Note, Converter={StaticResource NotNullToVis}}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- O componenta terta din "Despre". -->
  <DataTemplate x:Key="ComponentRowTemplate">
    <StackPanel Margin="0,0,0,10">
      <TextBlock TextWrapping="Wrap">
        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
        <Run Text=" - " Foreground="{StaticResource FaintBr}" />
        <Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource MutedBr}" FontSize="12" />
      </TextBlock>
      <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Licence}" />
      <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" />
      <TextBlock Margin="0,2,0,0" FontSize="11">
        <Hyperlink NavigateUri="{Binding Url}">
          <Run Text="{Binding Url, Mode=OneWay}" />
        </Hyperlink>
      </TextBlock>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
