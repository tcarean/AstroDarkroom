<!-- BusyOverlay - the waiting screen. It binds to the inherited MainViewModel: IsBusy and
     the current stage. It covers the content with an almost opaque background, so that
     nothing can be pressed during the computation. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
  <Border Background="#E01B1B1D">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="24">
      <TextBlock Text="Se analizeaza..." FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding BusyMessage}"
                 HorizontalAlignment="Center" TextAlignment="Center" />
      <ProgressBar Width="280" Margin="0,18,0,0" IsIndeterminate="True" />
    </StackPanel>
  </Border>
</UserControl>
