<!-- SoftProofView - the Soft proof tab (R-163): the intent, the four boxes, the margin, the
     proof inside its margin with the warning layers, the core's facts and legends under it,
     and "Full screen". Without a profile only the core's sentence shows (R-162). The image
     takes all the remaining room, which is why the tab is a grid, as the Editare Curbe tab.
     No figure is computed here. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.SoftProofView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <Grid Margin="20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The controls, shown once the set is prepared: while a render runs and after one the
         core refused too, so that another intent can be chosen. -->
    <StackPanel Grid.Row="0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
      <local:SoftProofControls Visibility="{Binding HasControls, Converter={StaticResource BoolToVis}}" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Margin="0,4,0,8">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsProblem}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BadBr}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <!-- The proof inside its margin: the margin's colour follows the selections (R-163). -->
    <!-- The viewer fits the proof, zooms it with the wheel around the cursor and pans it with
         the left button; a double click fits it again (ZoomPanViewer). -->
    <Border Grid.Row="1" Background="{Binding MarginBrush}" CornerRadius="4" Padding="24"
            Visibility="{Binding HasProof, Converter={StaticResource BoolToVis}}">
      <local:ZoomPanViewer>
        <Grid Width="{Binding Width}" Height="{Binding Height}">
          <Image Source="{Binding Image}" Stretch="None" />
          <Image Source="{Binding PaperLayer}" Stretch="None" Visibility="{Binding ShowPaperLayer, Converter={StaticResource BoolToVis}}" />
          <Image Source="{Binding ScreenLayer}" Stretch="None" Visibility="{Binding ShowScreenLayer, Converter={StaticResource BoolToVis}}" />
          <Image Source="{Binding BothLayer}" Stretch="None" Visibility="{Binding ShowBothLayer, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </local:ZoomPanViewer>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding HasProof, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PaperGamutLegend}" TextWrapping="Wrap" Margin="0,4,0,0" />
      <TextBlock Text="{Binding ScreenGamutLegend}" TextWrapping="Wrap" Margin="0,2,0,0" />
      <TextBlock Style="{StaticResource Muted}" Text="{Binding ProfileLine}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <TextBlock Style="{StaticResource Muted}" Text="{Binding PaperWhiteLine}" TextWrapping="Wrap" Margin="0,2,0,0" />
      <TextBlock Style="{StaticResource Muted}" Text="{Binding PaperBlackLine}" TextWrapping="Wrap" Margin="0,2,0,0" />
      <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="{local:T En='Wheel: zoom around the cursor, up to 8:1; left button: drag; double click: fit again. A reduced copy through the tables of the profile, viewing only: the pixels and the screen are assumed sRGB. The margin is the white of the screen, or that of the paper with the simulation on. The soft proofing of Lightroom has the same two intents, the same box and the same two warnings; the third intent belongs to this tool, the model of the Tones tab.', Ro='Rola: zoom in jurul cursorului, pana la 8:1; butonul stang: tragere; dublu-clic: potrivire din nou. O copie redusa prin tabelele profilului, doar pentru privit: pixelii si ecranul sunt presupusi sRGB. Marginea e albul ecranului, sau al hartiei cu simularea pornita. Soft proofing-ul din Lightroom are aceleasi doua intenturi, aceeasi bifa si aceleasi doua avertismente; al treilea intent e al uneltei, modelul tabului Tonuri.'}" />
    </StackPanel>
  </Grid>
</UserControl>
