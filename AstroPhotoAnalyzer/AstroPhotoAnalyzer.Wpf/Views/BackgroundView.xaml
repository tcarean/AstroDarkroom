<!-- BackgroundView - culoarea fundalului si cele opt regiuni de margine. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.BackgroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="CULOAREA FUNDALULUI" />
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MetricRowTemplate}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="COLTURI SI LATURI, FATA DE FUNDAL (R / G / B, niveluri); ! = peste prag" />
          <ItemsControl ItemsSource="{Binding RegionRows}" ItemTemplate="{StaticResource MonoRowTemplate}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
