<!-- ResolutionView - the FWHM and the regions, each with its description under the name
     (the corners without one: the centre's covers them), then the table of sizes, with the
     recommended row when there is one, and the dpi - distance scale, so that the "dpi"
     column is read against the physics, not against 300. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.ResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{local:T En='REAL RESOLUTION: THE WIDTH OF THE STARS', Ro='REZOLUTIA REALA: LATIMEA STELELOR'}" />
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DescribedMetricRowTemplate}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{local:T En='PRINT SIZES', Ro='MARIMI DE PRINT'}" />
          <ItemsControl ItemsSource="{Binding SizeRows}" ItemTemplate="{StaticResource MonoRowTemplate}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{local:T En='The &quot;star mm&quot; column says how large a star comes out on paper at that size. &quot;Point from&quot; is the distance from which the eye sees it as a point, not a blob (the eye tells 0.29 mm apart from 1 m). The recommended row, with the asterisk, appears only when you gave a viewing distance and the stars could be measured: only then can the test say which size passes and which does not. Without a given distance, a larger print is viewed from farther away, so every size looks equally good, and the wall chooses the size.', Ro='Coloana &quot;stea mm&quot; spune cat de mare iese o stea pe hartie la marimea aceea. &quot;Punct de la&quot; e distanta de la care ochiul o vede ca un punct, nu ca o pata (ochiul desparte 0.29 mm de la 1 m). Randul recomandat, cu steluta, apare doar cand ai dat o distanta de privire si stelele au putut fi masurate: numai atunci se poate spune care marime trece si care nu. Fara distanta data, un print mai mare se priveste de mai departe, asa ca toate marimile arata la fel de bine, si marimea o alege peretele.'}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" TextWrapping="Wrap"
            ><Run Text="{local:T En='When there are no stars to measure, the program does not know how much detail the image holds; it only checks that the pixels do not show on paper. Without a given distance the convention of ', Ro='Cand nu sunt stele de masurat, programul nu stie cat detaliu are imaginea; verifica doar sa nu se vada pixelii pe hartie. Fara distanta data se cere conventia de '}" /><Bold>180 dpi</Bold><Run Text="{local:T En=' applies: pixels of 0.14 mm, which no longer show from half a metre, when you come close to look. With a given distance fewer are enough: 25.4 / (0.29 x distance), that is 58 dpi at 1.5 m. This says only how large the file can be printed without the pixels showing, not how much detail the image holds: a soft nebula may look fine much larger. So there is no recommended row here either.', Ro=': pixeli de 0.14 mm, care nu se mai vad de la jumatate de metru, cand te apropii sa te uiti. Cu distanta data ajung mai putini: 25.4 / (0.29 x distanta), adica 58 dpi la 1.5 m. Asta spune doar cat de mare se poate tipari fisierul fara sa se vada pixelii, nu cat detaliu are imaginea: o nebuloasa moale poate arata bine si mult mai mare. De aceea nici aici nu e rand recomandat.'}" /></TextBlock>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{local:T En='WHAT A DPI MEANS', Ro='CE INSEAMNA UN DPI'}" />
          <ItemsControl ItemsSource="{Binding DpiRows}" ItemTemplate="{StaticResource MonoRowTemplate}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{local:T En='Dpi says how many pixels go into one inch (2.54 cm) of paper; a pixel is 25.4 / dpi mm. From some distance the eye no longer sees the pixels (the eye tells 0.29 mm apart from 1 m); the table says, for each dpi, from how many metres they vanish. The &quot;dpi&quot; column of the size table is read on this scale, not against 300: 300 is for what you hold in the hand. And more pixels do not help: a star spreads over several pixels anyway (the star width, FWHM, measured above), and the detail comes from the star, not from the pixel.', Ro='Dpi inseamna cati pixeli intra intr-un inch (2.54 cm) de hartie; un pixel are 25.4 / dpi mm. De la o anumita distanta ochiul nu mai vede pixelii (ochiul desparte 0.29 mm de la 1 m); tabelul spune, pentru fiecare dpi, de la cati metri dispar. Coloana &quot;dpi&quot; din tabelul de marimi se citeste pe scara asta, nu fata de 300: 300 e pentru ce tii in mana. Iar pixeli mai multi nu ajuta: o stea se intinde oricum pe mai multi pixeli (latimea stelelor, FWHM, masurata mai sus), si detaliul vine de la stea, nu de la pixel.'}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
