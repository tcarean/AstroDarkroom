<!-- ResolutionView - the FWHM and the regions, each with its description under the name
     (the corners without one: the centre's covers them), then the table of sizes, with the
     recommended row when there is one, and the dpi - distance scale, so that the "dpi"
     column is read against the physics, not against 300. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.ResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{local:T En='REAL RESOLUTION: THE WIDTH OF THE STARS', Ro='REZOLUTIA REALA: LATIMEA STELELOR'}" />
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DescribedMetricRowTemplate}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{local:T En='PRINT SIZES', Ro='MARIMI DE PRINT'}" />
          <ItemsControl ItemsSource="{Binding SizeRows}" ItemTemplate="{StaticResource MonoRowTemplate}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{local:T En='The star is FWHM x the pixel pitch on paper; it is a point from the distance at which the eye (0.29 mm at 1 m) no longer resolves it. The asterisk appears only with a given distance and a measured FWHM - the one case in which the test tells the sizes apart by a measurement; without a distance, &quot;point from&quot; and the natural distance grow alike with the width, and the wall chooses the size.', Ro='Steaua e FWHM x pasul pixelului pe hartie; e punct de la distanta la care ochiul (0.29 mm la 1 m) n-o mai desface. Steluta apare doar cu distanta data si FWHM masurat - singurul caz in care testul desparte marimile pe o masuratoare; fara distanta, &quot;punct de la&quot; si distanta naturala cresc la fel cu latimea si marimea o alege peretele.'}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" TextWrapping="Wrap"
            ><Run Text="{local:T En='Without stars the detail is not measured, only the pixel grid. Without a given distance the convention of ', Ro='Fara stele nu se masoara detaliul, ci doar grila de pixeli. Fara distanta data se cere conventia de '}" /><Bold>180 dpi</Bold><Run Text="{local:T En=' applies: a pitch of 0.14 mm, invisible from ~0.5 m, when you come close to look. With a given distance, the physical threshold 25.4 / (0.29 x distance) - 58 dpi at 1.5 m. It is a limit of the file, not of the detail: a soft nebula may need much less, so there is no recommended row there either.', Ro=': pas de 0.14 mm, invizibil de la ~0.5 m, cand te apropii sa te uiti. Cu distanta data, pragul fizic 25.4 / (0.29 x distanta) - 58 dpi la 1.5 m. E o limita a fisierului, nu a detaliului: o nebuloasa moale poate cere mult mai putin, deci nici acolo nu e rand recomandat.'}" /></TextBlock>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{local:T En='WHAT A DPI MEANS', Ro='CE INSEAMNA UN DPI'}" />
          <ItemsControl ItemsSource="{Binding DpiRows}" ItemTemplate="{StaticResource MonoRowTemplate}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{local:T En='The pixel pitch is 25.4 / dpi; the grid disappears from the distance at which the eye (0.29 mm at 1 m) no longer resolves it. The &quot;dpi&quot; column of the size table is read on this scale, not against 300. And whatever lies above 1 / FWHM of the dpi adds nothing: the real resolution is the star, not the pixel.', Ro='Pasul pixelului e 25.4 / dpi; grila dispare de la distanta la care ochiul (0.29 mm la 1 m) n-o mai desface. Coloana &quot;dpi&quot; a tabelului de marimi se citeste pe scara asta, nu fata de 300. Si tot ce e peste 1 / FWHM din dpi nu mai aduce nimic: rezolutia reala e steaua, nu pixelul.'}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
