<!-- ReportView - the decisions, section by section, with verdict pills; and the complete
     text report, foldable, exactly the one that is saved. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <DockPanel Margin="0,0,0,14">
        <ContentControl DockPanel.Dock="Left" Content="{Binding VerdictLabel}"
                        ContentTemplate="{StaticResource VerdictChip}" Margin="0,0,12,0" />
        <TextBlock Text="{local:T En='overall verdict: the most severe of the sections', Ro='verdictul general: cel mai sever dintre sectiuni'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      </DockPanel>

      <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" />

      <CheckBox Content="{local:T En='Show the text report (what is saved in Report.txt)', Ro='Arata raportul text (ce se salveaza in Raport.txt)'}" Margin="0,6,0,8"
                IsChecked="{Binding ShowText, Mode=TwoWay}" Foreground="{StaticResource MutedBr}" />
      <TextBox Style="{StaticResource LogBox}" Text="{Binding Text, Mode=OneWay}" MinHeight="300" MaxHeight="700"
               Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
