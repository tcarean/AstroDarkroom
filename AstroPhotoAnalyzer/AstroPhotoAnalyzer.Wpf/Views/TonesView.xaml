<!-- TonesView - histograma L* cu negrul hartiei marcat, cifrele tonale, si tabelul
     simularii de fundal. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.TonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="HISTOGRAMA L* (0..100); linia rosie = negrul hartiei" />
          <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
            <local:BarsCanvas Height="140" Values="{Binding Histogram}" Marker="{Binding PaperBlack}"
                              Fill="{StaticResource AccentBr}" MarkerBrush="{StaticResource BadBr}" />
          </Border>
          <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0"
                     Text="Tot ce e la stanga liniei se printeaza cu acelasi negru. Histograma e pe subesantion, in procente." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="TONURI" />
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MetricRowTemplate}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="SIMULAREA FUNDALULUI (curba gamma pe toate canalele)" />
          <ItemsControl ItemsSource="{Binding SimulationRows}" ItemTemplate="{StaticResource MonoRowTemplate}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
