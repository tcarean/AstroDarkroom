<!-- TonesView - the L* histogram with paper black and the visibility threshold marked, the
     tonal figures with their descriptions, the table of the background simulation, the
     level - L* table of the reference points and, last, the panel that explains the tab. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.TonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{Binding HistogramHeading}" />
          <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
            <local:BarsCanvas Height="140" Values="{Binding Histogram}" Marker="{Binding PaperBlack}"
                              SecondMarker="{Binding LowSeparation}" Fill="{StaticResource AccentBr}"
                              MarkerBrush="{StaticResource BadBr}" SecondMarkerBrush="{StaticResource WarnBr}" />
          </Border>
          <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding HistogramNote}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="TONURI" />
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DescribedMetricRowTemplate}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="SIMULAREA FUNDALULUI (curba gamma pe toate canalele)" />
          <!-- The same mono text as in Anexa B; on each row with a target, the button that
               opens the row's preview (R-131). The header and the note have no button. -->
          <ItemsControl ItemsSource="{Binding SimulationRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource Mono}" Text="{Binding Text}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Preview" Command="{Binding Preview}" Padding="8,1" Margin="12,0,0,0" FontSize="11"
                          ToolTip="{Binding DataContext.PreviewTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Visibility="{Binding Preview, Converter={StaticResource NotNullToVis}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Mono}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ExactLine}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Definition}" />
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource BadBr}" Text="{Binding NoWcsWarning}"
                     Visibility="{Binding NoWcsWarning, Converter={StaticResource NotNullToVis}}" />
          <Button Content="Harta praf / cer" Command="{Binding OpenMap}" HorizontalAlignment="Left" Margin="0,10,0,0"
                  ToolTip="Imaginea intreaga cu dalele de praf si de cer vopsite si norii catalogati pe nume" />
          <ItemsControl ItemsSource="{Binding CloudRows}" ItemTemplate="{StaticResource MonoRowTemplate}" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="NIVEL SI L*: REPERELE TABULUI" />
          <ItemsControl ItemsSource="{Binding LadderRows}" ItemTemplate="{StaticResource MonoRowTemplate}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0">
            Nivelul e cel al unui gri (R = G = B) cu acelasi L*: ce cauti pe histograma din Siril cand tragi de curba.
            Pe culoare acelasi nivel da alt L* dupa nuanta - un fundal albastru are L* mai mic decat sugereaza nivelurile lui.
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="CUM SE CITESTE TABUL" />
          <ItemsControl ItemsSource="{Binding Guide}" ItemTemplate="{StaticResource GuideParagraphTemplate}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
