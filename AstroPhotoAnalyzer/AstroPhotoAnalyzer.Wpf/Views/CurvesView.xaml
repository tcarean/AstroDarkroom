<!-- CurvesView - the Editare Curbe tab (R-146): the purpose, "Calculeaza", the gallery with the
     original and the suggested curves, the evidence of the curve shown and its two buttons.
     The image takes all the remaining room, which is why the tab is a grid, not a scrolled
     column like the others. No figure is computed here. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.CurvesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <Grid Margin="20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="{local:T En='Contrast curves for:', Ro='Curbe de contrast pentru:'}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <RadioButton Content="Print" GroupName="CurvePurpose" IsChecked="{Binding IsPrint}" Foreground="{StaticResource TextBr}"
                   VerticalAlignment="Center" Margin="0,0,14,0"
                   ToolTip="{local:T En='The same curves; the evidence of each also gets the paper checks: the background, the noise against the print target, the gamut', Ro='Aceleasi curbe; dovada fiecareia primeste si verificarile de hartie: fundalul, zgomotul fata de tinta de print, gamutul'}" />
      <RadioButton Content="{local:T En='Screen', Ro='Ecran'}" GroupName="CurvePurpose" IsChecked="{Binding IsScreen}" Foreground="{StaticResource TextBr}"
                   VerticalAlignment="Center" Margin="0,0,20,0" ToolTip="{local:T En='The same curves, without the paper checks', Ro='Aceleasi curbe, fara verificarile de hartie'}" />
      <Button Content="{local:T En='Calculate', Ro='Calculeaza'}" Command="{Binding Calculate}" Padding="14,3"
              ToolTip="{local:T En='Computes the gallery again, at the size the tab has now; after an analysis it is computed on its own', Ro='Calculeaza galeria din nou, la marimea de acum a tabului; dupa o analiza se calculeaza singura'}" />
      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="900">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsProblem}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BadBr}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <Border Grid.Row="1" x:Name="GalleryArea" Background="{StaticResource PanelBg2}" CornerRadius="4" SizeChanged="GallerySizeChanged">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Visibility="{Binding HasGallery, Converter={StaticResource BoolToVis}}">
        <Image Source="{Binding Current.Image}" Width="{Binding Current.Width}" Height="{Binding Current.Height}" Stretch="None" />
      </Viewbox>
    </Border>

    <Grid Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding HasGallery, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="{local:T En='&lt; Back', Ro='&lt; Inapoi'}" Command="{Binding Previous}" Padding="12,3" ToolTip="{local:T En='Left arrow', Ro='Sageata stanga'}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" MinWidth="170">
        <TextBlock Text="{Binding Current.Name}" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Text="{Binding Position}" Margin="10,0,0,0" />
      </StackPanel>
      <Button Grid.Column="2" Content="{local:T En='Next &gt;', Ro='Inainte &gt;'}" Command="{Binding Next}" Padding="12,3" ToolTip="{local:T En='Right arrow', Ro='Sageata dreapta'}" />
      <Button Grid.Column="4" Content="{local:T En='Curve...', Ro='Curba...'}" Command="{Binding OpenCurve}" Padding="12,3"
              ToolTip="{local:T En='The table of points and the graph of the curve, to redo it by hand in Siril', Ro='Tabelul punctelor si graficul curbei, ca sa o refaci de mana in Siril'}" />
      <Button Grid.Column="5" Content="{local:T En='Save as...', Ro='Salveaza ca...'}" Command="{Binding SaveAs}" Padding="12,3" Margin="10,0,0,0"
              ToolTip="{local:T En='A new FITS with the curve applied; the input image is not changed', Ro='Un FITS nou cu curba aplicata; imaginea de intrare nu se modifica'}" />
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding HasGallery, Converter={StaticResource BoolToVis}}">
      <!-- The evidence of all the images, stacked; only the current one's shows (Hidden, not
           Collapsed), so the area has the height of the longest and the image above does
           not move while browsing. -->
      <ItemsControl x:Name="EvidenceArea" ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding EvidenceRows}">
              <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                  <Setter Property="Visibility" Value="Hidden" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ItemsControl.Style>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Margin="0,1">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BadBr}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource Faint}" Text="{Binding AnchorSource}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,2,0,0"
                 Text="{local:T En='The curves do not move the dust or the sky: a background too low for paper is lifted at the stretch (the Tones tab). The preview is a reduced copy; the pixels are assumed to be sRGB.', Ro='Curbele nu muta praful si cerul: un fundal prea jos pentru hartie se ridica la stretch (tabul Tonuri). Previzualizarea e o copie redusa; pixelii sunt presupusi sRGB.'}" />
      <!-- A fixed place, two lines high, for the save message: its appearance does not
           move the image. -->
      <Grid Height="34" Margin="0,4,0,0">
        <TextBlock Text="{Binding SaveMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SaveMessage}" />
        <TextBlock Text="{Binding SaveError}" Foreground="{StaticResource BadBr}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding SaveError}" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
