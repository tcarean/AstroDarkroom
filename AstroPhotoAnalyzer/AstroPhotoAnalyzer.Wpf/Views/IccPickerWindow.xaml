<!-- IccPickerWindow - "Din profil ICC..." (R-132): the installed printer profiles, with
     the Dmax the core reads from each; "Foloseste" writes it into the Dmax field. Modal,
     centred on the parent; Esc closes it. No figure is computed here. -->

<Window x:Class="AstroPhotoAnalyzer.Wpf.IccPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dmax din profilul ICC"
        Icon="/AstroPhotoAnalyzer.Wpf;component/Icon/AstroPhotoAnalyzer.ico"
        Width="720" Height="520" MinWidth="520" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding Explanation}" />

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="4">
      <Grid>
        <ListBox x:Name="List" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBr}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="UseOnDoubleClick">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="10,7">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelBg2}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBg}" />
                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBr}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Detail}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="{Binding Note}" TextWrapping="Wrap"
                           Visibility="{Binding Note, Converter={StaticResource NotNullToVis}}" />
                <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding File}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Style="{StaticResource Muted}" Margin="10,8" Text="Niciun profil de imprimanta instalat"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="2" Style="{StaticResource Faint}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
      <Run Text="Profilele de imprimanta din" />
      <Run Text="{Binding Folder, Mode=OneWay}" />
    </TextBlock>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Alege fisier..." Click="ChooseFile" />
      <Button Grid.Column="2" Content="Foloseste" Click="Use" IsDefault="True" IsEnabled="{Binding CanUse}" />
      <Button Grid.Column="3" Content="Renunta" IsCancel="True" Margin="10,0,0,0" />
    </Grid>
  </Grid>
</Window>
