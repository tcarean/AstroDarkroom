<!-- PreviewWindow - the preview of one row of the simulation (R-131): the image lifted to
     the row's target, maximised, with the pixels below paper black and those below L* 15
     painted, each layer with its own checkbox, both unchecked when the window opens (ADR 0064).
     No figure is computed here. -->

<Window x:Class="AstroPhotoAnalyzer.Wpf.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf"
        Title="{Binding Title}"
        Icon="/AstroPhotoAnalyzer.Wpf;component/Icon/AstroPhotoAnalyzer.ico"
        WindowState="Maximized" MinWidth="800" MinHeight="500"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="16,10">
      <StackPanel>
        <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <CheckBox IsChecked="{Binding ShowBlack}" Foreground="{StaticResource TextBr}" Margin="0,0,24,0">
            <TextBlock Text="{Binding BlackLegend}" />
          </CheckBox>
          <CheckBox IsChecked="{Binding ShowLow}" Foreground="{StaticResource TextBr}">
            <TextBlock Text="{Binding LowLegend}" />
          </CheckBox>
        </StackPanel>
        <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0"
                   Text="{local:T En='A reduced copy, with the tones lifted by a simple curve (gamma), not by the stretch in Siril. On screen it looks washed out, but on paper it comes back. The program assumes the pixels are sRGB.', Ro='E o copie micsorata, cu tonurile ridicate printr-o curba simpla (gamma), nu prin stretch-ul din Siril. Pe ecran pare stearsa, dar pe hartie revine. Programul presupune ca pixelii sunt sRGB.'}" />
      </StackPanel>
    </Border>

    <Viewbox Grid.Row="1" Stretch="Uniform" Margin="8">
      <Grid Width="{Binding Width}" Height="{Binding Height}">
        <Image Source="{Binding Image}" Stretch="None" />
        <Image Source="{Binding LowLayer}" Stretch="None" Visibility="{Binding ShowLow, Converter={StaticResource BoolToVis}}" />
        <Image Source="{Binding BlackLayer}" Stretch="None" Visibility="{Binding ShowBlack, Converter={StaticResource BoolToVis}}" />
      </Grid>
    </Viewbox>
  </Grid>
</Window>
