<!-- SoftProofControls - the controls of the soft proof (R-163), the same in the tab and in the
     full-screen window over the same view-model: the three intents, the four boxes, the margin
     and "Full screen". The radio buttons have no GroupName: a GroupName would join every
     instance in the process into one group (docs/design/testing.md), and each instance's
     panel already makes a group of its own. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.SoftProofControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal" Margin="0,0,20,4" VerticalAlignment="Center">
      <TextBlock Text="{local:T En='Intent:', Ro='Intent:'}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <RadioButton Content="{Binding PerceptualName}" IsChecked="{Binding IsPerceptual}" ToolTip="{Binding PerceptualHelp}"
                   Foreground="{StaticResource TextBr}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <RadioButton Content="{Binding RelativeName}" IsChecked="{Binding IsRelative}" ToolTip="{Binding RelativeHelp}"
                   Foreground="{StaticResource TextBr}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <RadioButton Content="{Binding RelativeNoBpcName}" IsChecked="{Binding IsRelativeNoBpc}" ToolTip="{Binding RelativeNoBpcHelp}"
                   Foreground="{StaticResource TextBr}" VerticalAlignment="Center" />
    </StackPanel>
    <CheckBox IsChecked="{Binding SimulatePaper}" Foreground="{StaticResource TextBr}" VerticalAlignment="Center" Margin="0,0,16,4"
              Content="{local:T En='Simulate paper &amp; ink', Ro='Simuleaza hartia si cerneala'}"
              ToolTip="{local:T En='The white of the paper shown as its own colour and its black as its own grey, as in Lightroom; off, both are those of the screen. Key P in the full-screen window.', Ro='Albul hartiei aratat cu culoarea lui si negrul ei ca griul lui, ca in Lightroom; debifat, amandoua sunt ale ecranului. Tasta P in fereastra pe tot ecranul.'}" />
    <CheckBox IsChecked="{Binding ShowPaperGamut}" Foreground="{StaticResource TextBr}" VerticalAlignment="Center" Margin="0,0,16,4"
              Content="{local:T En='Paper gamut warning', Ro='Avertisment gamut hartie'}"
              ToolTip="{local:T En='Paints in red the pixels whose colour the paper does not reproduce, by the rule of the Curves Editing tab. Key G.', Ro='Picteaza cu rosu pixelii a caror culoare hartia nu o reda, dupa regula din tabul Editare Curbe. Tasta G.'}" />
    <CheckBox IsChecked="{Binding ShowScreenGamut}" Foreground="{StaticResource TextBr}" VerticalAlignment="Center" Margin="0,0,16,4"
              Content="{local:T En='Screen gamut warning', Ro='Avertisment gamut ecran'}"
              ToolTip="{local:T En='Paints in blue the pixels the paper shows but an sRGB screen cannot; magenta where both warnings apply. Key M.', Ro='Picteaza cu albastru pixelii pe care hartia ii reda dar un ecran sRGB nu poate; magenta unde se aplica ambele avertismente. Tasta M.'}" />
    <CheckBox IsChecked="{Binding ShowOriginal}" Foreground="{StaticResource TextBr}" VerticalAlignment="Center" Margin="0,0,20,4"
              Content="{local:T En='Original', Ro='Originalul'}"
              ToolTip="{local:T En='The image as it is, inside the same margin, for comparison; the warnings are not painted over it. Key O.', Ro='Imaginea asa cum e, in aceeasi margine, pentru comparatie; avertismentele nu se picteaza peste ea. Tasta O.'}" />
    <StackPanel Orientation="Horizontal" Margin="0,0,20,4" VerticalAlignment="Center">
      <TextBlock Text="{local:T En='Margin:', Ro='Margine:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Margin}" MinWidth="120" VerticalAlignment="Center"
                ToolTip="{local:T En='The background around the image: automatic is the white of the screen, or the white of the paper with the simulation on; the others are the backgrounds of Lightroom', Ro='Fundalul din jurul imaginii: automat e albul ecranului, sau albul hartiei cu simularea pornita; celelalte sunt fundalurile din Lightroom'}">
        <ComboBoxItem Tag="{x:Static local:ProofMarginChoice.Auto}" Content="{local:T En='Auto', Ro='Automat'}" />
        <ComboBoxItem Tag="{x:Static local:ProofMarginChoice.White}" Content="{local:T En='White', Ro='Alb'}" />
        <ComboBoxItem Tag="{x:Static local:ProofMarginChoice.LightGrey}" Content="{local:T En='Light grey', Ro='Gri deschis'}" />
        <ComboBoxItem Tag="{x:Static local:ProofMarginChoice.Grey}" Content="{local:T En='Grey', Ro='Gri'}" />
        <ComboBoxItem Tag="{x:Static local:ProofMarginChoice.DarkGrey}" Content="{local:T En='Dark grey', Ro='Gri inchis'}" />
        <ComboBoxItem Tag="{x:Static local:ProofMarginChoice.Black}" Content="{local:T En='Black', Ro='Negru'}" />
      </ComboBox>
    </StackPanel>
    <Button Content="{local:T En='Full screen', Ro='Ecran intreg'}" Command="{Binding FullScreen}" Padding="14,3" VerticalAlignment="Center" Margin="0,0,0,4"
            Visibility="{Binding ShowFullScreenButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
            ToolTip="{local:T En='The same proof in a maximised window; Esc closes it', Ro='Acelasi proof intr-o fereastra maximizata; Esc o inchide'}" />
  </WrapPanel>
</UserControl>
