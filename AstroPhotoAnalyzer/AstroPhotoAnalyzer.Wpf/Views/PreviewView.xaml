<!-- PreviewView - the card with the screen - paper rule, then crops pixel for pixel, the
     whole frame, the print simulation and the crop, each with what you check in it, all
     from memory. No file is written. -->

<UserControl x:Class="AstroPhotoAnalyzer.Wpf.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf">
  <!-- Horizontal scroll TURNED OFF: with it, the WrapPanel would get an infinite width when
       measured and would never wrap the row - the cards would run off on the right, cut. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
    <StackPanel>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12" MaxWidth="1100" HorizontalAlignment="Left"
              Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{local:T En='HOW TO USE THE PREVIEW', Ro='CUM SE FOLOSESTE PREVIEW-UL'}" />
          <ItemsControl ItemsSource="{Binding Guide}" ItemTemplate="{StaticResource GuideParagraphTemplate}" />
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource PreviewTileTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
