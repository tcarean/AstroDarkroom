<!-- SoftProofWindow - the soft proof full screen (R-163): maximised, over the tab's own
     view-model, the same controls in a bar at the top, the margin filling the window behind
     the image. The keys P, G, M, O, I and Esc are in the code-behind. No figure is computed
     here. -->

<Window x:Class="AstroPhotoAnalyzer.Wpf.SoftProofWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AstroPhotoAnalyzer.Wpf"
        Title="{Binding Title}"
        Icon="/AstroPhotoAnalyzer.Wpf;component/Icon/AstroPhotoAnalyzer.ico"
        WindowState="Maximized" MinWidth="800" MinHeight="500"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="16,8">
      <StackPanel>
        <local:SoftProofControls ShowFullScreenButton="False" />
        <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Text="{local:T En='Keys: P paper &amp; ink, G paper gamut, M screen gamut, O original, I next intent, Esc closes. A reduced copy; the pixels and the screen are assumed sRGB.', Ro='Taste: P hartie si cerneala, G gamut hartie, M gamut ecran, O originalul, I intentul urmator, Esc inchide. O copie redusa; pixelii si ecranul sunt presupusi sRGB.'}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="{Binding MarginBrush}" Padding="48">
      <Viewbox Stretch="Uniform">
        <Grid Width="{Binding Width}" Height="{Binding Height}">
          <Image Source="{Binding Image}" Stretch="None" />
          <Image Source="{Binding PaperLayer}" Stretch="None" Visibility="{Binding ShowPaperLayer, Converter={StaticResource BoolToVis}}" />
          <Image Source="{Binding ScreenLayer}" Stretch="None" Visibility="{Binding ShowScreenLayer, Converter={StaticResource BoolToVis}}" />
          <Image Source="{Binding BothLayer}" Stretch="None" Visibility="{Binding ShowBothLayer, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Viewbox>
    </Border>
  </Grid>
</Window>
