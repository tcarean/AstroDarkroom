<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application with windows. The same core as AstroPhotoAnalyzer.exe, through
       AstroPhotoAnalyzer.Core - it reimplements no figure and no line of the report; it
       calls AnalysisRun.Execute and shows the result, and, on request from the Curbe tab,
       CurveRun (the suggested curves and the saved FITS, ADR 0032).

       net8.0-windows + UseWPF makes this project Windows-only, and that is what stops
       "dotnet build AstroPhotoAnalyzer.sln" from working on Linux. The console stays
       portable if its own project is built directly.

       The version and the copyright come from Directory.Build.props, as for the other
       projects, so that the banner written into Raport.txt is guaranteed to be the same as
       the console's. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AstroPhotoAnalyzer.Wpf</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AstroPhotoAnalyzer.Wpf</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- The exe's icon. The same as the console's, from Icon/ at the root. The window gets
         it separately, through the <Resource> below and Icon= in MainWindow.xaml. -->
    <ApplicationIcon>..\Icon\AstroPhotoAnalyzer.ico</ApplicationIcon>

    <!-- Do NOT put InvariantGlobalization here: WPF needs culture data to be able to bind
         anything to a property, and without it the window crashes when the XAML LOADS.
         The invariance of the numbers is done in code, in App.ForceInvariantNumbers. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstroPhotoAnalyzer.Core\AstroPhotoAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Icon\AstroPhotoAnalyzer.ico" Link="Icon\AstroPhotoAnalyzer.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstroPhotoAnalyzer.Wpf.Tests" />
  </ItemGroup>

</Project>
