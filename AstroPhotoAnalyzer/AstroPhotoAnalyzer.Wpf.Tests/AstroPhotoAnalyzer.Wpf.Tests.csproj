<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the windowed application. A project separate from AstroPhotoAnalyzer.Tests,
       so that it targets net8.0-windows without making the core's tests Windows-only too.

       What is tested: the ViewModels, the parsing of the parameters, the culture, and that
       every window and every tab LOADS and RENDERS without binding errors. What is NOT
       tested: how it looks. -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- A WPF project does not get System.IO in the implicit usings (Path would clash with
       System.Windows.Shapes.Path); the tests work with files, so we bring it in explicitly. -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstroPhotoAnalyzer.Wpf\AstroPhotoAnalyzer.Wpf.csproj" />
    <ProjectReference Include="..\AstroPhotoAnalyzer.Core\AstroPhotoAnalyzer.Core.csproj" />
  </ItemGroup>

  <!-- The fixtures are BORROWED from AstroPhotoAnalyzer.Tests, by link: two scene generators
       would have meant that a test here and one there work on slightly different images
       without anyone knowing. -->
  <ItemGroup>
    <Compile Include="..\AstroPhotoAnalyzer.Tests\TempWorkspace.cs" Link="Shared\TempWorkspace.cs" />
    <Compile Include="..\AstroPhotoAnalyzer.Tests\SyntheticRasters.cs" Link="Shared\SyntheticRasters.cs" />
    <Compile Include="..\AstroPhotoAnalyzer.Tests\Scenes.cs" Link="Shared\Scenes.cs" />
    <Compile Include="..\AstroPhotoAnalyzer.Tests\WcsFixtures.cs" Link="Shared\WcsFixtures.cs" />
    <Compile Include="..\AstroPhotoAnalyzer.Tests\TiffTestData.cs" Link="Shared\TiffTestData.cs" />
    <Compile Include="..\AstroPhotoAnalyzer.Tests\IccTestData.cs" Link="Shared\IccTestData.cs" />
    <Compile Include="..\AstroPhotoAnalyzer.Tests\IccPrinterTestData.cs" Link="Shared\IccPrinterTestData.cs" />
    <Compile Include="..\AstroPhotoAnalyzer.Tests\RomanianWords.cs" Link="Shared\RomanianWords.cs" />
  </ItemGroup>

</Project>
