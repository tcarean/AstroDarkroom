<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark throughout: a bright chrome around an astro image destroys the eye's sense of
         what is actually dark in the picture. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#12151A" />
    <!-- The opaque ground both images are composited over, and what shows through where a
         padded image does not reach. Black rather than the canvas colour so the padding reads
         as absence of image rather than as part of the chrome. -->
    <SolidColorBrush x:Key="ImageBackdropBrush" Color="#000000" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#1B1F26" />
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#262C36" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#2C3340" />
    <SolidColorBrush x:Key="TextBrush" Color="#D6DCE5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8A94A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3FE0C8" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#243FE0C8" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#CC12151A" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#99697687" />

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BadgeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <!-- Fixed width so the readouts do not shuffle sideways as the numbers change. -->
    <Style x:Key="StatusValue" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>

    <Style x:Key="ToolLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Bound through the control rather than hard-coded in the template so a style built
             on this one can pick a different resting border, which DialogButton does. -->
        <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{StaticResource ChromeBrush}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <!-- The style's Padding reaches the content only through this margin;
                             without it the border hugged the text (seen on 2026-10-30). -->
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A toolbar button that stays lit while its mode is on (R-114): the accent border and the
         hover background, so the mode in use reads at a glance. Its own template rather than
         ToolButton's, since a ToggleButton is not a Button and cannot be based on one. -->
    <Style x:Key="ToolToggleButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{StaticResource ChromeBrush}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <!-- The style's Padding reaches the content only through this margin;
                             without it the border hugged the text (seen on 2026-10-30). -->
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentFillBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The two buttons that change one image (R-065): a toolbar button whose text follows the
         open-file glyph of Segoe MDL2 Assets, the icon font every Windows 10 and 11 carries, so
         the two stand out from the names beside them. The content stays the plain string, which
         is what the tests read and what UI Automation names the button by. -->
    <Style x:Key="ChangeButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Roomier than a toolbar button, because a dialog is read before it is clicked. The
         default button carries the accent border so the keyboard answer is visible. -->
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Thumb only, no repeat buttons: these bars float over the image, so every pixel of
         chrome hides part of what is being compared. -->
    <Style x:Key="ThinScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource ScrollThumbBrush}" CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinVerticalScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThinScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinHorizontalScrollBar" TargetType="ScrollBar">
        <Setter Property="Height" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThinScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The About window's pieces (ADR 0045): FlatCheck's, under FlatCheck's names, in this
         palette. The card is a shade lighter than the window, as much as FlatCheck's is over its
         own (8 a channel), and the faint text is the muted one darkened as FlatCheck's is. -->
    <SolidColorBrush x:Key="PanelBrush" Color="#23272E" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#636B78" />

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- WPF draws a link dark blue, unreadable on this chrome: the accent, underlined only while
         the pointer is over it. The About window's links are the only ones. -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A component written by others in the About window's card (R-075): the name and the role on
         the first line, the licence and the copyright under it, the link to its project last. -->
    <DataTemplate x:Key="ComponentRowTemplate">
        <StackPanel Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text=" - " Foreground="{StaticResource FaintTextBrush}" />
                <Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            </TextBlock>
            <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Licence}" />
            <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" />
            <TextBlock Margin="0,2,0,0" FontSize="11">
                <Hyperlink NavigateUri="{Binding Url}">
                    <Run Text="{Binding Url, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
