<Window x:Class="ImageVisualCompare.Wpf.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        Hyperlink.RequestNavigate="OpenLink">

    <!-- FlatCheck's About window (ADR 0045), in this tool's palette: the icon, the name, the
         tagline, the version and the copyright; the licence card; the card of the components
         written by others; Close, which Enter and Esc press too. Modal and not resizable: a notice
         to read and close. FontSize 13 is what FlatCheck gives every TextBlock without a style of
         its own. Every text comes through AboutViewModel; none is written here. -->
    <StackPanel Margin="24,20,24,20">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="Logo"
                   Grid.Column="0"
                   Width="72"
                   Height="72"
                   VerticalAlignment="Top"
                   Margin="0,2,20,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{Binding Tagline}" />
                <TextBlock Margin="0,10,0,0" Text="{Binding Banner}" FontFamily="Consolas" />
                <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Copyright}" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="{Binding LicenceHeading}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{Binding Warranty}" />
                <TextBlock Margin="0,10,0,0">
                    <Hyperlink x:Name="LicenceLink" NavigateUri="{Binding LicenceUrl}">
                        <Run Text="{Binding LicenceLinkLabel, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="{Binding ThirdPartyHeading}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,12" Text="{Binding ThirdPartyLead}" />
                <ItemsControl x:Name="ComponentList"
                              ItemsSource="{Binding Components}"
                              ItemTemplate="{StaticResource ComponentRowTemplate}" />
            </StackPanel>
        </Border>

        <Button x:Name="CloseButton"
                Style="{StaticResource DialogButton}"
                Content="{Binding Close}"
                IsCancel="True"
                IsDefault="True"
                Click="CloseClick"
                HorizontalAlignment="Right"
                MinWidth="96"
                Margin="0,16,0,0" />
    </StackPanel>
</Window>
