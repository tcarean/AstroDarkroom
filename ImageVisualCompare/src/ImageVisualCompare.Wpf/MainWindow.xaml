<Window x:Class="ImageVisualCompare.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageVisualCompare.Wpf.Controls"
        Title="Image Visual Compare"
        Height="820"
        Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChromeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <TextBlock x:Name="ToolbarTitle"
                           Style="{StaticResource ToolLabel}"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Navigation" Style="{StaticResource ToolLabel}" />
                    <Button x:Name="ZoomOutButton" Style="{StaticResource ToolButton}" Content="−" />
                    <TextBlock x:Name="ZoomLabel"
                               Style="{StaticResource ToolLabel}"
                               Foreground="{StaticResource TextBrush}"
                               MinWidth="52"
                               Margin="6,0"
                               TextAlignment="Center" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolButton}" Content="+" />
                    <Button x:Name="FitButton" Style="{StaticResource ToolButton}" Content="Fit" Margin="12,0,3,0" />
                    <Button x:Name="ActualSizeButton" Style="{StaticResource ToolButton}" Content="100%" />
                    <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" Content="Open…" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:CompareView x:Name="Compare" Grid.Row="1" />

        <Border Grid.Row="2"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusPair" Style="{StaticResource StatusText}" />
                <TextBlock x:Name="StatusCursor" Style="{StaticResource StatusValue}" MinWidth="96" />
                <TextBlock x:Name="StatusBefore" Style="{StaticResource StatusValue}" MinWidth="128" />
                <TextBlock x:Name="StatusAfter" Style="{StaticResource StatusValue}" MinWidth="128" />
                <TextBlock x:Name="StatusMemory" Style="{StaticResource StatusText}" />
                <TextBlock Style="{StaticResource StatusText}"
                           Text="drag the line to move it · drag elsewhere to pan · Ctrl+wheel zoom · ←/→ nudge · Ctrl+O open" />
            </StackPanel>
        </Border>

        <!-- Decoding a 100 MB 16-bit file takes a couple of seconds; without this the window
             would just sit there looking hung. -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="#E612151A"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           Foreground="{StaticResource TextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <ProgressBar x:Name="LoadingBar"
                             Width="280"
                             Height="4"
                             Minimum="0"
                             Maximum="1"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource ChromeBorderBrush}"
                             BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
