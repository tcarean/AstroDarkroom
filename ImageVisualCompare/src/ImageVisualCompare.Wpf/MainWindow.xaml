<Window x:Class="ImageVisualCompare.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageVisualCompare.Wpf.Controls"
        WindowState="Maximized"
        Height="820"
        Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChromeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The pair's names, each followed by the button that changes that image alone
                     (R-065). The panel gives the two names the widths PairLabelLayout works out
                     from the room left of the tools, so a long name is trimmed with an ellipsis
                     and the buttons always fit; the clip is for the floor, where nothing more
                     can give. -->
                <controls:PairLabelPanel x:Name="PairPanel"
                                         Grid.Column="0"
                                         HorizontalAlignment="Left"
                                         ClipToBounds="True">
                    <TextBlock x:Name="BeforeName"
                               controls:PairLabelPanel.IsName="True"
                               Style="{StaticResource ToolLabel}"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,3,0"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ChangeBeforeButton" Style="{StaticResource ChangeButton}" IsEnabled="False" />
                    <TextBlock x:Name="VsLabel" Style="{StaticResource ToolLabel}" Margin="12,0" Text="vs" />
                    <TextBlock x:Name="AfterName"
                               controls:PairLabelPanel.IsName="True"
                               Style="{StaticResource ToolLabel}"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,3,0"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ChangeAfterButton" Style="{StaticResource ChangeButton}" IsEnabled="False" />
                </controls:PairLabelPanel>

                <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="NavigationLabel" Style="{StaticResource ToolLabel}" />
                    <Button x:Name="ZoomOutButton" Style="{StaticResource ToolButton}" Content="−" />
                    <TextBlock x:Name="ZoomLabel"
                               Style="{StaticResource ToolLabel}"
                               Foreground="{StaticResource TextBrush}"
                               MinWidth="52"
                               Margin="6,0"
                               TextAlignment="Center" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolButton}" Content="+" />
                    <Button x:Name="FitButton" Style="{StaticResource ToolButton}" Margin="12,0,3,0" />
                    <Button x:Name="ActualSizeButton" Style="{StaticResource ToolButton}" Content="100%" />
                    <ToggleButton x:Name="HistogramButton" Style="{StaticResource ToolToggleButton}" Margin="12,0,3,0" IsEnabled="False" />
                    <ToggleButton x:Name="FalseColoursButton" Style="{StaticResource ToolToggleButton}" IsEnabled="False" />
                    <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" Margin="12,0,3,0" />
                    <Button x:Name="AboutButton" Style="{StaticResource ToolButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:CompareView x:Name="Compare" Grid.Row="1" />

        <Border Grid.Row="2"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <!-- GPLv3 asks that every copy carry the notice, so it is on screen for the
                     whole run. Docked right so it is never the thing that gets clipped when
                     the window narrows. -->
                <TextBlock x:Name="StatusLegal"
                           DockPanel.Dock="Right"
                           Style="{StaticResource StatusText}"
                           Margin="16,0,0,0" />

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock x:Name="StatusPair" Style="{StaticResource StatusText}" />
                    <TextBlock x:Name="StatusCursor" Style="{StaticResource StatusValue}" MinWidth="96" />
                    <TextBlock x:Name="StatusBefore" Style="{StaticResource StatusValue}" MinWidth="128" />
                    <TextBlock x:Name="StatusAfter" Style="{StaticResource StatusValue}" MinWidth="128" />
                    <TextBlock x:Name="StatusMemory" Style="{StaticResource StatusText}" />
                </StackPanel>

                <!-- Last child, so it takes whatever width is left over and trims with an
                     ellipsis instead of being cut off mid-word. Of everything on this bar
                     the hint is the one item that loses nothing by being shortened. -->
                <TextBlock x:Name="HintText"
                           Style="{StaticResource StatusText}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Decoding a 100 MB 16-bit file takes a couple of seconds; without this the window
             would just sit there looking hung. -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="#E612151A"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           Foreground="{StaticResource TextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <ProgressBar x:Name="LoadingBar"
                             Width="280"
                             Height="4"
                             Minimum="0"
                             Maximum="1"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource ChromeBorderBrush}"
                             BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
