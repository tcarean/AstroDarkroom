<?xml version="1.0" encoding="utf-8"?>
<!--
  The application's manifest, which the build embeds in the executable; Windows reads it when
  the process starts. Per-monitor DPI awareness (v2) makes WPF report the scale of the monitor
  the window is on, and raise DpiChanged when the window moves to another, so 100% stays one
  image pixel per physical pixel on every monitor (R-022, ADR 0034). The rest says what the
  compiler's default manifest said.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ImageVisualCompare.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
