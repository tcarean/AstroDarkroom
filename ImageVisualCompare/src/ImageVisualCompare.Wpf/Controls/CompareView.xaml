<UserControl x:Class="ImageVisualCompare.Wpf.Controls.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ImageVisualCompare.Wpf.Controls"
             Background="{StaticResource CanvasBrush}"
             ClipToBounds="True"
             Focusable="True"
             SnapsToDevicePixels="False"
             UseLayoutRounding="False">

    <Grid>
        <!-- Image B fills the surface; image A is drawn over it and clipped to the left of
             the divider. Both share one transform instance, so no code path exists that
             could let them disagree about zoom or pan.

             Canvas, not Grid: a Grid clamps a child's desired size to the cell, so a 5794 px
             wide image would be laid out at the width of the window and Stretch would squash
             the bitmap into it. A Canvas measures with infinite space, so the image keeps its
             true pixel size and the transform alone decides what is seen. -->
        <Canvas x:Name="AfterLayer">
            <Image x:Name="AfterImage"
                   Canvas.Left="0"
                   Canvas.Top="0"
                   Stretch="Fill"
                   UseLayoutRounding="False" />
        </Canvas>

        <Canvas x:Name="BeforeLayer">
            <!-- Image A sits on top of image B, so without an opaque backdrop a file with an
                 alpha channel would blend into B on the left while B blends into the canvas
                 colour on the right. The two halves would then be composited over different
                 backgrounds and the comparison would be showing an artefact of the display.
                 This rectangle gives A the same backdrop B has. -->
            <Rectangle x:Name="BeforeBackdrop"
                       Canvas.Left="0"
                       Canvas.Top="0"
                       Fill="{StaticResource CanvasBrush}" />

            <Image x:Name="BeforeImage"
                   Canvas.Left="0"
                   Canvas.Top="0"
                   Stretch="Fill"
                   UseLayoutRounding="False" />
        </Canvas>

        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Border x:Name="ZoomBadge" Style="{StaticResource Badge}">
                <TextBlock x:Name="ZoomBadgeText" Style="{StaticResource BadgeText}"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>

            <Rectangle x:Name="DividerLine" Width="2" Fill="{StaticResource AccentBrush}" />

            <!-- Width and Height are set from DividerModel.Layout so the hit test and the
                 drawing cannot disagree about how big the handle is. -->
            <Border x:Name="DividerHandle"
                    CornerRadius="13"
                    Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Rectangle Width="10" Height="1.5" Margin="0,1.5" Fill="{StaticResource AccentBrush}" />
                    <Rectangle Width="10" Height="1.5" Margin="0,1.5" Fill="{StaticResource AccentBrush}" />
                    <Rectangle Width="10" Height="1.5" Margin="0,1.5" Fill="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Floated over the image rather than placed in the layout, so their appearing and
             disappearing never changes the viewport size and therefore never feeds back into
             the fit scale. -->
        <ScrollBar x:Name="VerticalBar"
                   Style="{StaticResource ThinVerticalScrollBar}"
                   Orientation="Vertical"
                   HorizontalAlignment="Right"
                   Margin="0,4,3,13"
                   Visibility="Collapsed" />

        <ScrollBar x:Name="HorizontalBar"
                   Style="{StaticResource ThinHorizontalScrollBar}"
                   Orientation="Horizontal"
                   VerticalAlignment="Bottom"
                   Margin="4,0,13,3"
                   Visibility="Collapsed" />

        <controls:MinimapView x:Name="Minimap"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Margin="12,12,12,16" />
    </Grid>
</UserControl>
