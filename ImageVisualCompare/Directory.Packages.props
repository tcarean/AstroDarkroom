<Project>
  <!-- Central Package Management: every package version lives here, once (ADR 0003). The rule
       "No imaging dependency" (CLAUDE.md, ADR 0008): the core references no package at all, and
       the application only the two packages of the diagnostic log below, neither of which
       touches an image (ADR 0043); the test project has the four test packages and NLog. No new
       package without asking (the kit's rule "Packages"), and every package gets a "why" here,
       and, when the application ships it, an entry in ThirdParty.cs, which About shows, and a
       heading in THIRD-PARTY-NOTICES.md (R-075). -->
  <ItemGroup>
    <!-- The diagnostic log in the folder beside the executable (R-120 to R-123, ADR 0043):
         configured in code, a size-rolled text file, BSD-3-Clause, purely managed. The owner
         asked for NLog by name on 2026-10-30, the version FlatCheck's log uses, so the suite
         ships one NLog. -->
    <PackageVersion Include="NLog" Version="6.2.2" />
    <!-- NLog's own file target with the operating system's atomic append, so two windows
         writing one log at once lose no line (R-123): FlatCheck measured on 2026-10-27 that the
         plain target lost 33 to 48 lines of 4000 and cost 4.8 ms a line, this one lost none at
         0.09 ms (its ADR 0070). Same project, commit and licence as NLog, no native file of its
         own. Keep its version equal to NLog's. -->
    <PackageVersion Include="NLog.Targets.AtomicFile" Version="6.2.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test host and runner (xUnit 2: no dynamic skip, which is why an absent large file returns
         early with a message instead of skipping). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
</Project>
