<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- The imaging tests exercise the real WIC decoder, which needs the WPF surface. -->
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- The log's capture target and the file tests' own factories (LogCapture, LoggingTests). -->
    <PackageReference Include="NLog" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageVisualCompare.Core\ImageVisualCompare.Core.csproj" />
    <ProjectReference Include="..\..\src\ImageVisualCompare.Wpf\ImageVisualCompare.Wpf.csproj" />
  </ItemGroup>

</Project>
