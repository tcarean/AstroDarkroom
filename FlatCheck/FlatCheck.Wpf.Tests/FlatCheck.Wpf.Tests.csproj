<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the windowed application.

       A project separate from FlatCheck.Tests, and not a folder in it, for a specific reason:
       to target net8.0-windows it must be Windows-only, and FlatCheck.Tests - which checks
       the core and the goldens - deserves to stay portable.

       What is tested here: the deduction of the folder structure, the explanation messages,
       the verdict -> colour mapping, the converters and the view-models. That is, everything
       that has rules. What is NOT tested: the XAML - there is no decision there, only layout. -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- A WPF project does NOT get System.IO in the implicit usings: there Path would collide
       with System.Windows.Shapes.Path. The tests draw no shapes, but handle files a lot, so
       we bring it in explicitly. -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlatCheck.Wpf\FlatCheck.Wpf.csproj" />
    <ProjectReference Include="..\FlatCheck.Core\FlatCheck.Core.csproj" />
  </ItemGroup>

  <!-- The FITS fixtures and the temporary folder are BORROWED from FlatCheck.Tests, by link,
       instead of being copied. Two generators of synthetic FITS would have meant that a test
       here and one there work on slightly different frames without anyone knowing. -->
  <ItemGroup>
    <Compile Include="..\FlatCheck.Tests\FitsTestData.cs" Link="Shared\FitsTestData.cs" />
    <Compile Include="..\FlatCheck.Tests\TempWorkspace.cs" Link="Shared\TempWorkspace.cs" />
    <Compile Include="..\FlatCheck.Tests\LensProfileTestData.cs" Link="Shared\LensProfileTestData.cs" />
    <!-- TestImages brings JpegOf: the camera's preview, made in the test with the ImageSharp
         encoder, so that the exposure tab can be tested with the switch on without any real
         raw. -->
    <Compile Include="..\FlatCheck.Tests\TestImages.cs" Link="Shared\TestImages.cs" />
  </ItemGroup>

</Project>
