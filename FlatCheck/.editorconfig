# Whitespace rules, enforced by `dotnet format --verify-no-changes` in scripts/verify.ps1.
# Code style analyzers are deliberately not enabled here (ADR 0003): the code predates them
# and a style pass over 20 000 lines is a task of its own.
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,props,targets,csproj,sln,xaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,sh}]
end_of_line = lf

[*.cs]
# unnecessary using
dotnet_diagnostic.IDE0005.severity = warning
