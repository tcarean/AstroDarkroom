<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nucleul: tot ce calculeaza si tot ce formateaza. Nu stie nimic despre consola sau
       despre ferestre, si nici nu trebuie sa stie - de asta au putut sa apara doua
       aplicatii peste el fara sa se duplice o cifra.

       Impartirea nu e cosmetica: inainte, "Analysis/ si Report/ sunt pure" era o
       conventie tinuta de bunavointa. Acum e o granita de compilare - nimic de aici nu
       POATE ajunge la Console, fiindca nu exista un punct de intrare care sa-l cheme.

       Versiunea si copyright-ul NU sunt aici: vin din Directory.Build.props, ca sa fie
       aceleasi in toate cele trei assembly-uri. Vezi comentariul de acolo. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Singura dependenta externa a uneltei, si numai pentru modul de expunere pe
       fisiere raw de aparat. Restul (FITS, PNG) ramane scris de mana, ca pana acum.

       De ce un pachet: nu exista NICIO librarie .NET pur managed care sa decodeze
       mozaicul Bayer dintr-un NEF. Sdcb.LibRaw leaga chiar libraw-ul pe care il
       foloseste si rawpy in flatcheck.py, deci cifrele ies bit-identice: aceeasi suma
       pe toti pixelii, nu doar "aproape". Orice alternativa ori debayerizeaza (si atunci
       modul n-are ce masura), ori e comerciala, ori porneste un dcraw.exe extern.

       Pachetele runtime.* aduc DLL-uri native (raw_r, jpeg8, lcms2, zlib1, ~2.1 MB).
       Ele NU intra in flatcheck.exe decat la publish cu
       IncludeNativeLibrariesForSelfExtract (vezi README). Fara ele modurile pe FITS merg
       neschimbate; doar caile raw refuza, cu mesaj explicit: vezi RawReader.Load. -->
  <ItemGroup>
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" Version="0.21.1" />
    <PackageReference Include="Sdcb.LibRaw.runtime.linux64" Version="0.21.1" />
  </ItemGroup>

  <!-- Nucleul ramane internal in intregime. Nu i s-a construit o suprafata publica
       fiindca n-are public: cei trei consumatori sunt in acelasi repo, se compileaza
       impreuna, si a face publice cele cinci record-uri de rezultat ar fi insemnat sa
       le transform campurile in proprietati doar ca sa multumesc un compilator.

       Aplicatia WPF nu leaga XAML direct de record-urile astea (binding-ul WPF nu vede
       campuri, doar proprietati) - are ViewModel-uri care le citesc si expun exact ce
       trebuie afisat. Deci lista de mai jos nu e o portita, e contractul. -->
  <ItemGroup>
    <InternalsVisibleTo Include="flatcheck" />
    <InternalsVisibleTo Include="FlatCheck.Tests" />
    <InternalsVisibleTo Include="FlatCheck.Wpf" />
    <InternalsVisibleTo Include="FlatCheck.Wpf.Tests" />
  </ItemGroup>

</Project>
