<Project>

  <!-- Properties shared by every project in the solution.

       Why here and not in each csproj: since the core became a separate library
       (FlatCheck.Core), the version has to be the same in three assemblies. VersionInfo
       reads it from the assembly it lives in, Core, but the console exe and the WPF app
       carry their own, which is what Windows shows in file properties. Two places to edit
       means, sooner or later, two different values.

       So: ONE place to edit on the C# side, exactly as before the split. Do not move
       <Version> or <Copyright> back into a csproj; VersionTests checks this file. -->

  <PropertyGroup>
    <!-- The tool's version. Bumped BY HAND by the owner, per feature or fix; never by the
         model. The one place it lives (scripts/release.ps1 writes it); the frozen
         flatcheck.py keeps its own 2.2.0 and is not synchronised (ADR 0047). -->
    <Version>2.3.0</Version>

    <!-- Copyright and licence. <Copyright> becomes AssemblyCopyrightAttribute, which
         VersionInfo.Copyright reads and prints under the banner. The program is GPLv3;
         the full text is in LICENSE at the project root. -->
    <Copyright>Copyright (C) 2026 Tudor Carean</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Reproducibility (ADR 0003): same sources, same bytes; every package version in
       Directory.Packages.props, once; the full graph in packages.lock.json, which CI
       restores in locked mode. Strictness (warnings as errors) is applied by
       scripts/verify.ps1 on the command line rather than here, so an IDE build stays
       lenient while the gate does not. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- The runtime the release publishes for (kit.json, release.publish: -r win-x64). Declared
         here, every restore writes its section into packages.lock.json; otherwise a publish for
         it rewrites the lock files and the release stops on them. The test projects are never
         published, so they leave it out (ADR 0056). -->
    <RuntimeIdentifiers Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">win-x64</RuntimeIdentifiers>

    <!-- The single-file analyzer, which PublishSingleFile turns on for the console's publish,
         brings its package (Microsoft.NET.ILLink.Tasks, at the installed SDK's version) into the
         lock files. Off, a publish leaves them alone (ADR 0056). -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>

    <!-- NuGet's audit warnings (NU1902 moderate, NU1903 high: a package has a published
         advisory) stay warnings when the gate asks for -warnaserror: the gate shows them, never
         hides them, and does not go red on them. ImageSharp 3.1.11 is pinned (ADR 0010) and the
         only version with the five advisories of 2026 patched is 4.1.2, the line ADR 0010
         rejects; each advisory is read and judged in ADR 0058 and in
         docs/design/dependencies.md, where the next one goes too. -->
    <MSBuildWarningsNotAsErrors>NU1902;NU1903</MSBuildWarningsNotAsErrors>

    <!-- The XML documentation file, written so the compiler checks every doc comment: with the
         gate's -warnaserror a malformed comment, a <param> naming no parameter, a parameter left
         untagged beside tagged ones or a cref that does not resolve fails the build. CS1591
         (a public member without a comment) stays muted: it asks for public members only,
         properties included, and the core is internal; the kit's rule "Documentation comments"
         is the one that applies. Nothing reads the XML at run time, so no publish ships it
         (ADR 0059). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>

</Project>
