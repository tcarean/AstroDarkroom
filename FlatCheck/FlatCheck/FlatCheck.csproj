<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>flatcheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Versiunea uneltei. Se incrementeaza MANUAL, de mana, la fiecare feature/fix.
         Trebuie sa ramana identica cu __version__ din flatcheck.py. -->
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlatCheck.Tests" />
  </ItemGroup>
</Project>
