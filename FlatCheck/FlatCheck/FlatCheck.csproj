<Project Sdk="Microsoft.NET.Sdk">

  <!-- The console application. Since the split in 2.0.0 it holds only the entry point, the
       parsing of the arguments and the dispatch over the modes; everything that computes and
       everything that formats sits in FlatCheck.Core.

       The version and the copyright come from Directory.Build.props - a single place for all
       the projects. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>flatcheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The icon in the file's properties and in Explorer. The same file as the WPF
         application's, from Icon/ at the root - generated by Icon/make_icon.py. -->
    <ApplicationIcon>..\Icon\flatcheck.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlatCheck.Core\FlatCheck.Core.csproj" />
  </ItemGroup>

  <!-- The lensfun database (CC BY-SA 3.0), shipped unchanged in the lensfun/ folder beside
       the exe: the vignetting profiles for the synthetic flat. It is not embedded in the
       assembly - it is updated by replacing the files in the folder. The source is lensfun/
       at the repo's root, copied at build and at publish. See THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <None Include="..\lensfun\*.xml;..\lensfun\*.dtd;..\lensfun\LENSFUN-VERSION.txt;..\lensfun\LICENSE.txt"
          Link="lensfun\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlatCheck.Tests" />
  </ItemGroup>

</Project>
