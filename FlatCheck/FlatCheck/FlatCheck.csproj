<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aplicatia de consola. Dupa impartirea din 2.0.0 nu mai contine decat punctul de
       intrare, parsarea argumentelor si dispeceratul pe moduri; tot ce calculeaza si tot
       ce formateaza sta in FlatCheck.Core.

       Versiunea si copyright-ul vin din Directory.Build.props - un singur loc pentru
       toate proiectele. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>flatcheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Icoana din proprietatile fisierului si din Explorer. Acelasi fisier ca la
         aplicatia WPF, din Icon/ la radacina - generat de Icon/make_icon.py. -->
    <ApplicationIcon>..\Icon\flatcheck.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlatCheck.Core\FlatCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlatCheck.Tests" />
  </ItemGroup>

</Project>
