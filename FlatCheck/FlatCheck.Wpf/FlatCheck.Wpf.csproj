<Project Sdk="Microsoft.NET.Sdk">

  <!-- The windowed application. The same core as flatcheck.exe, through FlatCheck.Core - it
       reimplements no figure and no report line; see Runs/RunOutcome.cs in Core for how the
       work is divided.

       net8.0-windows + UseWPF makes this project Windows-only, and that makes
       "dotnet build FlatCheck.sln" no longer work on Linux. The console stays portable if its
       own project is built directly (dotnet build FlatCheck/FlatCheck.csproj).

       The version and the copyright come from Directory.Build.props, as for the other
       projects, so that the banner written in "Rezultat testare.txt" is guaranteed the same as
       the console's. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FlatCheck.Wpf</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- The exe's icon (Explorer, pinning to the taskbar). The same as the console's, from Icon/
         at the root. The window gets it separately, through the <Resource> below and Icon= in
         MainWindow.xaml: without it WPF looks for it in the process's exe, which under
         "dotnet FlatCheck.Wpf.dll" or under a test is dotnet.exe. -->
    <ApplicationIcon>..\Icon\flatcheck.ico</ApplicationIcon>

    <!-- Do NOT put InvariantGlobalization here, however tempting by symmetry with the console
         project. WPF needs culture data to bind anything to a property: with them removed, the
         window crashes at the LOADING of the XAML, with "Cannot find non-neutral culture
         related to 'en-us'" - so not at some particular run, but at start-up, always.

         The invariance we need is another one and is obtained otherwise:
         App.ForceInvariantNumbers fixes the threads' culture, so that "0.24" does not become
         "0,24" on a Romanian Windows. See the comment there for why it matters. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlatCheck.Core\FlatCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Icon\flatcheck.ico" Link="Icon\flatcheck.ico" />
  </ItemGroup>

  <!-- The lensfun database (CC BY-SA 3.0), shipped unchanged in the lensfun/ folder beside
       the exe: the vignetting profiles for the synthetic flat. It is not embedded in the
       assembly - it is updated by replacing the files in the folder. The source is lensfun/
       at the repo's root, copied at build and at publish. See THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <None Include="..\lensfun\*.xml;..\lensfun\*.dtd;..\lensfun\LENSFUN-VERSION.txt;..\lensfun\LICENSE.txt"
          Link="lensfun\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlatCheck.Wpf.Tests" />
  </ItemGroup>

</Project>
