<!-- HistEqGuidePanel - cum se citeste poza egalizata.

     Al patrulea ghid pliat, cu aceeasi forma ca celelalte trei: acelasi stil de
     disclosure, acelasi sablon de rand, textul in SessionMessages. Se leaga la Guide.*
     de pe tabul de histograma. -->

<UserControl x:Class="FlatCheck.Wpf.HistEqGuidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel>

    <ToggleButton Style="{StaticResource Disclosure}"
                  Content="Cum citesc poza egalizata"
                  IsChecked="{Binding Guide.IsExpanded, Mode=TwoWay}" />

    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14"
            Visibility="{Binding Guide.IsExpanded, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                   Text="{Binding Guide.Intro}" />
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Guide.Rows}"
                      ItemTemplate="{StaticResource GuideRowTemplate}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
