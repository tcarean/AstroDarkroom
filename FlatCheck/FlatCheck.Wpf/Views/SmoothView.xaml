<!-- SmoothView - tab 6, the smoothed flat.

     Like the structure tab: the figures on the left, the map on the right. The difference is
     that here nothing runs by itself - the guide stays open above the button, because the
     button writes a file beside the master and what it does must be known before pressing
     it. After the run, what matters is WHAT WAS REMOVED: its figures and its map; the
     structure battery before/after shows that what was the lens's has remained. -->

<UserControl x:Class="FlatCheck.Wpf.SmoothView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlatCheck.Wpf">

  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="440" />
        <ColumnDefinition Width="2*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <!-- ========================================================== figures -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20,18,10,18">
        <StackPanel>

          <TextBlock Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis">
            <Run Text="din: " /><Run Text="{Binding Source, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
            <Run Text="in: " /><Run Text="{Binding Target, Mode=OneWay}" />
          </TextBlock>

          <!-- the guide, OPEN by default: it is the button's precondition -->
          <ToggleButton Style="{StaticResource Disclosure}" Margin="0,14,0,0"
                        Content="Ce face netezirea"
                        IsChecked="{Binding Guide.IsExpanded, Mode=TwoWay}" />
          <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14"
                  Visibility="{Binding Guide.IsExpanded, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Text="{Binding Guide.Intro}" />
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Guide.Rows}"
                            ItemTemplate="{StaticResource GuideRowTemplate}" />
            </StackPanel>
          </Border>

          <!-- the scale and the button. A unique GroupName in the window, as for the map chips. -->
          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Faint}" Text="scara:" Margin="0,0,10,0"
                         VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding Scale.Options}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton GroupName="SmoothScale" Margin="0,0,14,0"
                                 Content="{Binding Label}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Margin="16,0,0,0" Padding="14,6" Content="{Binding AdviseLabel}"
                      Command="{Binding AdviseCommand}" />
              <Button Margin="10,0,0,0" Padding="14,6" Content="{Binding ButtonLabel}"
                      Command="{Binding RunCommand}" />
            </StackPanel>
          </Border>

          <!-- the scale proposal: the table of the steps and the conclusion, under the chips -->
          <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                  Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap">
                <Run Text="textura fina intrare: " /><Run Text="{Binding AdviceTexture, Mode=OneWay}" />
              </TextBlock>
              <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding AdviceRows}"
                            ItemTemplate="{StaticResource MetricRowTemplate}" />
              <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding AdviceVerdict}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding AdviceNote}" />
              <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding AdviceCaveat}" />
            </StackPanel>
          </Border>

          <local:MessagePanel Margin="0,14,0,0" />

          <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">

            <TextBlock Style="{StaticResource Faint}" Margin="2,14,0,0" Text="{Binding Frame}" />
            <TextBlock Style="{StaticResource Faint}" Margin="2,2,0,0" Text="{Binding ScaleLine}" />
            <TextBlock Style="{StaticResource Faint}" Margin="2,2,0,0" Text="{Binding Rejected}" TextWrapping="Wrap" />

            <!-- where the file went, or why not -->
            <TextBlock Style="{StaticResource Muted}" Margin="2,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding SavedTo, Converter={StaticResource NotNullToVis}}">
              <Run Text="Flat netezit salvat:" />
              <Run Text="{Binding SavedTo, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Muted}" Foreground="#E3B341" Margin="2,12,0,0"
                       TextWrapping="Wrap" Text="{Binding SaveError}"
                       Visibility="{Binding SaveError, Converter={StaticResource NotNullToVis}}" />

            <!-- the warning: yellow, not red - it is not a verdict, it is a question put to the
                 user -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
              <TextBlock Style="{StaticResource Muted}" Foreground="#E3B341" TextWrapping="Wrap"
                         Text="{Binding Warning}" />
            </Border>

            <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="CE S-A SCOS" />
            <Border Style="{StaticResource Card}">
              <ItemsControl ItemsSource="{Binding Removed}"
                            ItemTemplate="{StaticResource MetricRowTemplate}" />
            </Border>

            <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="INAINTE" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Style="{StaticResource Muted}" Text="verdict" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <Border Background="{Binding BeforeVerdict, Converter={StaticResource VerdictToBrush}}"
                          CornerRadius="4" Padding="10,3">
                    <TextBlock Text="{Binding BeforeVerdict}" Foreground="#16161A" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Before}"
                              ItemTemplate="{StaticResource MetricRowTemplate}" />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="DUPA" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Style="{StaticResource Muted}" Text="verdict" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <Border Background="{Binding AfterVerdict, Converter={StaticResource VerdictToBrush}}"
                          CornerRadius="4" Padding="10,3">
                    <TextBlock Text="{Binding AfterVerdict}" Foreground="#16161A" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding After}"
                              ItemTemplate="{StaticResource MetricRowTemplate}" />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Faint}" Margin="2,18,0,0" TextWrapping="Wrap" Text="{Binding Caveat}" />
            <TextBlock Style="{StaticResource Faint}" Margin="2,8,0,0" TextWrapping="Wrap" Text="{Binding SirilNote}" />

            <local:ReportPanel Margin="0,14,0,0" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- ========================================================== map -->
      <Grid Grid.Column="1" Margin="10,18,20,18"
            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="HARTA" />

        <!-- which map: what was removed (default) or what remained -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
          <RadioButton GroupName="SmoothMapKind" Margin="0,0,16,0"
                       Content="ce s-a scos (original / netezit)"
                       IsChecked="{Binding ShowAfterMap, Converter={StaticResource Not}, Mode=OneWay}" />
          <RadioButton GroupName="SmoothMapKind"
                       Content="reziduul flat-ului netezit"
                       IsChecked="{Binding ShowAfterMap, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
          <TextBlock Style="{StaticResource Faint}" Text="scara:" Margin="0,0,10,0"
                     VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding MapScale.Options}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="SmoothMapScale" Margin="0,0,14,0"
                             Content="{Binding Label}"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
          <Image Source="{Binding Map, Converter={StaticResource PngToImage}}"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Margin="2,8,0,0"
                   Text="{Binding MapLegend}" />
      </Grid>
    </Grid>

    <local:BusyOverlay />
  </Grid>
</UserControl>
