<!-- HistogramGuidePanel - how to read the per-channel histograms.

     The application's third folded guide, with the same shape as MapGuidePanel and
     HowToReadPanel: the same disclosure style, the same row template, the text in
     SessionMessages. Folded by default, so that the verdict and the figures stay first.

     The state sits in the view-model (HistogramGuide.IsExpanded), not in a local
     ElementName, so that a test can open it - the bindings inside a folded card are never
     evaluated, and a binding that fails on display is exactly what WindowSmokeTests looks
     for. -->

<UserControl x:Class="FlatCheck.Wpf.HistogramGuidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf">

  <StackPanel>

    <ToggleButton Style="{StaticResource Disclosure}"
                  Content="{l:T En='How to read the histograms', Ro='Cum citesc histogramele'}"
                  IsChecked="{Binding HistogramGuide.IsExpanded, Mode=TwoWay}" />

    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14"
            Visibility="{Binding HistogramGuide.IsExpanded, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                   Text="{Binding HistogramGuide.Intro}" />
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding HistogramGuide.Rows}"
                      ItemTemplate="{StaticResource GuideRowTemplate}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
