<!-- HistogramGuidePanel - cum se citesc histogramele pe canal.

     Al treilea ghid pliat al aplicatiei, cu aceeasi forma ca MapGuidePanel si
     HowToReadPanel: acelasi stil de disclosure, acelasi sablon de rand, textul in
     SessionMessages. Pliat implicit, ca verdictul si cifrele sa ramana primele.

     Starea sta in ViewModel (HistogramGuide.IsExpanded), nu intr-un ElementName local,
     ca s-o poata deschide un test - legarile din interiorul unui card pliat nu sunt
     niciodata evaluate, si tocmai o legare care cade la afisare e ce cauta
     WindowSmokeTests. -->

<UserControl x:Class="FlatCheck.Wpf.HistogramGuidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel>

    <ToggleButton Style="{StaticResource Disclosure}"
                  Content="Cum citesc histogramele"
                  IsChecked="{Binding HistogramGuide.IsExpanded, Mode=TwoWay}" />

    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14"
            Visibility="{Binding HistogramGuide.IsExpanded, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                   Text="{Binding HistogramGuide.Intro}" />
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding HistogramGuide.Rows}"
                      ItemTemplate="{StaticResource GuideRowTemplate}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
