<!-- RatioView - tab 2, the attribution by 180-degree rotation.

     The only tab that asks for two files chosen explicitly, and the only one that explains
     its requirements BEFORE any computation. The reason is in RatioTabViewModel: the mode
     needs two MASTERS, one for each orientation, and the two come from two nights, so from
     two session folders. A folder cannot offer them, and a list that tried offered in fact
     the individual frames - from which comes a result that is confident and false. So: the
     documentation at the top, two buttons, and nothing presumed. -->

<UserControl x:Class="FlatCheck.Wpf.RatioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlatCheck.Wpf">

  <UserControl.Resources>
    <!-- Only the file's name is shown; the full path would break the width, and the two
         now sit in different folders, so they could not be aligned anyway. -->
    <local:FileNameConverter x:Key="FileName" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================================ documentation and choices -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}" Padding="20,14"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1">
      <StackPanel>

        <Expander IsExpanded="True" Foreground="{StaticResource TextBr}"
                  Header="Cum se foloseste testul asta">
          <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,4"
                     TextWrapping="Wrap" Text="{Binding Documentation, Mode=OneTime}" />
        </Expander>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Heading}"
                     Text="SETUL A  (inainte de rotatie)" />
          <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Heading}"
                     Text="SETUL B  (dupa rotatia de 180)" />

          <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Alege..." Margin="8,0,0,0"
                    Click="ChooseA" />
            <Border Background="{StaticResource WindowBg}" BorderThickness="1"
                    BorderBrush="{StaticResource BorderBr}" Padding="8,5" CornerRadius="3">
              <TextBlock TextTrimming="CharacterEllipsis"
                         Text="{Binding FileA, Converter={StaticResource FileName},
                                       TargetNullValue=nimic ales}" />
            </Border>
          </DockPanel>

          <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Alege..." Margin="8,0,0,0"
                    Click="ChooseB" />
            <Border Background="{StaticResource WindowBg}" BorderThickness="1"
                    BorderBrush="{StaticResource BorderBr}" Padding="8,5" CornerRadius="3">
              <TextBlock TextTrimming="CharacterEllipsis"
                         Text="{Binding FileB, Converter={StaticResource FileName},
                                       TargetNullValue=nimic ales}" />
            </Border>
          </DockPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ============================================================ results -->
    <Grid Grid.Row="1">
      <local:MessagePanel Margin="20" />

      <!-- The starting state. MessagePanel appears only on an error, and "n-ai ales inca
           nimic" is not an error - without this, the tab opened on an empty rectangle.
           Two nested bindings instead of a MultiBinding: the outer one hides the hint
           when there is a result, the inner one when there is an error. -->
      <Grid Visibility="{Binding HasResult, Converter={StaticResource NotBoolToVis}}">
        <Border Visibility="{Binding HasError, Converter={StaticResource NotBoolToVis}}"
                Style="{StaticResource Card}" Margin="20" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}"
                       Text="ALEGE CELE DOUA MASTERE" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Cate unul pentru fiecare orientare, cu butoanele de mai sus. In fluxul obisnuit sunt doua fisiere pp_flat_stacked.fit, din doua foldere de sesiune diferite - unul de dinainte de rotatie, unul de dupa." />
            <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Tabul nu propune nimic, si asta e o decizie: folderul deschis e cel mult una dintre cele doua sedinte, iar ce ar putea propune din el sunt cadre individuale - din care iese un rezultat increzator si gresit." />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" MinWidth="420" />
          <ColumnDefinition Width="2*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20,18,10,18">
          <StackPanel>

            <!-- The provenance at the top, not buried in the report: it is the only place that
                 shows whether the two stacks CAN really be from two different orientations. -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="DE UNDE VIN CELE DOUA STIVE" />
                <!-- The Number style aligns right, so that the figures line up in columns.
                     Here they are sentences, so it is overridden. -->
                <TextBlock Style="{StaticResource Number}" Margin="0,8,0,0"
                           HorizontalAlignment="Left"
                           Text="{Binding ProvenanceA, StringFormat='A : {0}'}" />
                <TextBlock Style="{StaticResource Number}" Margin="0,3,0,0"
                           HorizontalAlignment="Left"
                           Text="{Binding ProvenanceB, StringFormat='B : {0}'}" />
                <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Text="{Binding Precondition, Mode=OneTime}" />
              </StackPanel>
            </Border>

            <!-- The world-fixed component. Informative: it does not vote in the verdict. -->
            <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8"
                       Text="COMPONENTA FIXA IN LUME  (informativ)" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <!-- The same MetricRow rows as the rest of the screen, with the description under
                     each. They were two Grids written by hand: one without any word under it, the
                     other with a coloured pill that looked like a verdict without being one - the
                     note now says it is informative and what its thresholds are. -->
                <ItemsControl ItemsSource="{Binding WorldRows}"
                              ItemTemplate="{StaticResource MetricRowTemplate}" />
                <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0"
                           TextWrapping="Wrap" Text="{Binding WorldMeaning, Mode=OneTime}" />
              </StackPanel>
            </Border>

            <!-- The verdict: the structure of the combined master, that is of the camera-fixed
                 part. -->
            <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8"
                       Text="STRUCTURA MASTERULUI COMBINAT  (A+B)/2  -  partea fixa pe aparat" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="VERDICT" Style="{StaticResource Heading}" Margin="0,0,12,0"
                             VerticalAlignment="Center" />
                  <Border Background="{Binding Verdict, Converter={StaticResource VerdictToBrush}}"
                          CornerRadius="4" Padding="12,4">
                    <TextBlock Text="{Binding Verdict}" Foreground="#16161A"
                               FontSize="16" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Text="{Binding Advice}" />
                <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Text="{Binding SensorCaveat, Mode=OneTime}" />
                <!-- The dust warning on the combined master, as in the Structura tab: yellow, not
                     red, and not in the pill - it asks what the flat is used for. -->
                <TextBlock Style="{StaticResource Muted}" Foreground="#E3B341" Margin="0,12,0,0"
                           TextWrapping="Wrap" Text="{Binding LocalSpotWarning}"
                           Visibility="{Binding LocalSpotWarning, Converter={StaticResource NotNullToVis}}" />
              </StackPanel>
            </Border>

            <!-- The five tests, from a single list and with the same template as the Structura
                 tab. They were five Grid blocks written by hand, with the labels as literals and
                 no room for a description - that is why they stayed without descriptions when
                 tab 1 got them. The rows come from StructureRows, so the two tabs can no longer
                 diverge. -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <ItemsControl ItemsSource="{Binding Tests}"
                            ItemTemplate="{StaticResource MetricRowTemplate}" />
            </Border>

            <!-- The quantities without a verdict, also from StructureRows: what the console prints
                 under INFORMATIV for the attribution mode. Without the ADU levels line, which on
                 the combined master, normalised to a median of 1, would mean nothing - the console
                 does not print it there either. -->
            <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8"
                       Text="INFORMATIV (nu sunt teste)" />
            <Border Style="{StaticResource Card}">
              <ItemsControl ItemsSource="{Binding Informative}"
                            ItemTemplate="{StaticResource MetricRowTemplate}" />
            </Border>

            <local:ReportPanel Margin="0,14,0,0" />

          </StackPanel>
        </ScrollViewer>

        <!-- Two maps, because the mode split the master into two components. By default the
             one that matches the verdict is shown. -->
        <Grid Grid.Column="1" Margin="10,18,20,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="HARTA" />

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
            <!-- Only the second binds both ways. The first is OneWay because a TwoWay binding
                 through a converter without ConvertBack throws the moment the group updates its
                 other button - and the group does that on loading, so the window did not even
                 start. -->
            <RadioButton GroupName="RatioMap" Margin="0,0,16,0"
                         Content="fix pe aparat"
                         IsChecked="{Binding ShowWorldMap, Converter={StaticResource Not},
                                             Mode=OneWay}" />
            <RadioButton GroupName="RatioMap"
                         Content="fix in lume (A/B)"
                         IsChecked="{Binding ShowWorldMap, Mode=TwoWay}" />
          </StackPanel>

          <!-- The scale applies to the map shown, whichever of the two it is. The GroupName
               differs from the one in the Structura tab: WPF groups RadioButtons by name in the
               whole window, so a shared name would make the chips uncheck each other across
               tabs. -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
            <TextBlock Style="{StaticResource Faint}" Text="scara:" Margin="0,0,10,0"
                       VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding MapScale.Options}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="RatioMapScale" Margin="0,0,14,0"
                               Content="{Binding Label}"
                               IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Image Source="{Binding Map, Converter={StaticResource PngToImage}}"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>

          <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Margin="2,8,0,0"
                     Text="{Binding MapLegend}" />

          <TextBlock Grid.Row="5" Style="{StaticResource Faint}" Margin="2,8,0,0"
                     TextWrapping="Wrap"
                     Text="Prima harta e reziduul partii fixe pe aparat, deci se potriveste cu verdictul de mai sus. A doua e raportul A/B: pe ea se vede FORMA gradientului extern, la dublul amplitudinii reale." />

          <local:MapGuidePanel Grid.Row="6" Margin="0,8,0,0" />
        </Grid>
      </Grid>

      <local:BusyOverlay />
    </Grid>
  </Grid>
</UserControl>
