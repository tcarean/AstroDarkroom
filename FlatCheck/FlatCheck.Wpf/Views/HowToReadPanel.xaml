<!-- HowToReadPanel - what the figures decide and what the eye decides.

     It sits under the verdict, in the figures' column, because it speaks about them first:
     the figures say HOW MUCH and give the verdict, the map says WHAT KIND and does not vote.
     From the screen's layout the split does not show - the two columns look like two views
     of the same thing.

     Folded by default: the verdict must stay the first thing visible in the tab. The state
     sits in the view-model (HowToRead.IsExpanded), not in a local ElementName, so that a
     test can open it - see the note in MapGuidePanel. -->

<UserControl x:Class="FlatCheck.Wpf.HowToReadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf">

  <StackPanel>

    <ToggleButton Style="{StaticResource Disclosure}"
                  Content="{l:T En='How to read the tab: what the figures decide and what the eye decides', Ro='Cum citesc tabul: ce decid cifrele si ce decide ochiul'}"
                  IsChecked="{Binding HowToRead.IsExpanded, Mode=TwoWay}" />

    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14"
            Visibility="{Binding HowToRead.IsExpanded, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                   Text="{Binding HowToRead.Intro}" />
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding HowToRead.Rows}"
                      ItemTemplate="{StaticResource GuideRowTemplate}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
