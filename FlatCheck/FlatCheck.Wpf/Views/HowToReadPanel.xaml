<!-- HowToReadPanel - ce decid cifrele si ce decide ochiul.

     Sta sub verdict, in coloana cifrelor, fiindca despre ele vorbeste in primul rand:
     cifrele spun CAT DE MULT si dau verdictul, harta spune CE FEL si nu voteaza. Din
     asezarea ecranului despartirea nu se vede - cele doua coloane arata ca doua vederi
     ale aceluiasi lucru.

     Pliat implicit: verdictul trebuie sa ramana primul lucru vizibil in tab. Starea sta
     in ViewModel (HowToRead.IsExpanded), nu intr-un ElementName local, ca s-o poata
     deschide un test - vezi nota din MapGuidePanel. -->

<UserControl x:Class="FlatCheck.Wpf.HowToReadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel>

    <ToggleButton Style="{StaticResource Disclosure}"
                  Content="Cum citesc tabul: ce decid cifrele si ce decide ochiul"
                  IsChecked="{Binding HowToRead.IsExpanded, Mode=TwoWay}" />

    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14"
            Visibility="{Binding HowToRead.IsExpanded, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                   Text="{Binding HowToRead.Intro}" />
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding HowToRead.Rows}"
                      ItemTemplate="{StaticResource GuideRowTemplate}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
