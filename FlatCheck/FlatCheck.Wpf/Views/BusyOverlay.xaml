<!-- BusyOverlay - the waiting screen of a tab.

     It has no properties of its own: it binds to the inherited DataContext, which in any tab
     is a TabViewModel. That way the same control works in the seven tabs that use it (all
     but Split, which shows its own run card) without any parametrisation.

     It covers the whole tab, with an almost opaque background, so that the controls cannot
     be pressed while it computes - the alternative would have been to disable every button
     in turn. -->

<UserControl x:Class="FlatCheck.Wpf.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">

  <Border Background="#E01B1B1D">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="460" Margin="24">

      <TextBlock Text="{Binding BusyMessage}" FontSize="15" FontWeight="SemiBold"
                 TextWrapping="Wrap" HorizontalAlignment="Center"
                 TextAlignment="Center" />

      <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                 Text="{Binding BusyDetail}" HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Visibility="{Binding BusyDetail, Converter={StaticResource NotNullToVis}}" />

      <!-- The bar is determinate only on a series, where the number of frames is known. For a
           single analysis there is no knowing how long it will take, so it runs indeterminate
           instead of lying with an invented percentage. -->
      <ProgressBar Width="280" Margin="0,18,0,0" IsIndeterminate="True"
                   Visibility="{Binding ProgressKnown, Converter={StaticResource NotBoolToVis}}" />

      <ProgressBar Width="280" Margin="0,18,0,0" Minimum="0" Maximum="1"
                   Value="{Binding Progress, Mode=OneWay}"
                   Visibility="{Binding ProgressKnown, Converter={StaticResource BoolToVis}}" />

    </StackPanel>
  </Border>
</UserControl>
