<!-- ZoomableImage - o poza intr-un viewport, cu zoom si deplasare.

     LayoutTransform, nu RenderTransform: asa intinderea derulabila urmeaza zoom-ul si
     barele apar exact cand poza nu mai incape. Image cu Stretch=None, ca un pixel de
     bitmap sa fie un pixel de ecran la factor 1. Tot comportamentul e in code-behind. -->

<UserControl x:Class="FlatCheck.Wpf.ZoomableImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

  <ScrollViewer x:Name="scroller"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                Background="{StaticResource PanelBg2}" Focusable="False"
                SizeChanged="OnViewportSizeChanged">
    <Image x:Name="image" Stretch="None"
           HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image.LayoutTransform>
        <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1" />
      </Image.LayoutTransform>
    </Image>
  </ScrollViewer>
</UserControl>
