<!-- MapGuidePanel - the map's reading guide: how to read it and what the shapes mean.

     A control of its own, not markup inside StructureView, so that any tab with a residual
     map on the same scale can show the same guide. It binds to MapGuide.* of the tab's
     view-model, exactly as ReportPanel does to Report.

     Open by default (R-127, ADR 0089), the user can fold it. The state sits in the view-model
     (MapGuide.IsExpanded), not in a local ElementName, so that a test can set it - a wrong
     binding in a folded panel compiles and fails only on display.

     Height bounded with a ScrollViewer: the map sits on an elastic row, so a guide unfolded
     without a ceiling would squeeze it until it is useless. With the ceiling, a maximized
     1920 x 1080 window keeps 85 % of the map's size with the guide open. -->

<UserControl x:Class="FlatCheck.Wpf.MapGuidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf">

  <StackPanel>

    <ToggleButton Style="{StaticResource Disclosure}"
                  Content="{l:T En='How to read the map', Ro='Cum citesc harta'}"
                  IsChecked="{Binding MapGuide.IsExpanded, Mode=TwoWay}" />

    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14"
            Visibility="{Binding MapGuide.IsExpanded, Converter={StaticResource BoolToVis}}">
      <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                     Text="{Binding MapGuide.Intro}" />
          <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding MapGuide.Shapes}"
                        ItemTemplate="{StaticResource GuideRowTemplate}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

  </StackPanel>
</UserControl>
