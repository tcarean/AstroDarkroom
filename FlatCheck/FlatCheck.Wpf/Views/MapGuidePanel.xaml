<!-- MapGuidePanel - ghidul de citire al hartii: cum se citeste si ce inseamna formele.

     Un singur control pentru doua taburi (Structura si Ratio), fiindca amandoua arata
     acelasi reziduu pe aceeasi scara, deci acelasi ghid. Se leaga la MapGuide.* din
     ViewModel-ul tabului, exact ca ReportPanel la Report.

     Pliat implicit: sase randuri de text sub fiecare harta ar ineca tocmai cifrele.
     Starea sta in ViewModel (MapGuide.IsExpanded), nu intr-un ElementName local, ca s-o
     poata deschide un test - o legare gresita intr-un panou pliat compileaza si cade
     abia la afisare.

     Inaltime marginita cu ScrollViewer: harta sta pe un rand elastic, deci un ghid
     desfasurat fara plafon ar strange-o pana devine inutila. -->

<UserControl x:Class="FlatCheck.Wpf.MapGuidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel>

    <ToggleButton Style="{StaticResource Disclosure}"
                  Content="Cum citesc harta"
                  IsChecked="{Binding MapGuide.IsExpanded, Mode=TwoWay}" />

    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14"
            Visibility="{Binding MapGuide.IsExpanded, Converter={StaticResource BoolToVis}}">
      <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                     Text="{Binding MapGuide.Intro}" />
          <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding MapGuide.Shapes}"
                        ItemTemplate="{StaticResource GuideRowTemplate}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

  </StackPanel>
</UserControl>
