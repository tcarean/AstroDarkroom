<!-- ReportPanel - the raw report, exactly as the console would have written it.

     Folded by default: the panels above say the same thing better laid out. It exists
     because it is the text pasted on a forum or in a message, and because on the Structura
     and Split tabs it is exactly the content of the file saved on disk - not a second wording
     of it.

     A TextBox and not a TextBlock, so that it can be selected and copied. IsReadOnly,
     obviously. -->

<UserControl x:Class="FlatCheck.Wpf.ReportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf">

  <StackPanel Visibility="{Binding Report, Converter={StaticResource NotNullToVis}}">

    <ToggleButton x:Name="Toggle" HorizontalAlignment="Left" Margin="0,4,0,0"
                  Cursor="Hand" Background="Transparent" BorderThickness="0">
      <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="chev" Text="&#x25B8;" Foreground="{StaticResource MutedBr}"
                       VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBlock Text="{l:T En='Text report (identical to the console\'s output)', Ro='Raport text (identic cu iesirea din consola)'}"
                       Foreground="{StaticResource MutedBr}" FontSize="12" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="chev" Property="Text" Value="&#x25BE;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chev" Property="Foreground" Value="{StaticResource AccentBr}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </ToggleButton.Template>
    </ToggleButton>

    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="0"
            Visibility="{Binding IsChecked, ElementName=Toggle, Converter={StaticResource BoolToVis}}">
      <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True"
               FontFamily="{StaticResource MonoFont}" FontSize="12"
               Background="Transparent" Foreground="{StaticResource MutedBr}"
               BorderThickness="0" Padding="14" MaxHeight="420"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               TextWrapping="NoWrap" />
    </Border>

  </StackPanel>
</UserControl>
