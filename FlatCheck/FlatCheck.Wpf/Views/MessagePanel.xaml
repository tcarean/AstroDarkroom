<!-- MessagePanel - explicatia care apare in locul rezultatelor.

     Ca si BusyOverlay, se leaga la TabViewModel-ul mostenit ca DataContext. Textele sunt
     lungi intentionat: cerintele cer sa se explice CE lipseste si CE sa faca omul, nu
     doar ca ceva a esuat. De aceea panoul se intinde pe latime si nu incearca sa incapa
     intr-o singura linie. -->

<UserControl x:Class="FlatCheck.Wpf.MessagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">

  <Border Style="{StaticResource Card}" BorderBrush="#5A3A3A" Background="#2A2224"
          VerticalAlignment="Top" Margin="0,0,0,16">
    <StackPanel>
      <TextBlock Text="{Binding ErrorTitle}" FontSize="14" FontWeight="SemiBold"
                 Foreground="#F0857E" TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                 Text="{Binding ErrorText}" />
    </StackPanel>
  </Border>
</UserControl>
