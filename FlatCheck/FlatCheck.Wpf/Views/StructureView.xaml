<!-- StructureView - tab 1.

     Two columns: the figures on the left, the residual map on the right. The map deserves
     half the screen because it answers a question the figures cannot ask - what SHAPE the
     problem has. A horizontal gradient, a diagonal one and a spot in a corner can give the
     same percentage and have completely different causes. -->

<UserControl x:Class="FlatCheck.Wpf.StructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf"
             xmlns:local="clr-namespace:FlatCheck.Wpf">

  <UserControl.Resources>
    <!-- A row of the table "vignetarea fata de profilul obiectivului": the source, the lens and
         the mount on the first line; the profile used, its depth, the difference from the master
         and the pill on the second; the note (the calibration format against the sensor) on the
         third, ONLY in the name column, on as many lines as it needs - stretched under the
         figures it looks like a continuation of them, and the user said it "arata dubios". The
         row that gives the verdict is marked three ways, so it is clear which one it is among
         several (the owner asked, 2026-10-31): an accent bar on its left with a lighter
         background, the words "gives the verdict" in the accent colour beside the lens's name,
         and bold text, like the residual in the tests table. Local, not in Dark.xaml: its only
         consumer is this tab. -->
    <DataTemplate x:Key="LensProfileRowTemplate">
      <Border Margin="0,0,0,10" CornerRadius="3" Padding="8,6">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNearest}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBr}" />
                <Setter Property="Background" Value="{StaticResource PanelBg2}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" MinWidth="104" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="4">
          <Border DockPanel.Dock="Left" Background="{StaticResource PanelBg2}" CornerRadius="3"
                  Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Faint}" Text="{Binding Source}" />
          </Border>
          <TextBlock Style="{StaticResource Faint}" DockPanel.Dock="Right" Margin="10,0,0,0"
                     Text="{Binding Where}" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Foreground="{StaticResource AccentBr}"
                     Text="{l:T En='gives the verdict', Ro='da verdictul'}" VerticalAlignment="Center"
                     Visibility="{Binding IsNearest, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding Lens}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Faint}" Margin="0,3,0,0"
                   Text="{Binding Profile}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Number}" Margin="12,3,0,0"
                   Text="{Binding Depth}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Number}" Margin="12,3,0,0"
                   Text="{Binding DiffAndError}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="1" Grid.Column="3" Margin="14,3,0,0" HorizontalAlignment="Left"
                        Content="{Binding Verdict}" ContentTemplate="{StaticResource VerdictChip}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,3,12,0"
                   TextWrapping="Wrap" Text="{Binding Note}"
                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                  <Setter Property="Foreground" Value="#E3B341" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNearest}" Value="True">
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
      </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <local:MessagePanel Margin="20" />

    <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="440" />
        <ColumnDefinition Width="2*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <!-- ========================================================== figures -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20,18,10,18">
        <StackPanel>

          <TextBlock Style="{StaticResource Faint}" Text="{Binding Source}"
                     TextTrimming="CharacterEllipsis" />
          <!-- two masters in the folder (masters/ and process/): it says which one was taken -->
          <TextBlock Margin="0,6,0,0" Foreground="#F0C674" TextWrapping="Wrap" FontSize="12"
                     Text="{Binding SourceWarning}"
                     Visibility="{Binding HasSourceWarning, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" Text="{Binding Size}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,1,0,0" Text="{Binding Levels}" />

          <!-- the verdict, at the top and large: it is the only thing the tab is opened for -->
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="VERDICT" Style="{StaticResource Heading}" Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                <Border Background="{Binding Verdict, Converter={StaticResource VerdictToBrush}}"
                        CornerRadius="4" Padding="12,4">
                  <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictToWord}}" Foreground="#16161A"
                             FontSize="16" FontWeight="Bold" />
                </Border>
              </StackPanel>
              <!-- the shape and the depth, when compared with the profile: it says which of the two
                   gave the verdict, because the pill alone cannot -->
              <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0" TextWrapping="Wrap"
                         Text="{Binding VerdictDetail}"
                         Visibility="{Binding VerdictDetail, Converter={StaticResource NotNullToVis}}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding Advice}" />
              <!-- The warning for a compact spot. Yellow, not red, and not in the verdict pill: it
                   does not say the flat is bad, it asks what you use it for. -->
              <TextBlock Style="{StaticResource Muted}" Foreground="#E3B341" Margin="0,12,0,0"
                         TextWrapping="Wrap" Text="{Binding LocalSpotWarning}"
                         Visibility="{Binding LocalSpotWarning, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
          </Border>

          <local:HowToReadPanel Margin="0,10,0,0" />

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="{l:T En='TESTS', Ro='TESTE'}" />
          <!-- Under the five rows, why the residual matters: its "the most important one" points
               at these rows. Under the verdict scale it read as outranking the depth (R-126,
               ADR 0088). -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Tests}"
                            ItemTemplate="{StaticResource MetricRowTemplate}" />
              <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding WhyResidual}" />
            </StackPanel>
          </Border>

          <!-- The sixth test, of another kind: the depth of the vignetting against the lens's
               published profiles, judged in stops on the verdict scale below. The five above are
               blind to a radial excess; this is the only place where it shows. The title comes
               from the core. -->
          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="{Binding ProfilesHeading}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <!-- First of all, the box (R-118, ADR 0078): on by default; off, the run compares
                   nothing and the card keeps only the master's depth and the paragraph at its end.
                   Flipping it redoes the comparison on the kept result, so it is locked while
                   the tab runs. Its state is the folder's, in flatcheck.json (R-119). The label is
                   a TextBlock so it can wrap. -->
              <CheckBox Margin="0,0,0,14" IsChecked="{Binding NoFilters, Mode=TwoWay}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                <TextBlock Text="{l:T En='I didn\'t use any filters on my lens', Ro='Nu am folosit niciun filtru pe obiectiv'}"
                           TextWrapping="Wrap" />
              </CheckBox>
              <!-- The lens picker (R-121, ADR 0081), only when the raw gave a range and nothing
                   else, so the rows are every lens of the mount with that range: the core's line
                   says why, then "My lens:" with the no-choice entry first and every candidate.
                   A pick redoes the comparison on the kept result with that lens alone, so it is
                   locked while the tab runs; the choice is the folder's, in flatcheck.json. -->
              <StackPanel Margin="0,0,0,14"
                          Visibility="{Binding OffersLensChoice, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding LensChoicePrompt}" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:T En='My lens:', Ro='Obiectivul meu:'}" FontWeight="SemiBold"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding LensOptions}"
                            SelectedItem="{Binding SelectedLens, Mode=TwoWay}"
                            DisplayMemberPath="Label" VerticalAlignment="Center"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                </Grid>
              </StackPanel>
              <!-- Without Adobe's profiles (R-113, ADR 0073), above whatever the card holds: that
                   they were not found, in the window's red for a message; then what to install,
                   the link to Adobe's page (MainWindow opens it in the browser) and the folders
                   searched, in the card's own colours. The texts come from the core. -->
              <StackPanel Margin="0,0,0,14"
                          Visibility="{Binding AdobeMissing, Converter={StaticResource NotNullToVis}}">
                <TextBlock Style="{StaticResource Muted}" Foreground="#F0857E" TextWrapping="Wrap"
                           Text="{Binding AdobeMissing}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{Binding AdobeInstall, Mode=OneWay}" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                  <Hyperlink NavigateUri="{Binding AdobeLink, Mode=OneWay}">
                    <Run Text="{Binding AdobeLink, Mode=OneWay}" />
                  </Hyperlink>
                </TextBlock>
                <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding AdobeSearched}" />
              </StackPanel>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding ProfileGap}"
                         Visibility="{Binding ProfileGap, Converter={StaticResource NotNullToVis}}" />
              <!-- The master's own depth: with the rows, and alone when the box above is off
                   (R-118) - then it is information, and the paragraph at the end of the card says
                   why nothing is compared. Its own panel, so it does not go with the rows. -->
              <Grid Margin="0,0,0,12"
                    Visibility="{Binding ProfileMaster, Converter={StaticResource NotNullToVis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:T En='the master photographed', Ro='masterul fotografiat'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource Number}" Margin="12,0,0,0"
                           Text="{Binding ProfileMaster}" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Visibility="{Binding HasProfileRows, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding ProfileRows}"
                              ItemTemplate="{StaticResource LensProfileRowTemplate}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="{Binding ProfileSummary}" />
                <!-- What the End to end test would read from the same difference. The depth's
                     scale is a column of the one verdict scale below (R-126), not a table here. -->
                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="{Binding ProfileLightNote}" />
                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{Binding ProfileNote}" />
              </StackPanel>
              <!-- With the box off: why nothing is compared, from the core (R-118). -->
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding FilteredNote}"
                         Visibility="{Binding FilteredNote, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
          </Border>

          <!-- The one verdict scale (R-126, ADR 0088): the five tests' bands and, when the
               vignetting was compared, the depth's in stops, each verdict's cell marked. The
               header row and the rows share the two interval columns' widths, so the size scope
               is the panel around both; the first column is the template's fixed one. -->
          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8"
                     Text="{l:T En='THE VERDICT SCALE', Ro='SCARA VERDICTELOR'}" />
          <Border Style="{StaticResource Card}" Padding="6">
            <StackPanel Grid.IsSharedSizeScope="True">
              <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="105" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ScalePercent" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ScaleStops" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource Faint}" Margin="9,0"
                           Text="{l:T En='the five tests', Ro='cele cinci teste'}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Faint}" Margin="9,0"
                           Text="{l:T En='depth against the profile', Ro='adancimea fata de profil'}"
                           Visibility="{Binding ScaleHasDepth, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="3" Style="{StaticResource Faint}" Margin="9,0"
                           Text="{l:T En='what it means', Ro='ce inseamna'}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Scale}"
                            ItemTemplate="{StaticResource ScaleRowTemplate}" />
              <TextBlock Style="{StaticResource Faint}" Margin="9,8,9,4" TextWrapping="Wrap"
                         Text="{Binding ScaleDepthNote}"
                         Visibility="{Binding ScaleDepthNote, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8"
                     Text="{l:T En='INFORMATIVE (not tests)', Ro='INFORMATIV (nu sunt teste)'}" />
          <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Informative}"
                          ItemTemplate="{StaticResource MetricRowTemplate}" />
          </Border>

          <!-- where the report went on disk, and what happened if it did not get there -->
          <TextBlock Style="{StaticResource Faint}" Margin="2,18,0,0"
                     Visibility="{Binding SavedTo, Converter={StaticResource NotNullToVis}}">
            <Run Text="{l:T En='Report saved:', Ro='Raport salvat:'}" />
            <Run Text="{Binding SavedTo, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Muted}" Foreground="#F0857E" Margin="2,12,0,0"
                     Text="{Binding SaveError}"
                     Visibility="{Binding SaveError, Converter={StaticResource NotNullToVis}}" />

          <local:ReportPanel Margin="0,14,0,0" />

        </StackPanel>
      </ScrollViewer>

      <!-- ========================================================== map -->
      <Grid Grid.Column="1" Margin="10,18,20,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="{l:T En='RESIDUAL MAP', Ro='HARTA REZIDUALA'}" />

        <!-- The colour scale. The GroupName must be unique in the window: WPF groups
             RadioButtons by name in the whole window, so a name shared with another tab would
             make the chips here uncheck the chips there. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
          <TextBlock Style="{StaticResource Faint}" Text="{l:T En='scale:', Ro='scara:'}" Margin="0,0,10,0"
                     VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding MapScale.Options}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="StructureMapScale" Margin="0,0,14,0"
                             Content="{Binding Label}"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
          <Image Source="{Binding Map, Converter={StaticResource PngToImage}}"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="2,8,0,0"
                   Text="{Binding MapLegend}" />

        <local:MapGuidePanel Grid.Row="4" Margin="0,8,0,0" />
      </Grid>
    </Grid>

    <local:BusyOverlay />
  </Grid>
</UserControl>
