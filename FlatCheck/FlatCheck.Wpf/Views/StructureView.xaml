<!-- StructureView - tab 1.

     Two columns: the figures on the left, the residual map on the right. The map deserves
     half the screen because it answers a question the figures cannot ask - what SHAPE the
     problem has. A horizontal gradient, a diagonal one and a spot in a corner can give the
     same percentage and have completely different causes. -->

<UserControl x:Class="FlatCheck.Wpf.StructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf"
             xmlns:local="clr-namespace:FlatCheck.Wpf">

  <UserControl.Resources>
    <!-- A row of the table "vignetarea fata de profilul obiectivului": the source, the lens and
         the mount on the first line; the profile used, its depth, the difference from the master
         and the pill on the second; the note (the calibration format against the sensor) on the
         third, ONLY in the name column, on as many lines as it needs - stretched under the
         figures it looks like a continuation of them, and the user said it "arata dubios". The
         row that gives the verdict is bold, like the residual in the tests table. Local, not in
         Dark.xaml: its only consumer is this tab. -->
    <DataTemplate x:Key="LensProfileRowTemplate">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" MinWidth="104" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="4">
          <Border DockPanel.Dock="Left" Background="{StaticResource PanelBg2}" CornerRadius="3"
                  Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Faint}" Text="{Binding Source}" />
          </Border>
          <TextBlock Style="{StaticResource Faint}" DockPanel.Dock="Right" Margin="10,0,0,0"
                     Text="{Binding Where}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Lens}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Faint}" Margin="0,3,0,0"
                   Text="{Binding Profile}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Number}" Margin="12,3,0,0"
                   Text="{Binding Depth}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Number}" Margin="12,3,0,0"
                   Text="{Binding DiffAndError}" VerticalAlignment="Center" />
        <ContentControl Grid.Row="1" Grid.Column="3" Margin="14,3,0,0" HorizontalAlignment="Left"
                        Content="{Binding Verdict}" ContentTemplate="{StaticResource VerdictChip}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,3,12,0"
                   TextWrapping="Wrap" Text="{Binding Note}"
                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                  <Setter Property="Foreground" Value="#E3B341" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNearest}" Value="True">
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <local:MessagePanel Margin="20" />

    <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="440" />
        <ColumnDefinition Width="2*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <!-- ========================================================== figures -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20,18,10,18">
        <StackPanel>

          <TextBlock Style="{StaticResource Faint}" Text="{Binding Source}"
                     TextTrimming="CharacterEllipsis" />
          <!-- two masters in the folder (masters/ and process/): it says which one was taken -->
          <TextBlock Margin="0,6,0,0" Foreground="#F0C674" TextWrapping="Wrap" FontSize="12"
                     Text="{Binding SourceWarning}"
                     Visibility="{Binding HasSourceWarning, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" Text="{Binding Size}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,1,0,0" Text="{Binding Levels}" />

          <!-- the verdict, at the top and large: it is the only thing the tab is opened for -->
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="VERDICT" Style="{StaticResource Heading}" Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                <Border Background="{Binding Verdict, Converter={StaticResource VerdictToBrush}}"
                        CornerRadius="4" Padding="12,4">
                  <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictToWord}}" Foreground="#16161A"
                             FontSize="16" FontWeight="Bold" />
                </Border>
              </StackPanel>
              <!-- the shape and the depth, when compared with the profile: it says which of the two
                   gave the verdict, because the pill alone cannot -->
              <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0" TextWrapping="Wrap"
                         Text="{Binding VerdictDetail}"
                         Visibility="{Binding VerdictDetail, Converter={StaticResource NotNullToVis}}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding Advice}" />
              <!-- The warning for a compact spot. Yellow, not red, and not in the verdict pill: it
                   does not say the flat is bad, it asks what you use it for. -->
              <TextBlock Style="{StaticResource Muted}" Foreground="#E3B341" Margin="0,12,0,0"
                         TextWrapping="Wrap" Text="{Binding LocalSpotWarning}"
                         Visibility="{Binding LocalSpotWarning, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
          </Border>

          <local:HowToReadPanel Margin="0,10,0,0" />

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="{l:T En='TESTS', Ro='TESTE'}" />
          <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Tests}"
                          ItemTemplate="{StaticResource MetricRowTemplate}" />
          </Border>

          <!-- The sixth test, of another kind: the depth of the vignetting against the lens's
               published profiles, on the scale in stops. The five above are blind to a radial
               excess; this is the only place where it shows. The title comes from the core. -->
          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="{Binding ProfilesHeading}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding ProfileGap}"
                         Visibility="{Binding ProfileGap, Converter={StaticResource NotNullToVis}}" />
              <StackPanel Visibility="{Binding HasProfileRows, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:T En='the master photographed', Ro='masterul fotografiat'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Number}" Margin="12,0,0,0"
                             Text="{Binding ProfileMaster}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ProfileRows}"
                              ItemTemplate="{StaticResource LensProfileRowTemplate}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="{Binding ProfileSummary}" />
                <!-- The depth scale: the same four bands as the residual scale below, in stops,
                     with the verdict's band marked - and the sentence that says it is the same
                     scale, translated, not a new threshold. -->
                <TextBlock Style="{StaticResource Faint}" Margin="0,12,0,4" Text="{l:T En='THE DEPTH SCALE (in stops)', Ro='SCARA ADANCIMII (in stopuri)'}" />
                <ItemsControl ItemsSource="{Binding ProfileScale}"
                              ItemTemplate="{StaticResource ScaleRowTemplate}" />
                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding ProfileScaleNote}" />
                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{Binding ProfileNote}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8"
                     Text="{l:T En='THE SCALE OF THE FIVE TESTS', Ro='SCARA CELOR CINCI TESTE'}" />
          <Border Style="{StaticResource Card}" Padding="6">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Scale}"
                            ItemTemplate="{StaticResource ScaleRowTemplate}" />
              <TextBlock Style="{StaticResource Faint}" Margin="9,8,9,4"
                         Text="{Binding WhyResidual}" />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8"
                     Text="{l:T En='INFORMATIVE (not tests)', Ro='INFORMATIV (nu sunt teste)'}" />
          <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Informative}"
                          ItemTemplate="{StaticResource MetricRowTemplate}" />
          </Border>

          <!-- where the report went on disk, and what happened if it did not get there -->
          <TextBlock Style="{StaticResource Faint}" Margin="2,18,0,0"
                     Visibility="{Binding SavedTo, Converter={StaticResource NotNullToVis}}">
            <Run Text="{l:T En='Report saved:', Ro='Raport salvat:'}" />
            <Run Text="{Binding SavedTo, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Muted}" Foreground="#F0857E" Margin="2,12,0,0"
                     Text="{Binding SaveError}"
                     Visibility="{Binding SaveError, Converter={StaticResource NotNullToVis}}" />

          <local:ReportPanel Margin="0,14,0,0" />

        </StackPanel>
      </ScrollViewer>

      <!-- ========================================================== map -->
      <Grid Grid.Column="1" Margin="10,18,20,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="{l:T En='RESIDUAL MAP', Ro='HARTA REZIDUALA'}" />

        <!-- The colour scale. The GroupName must differ from the one in the Ratio tab: WPF
             groups RadioButtons by name in the whole window, so a shared name would make the
             chips here uncheck the chips there. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
          <TextBlock Style="{StaticResource Faint}" Text="{l:T En='scale:', Ro='scara:'}" Margin="0,0,10,0"
                     VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding MapScale.Options}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="StructureMapScale" Margin="0,0,14,0"
                             Content="{Binding Label}"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
          <Image Source="{Binding Map, Converter={StaticResource PngToImage}}"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="2,8,0,0"
                   Text="{Binding MapLegend}" />

        <local:MapGuidePanel Grid.Row="4" Margin="0,8,0,0" />
      </Grid>
    </Grid>

    <local:BusyOverlay />
  </Grid>
</UserControl>
