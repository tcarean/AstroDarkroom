<!-- ExposureView - tab 4.

     The list of raw flats on the left, the result on the right. The "Sky" switch is at the
     top, beside the list, because it changes the thresholds for any file chosen, not only for
     the current one - and switching it recomputes at once. -->

<UserControl x:Class="FlatCheck.Wpf.ExposureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf"
             xmlns:local="clr-namespace:FlatCheck.Wpf">

  <UserControl.Resources>
    <local:FileNameConverter x:Key="FileName" />
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" MinWidth="220" />
      <ColumnDefinition Width="*" MinWidth="380" />
    </Grid.ColumnDefinitions>

    <!-- ============================================================ list -->
    <Border Grid.Column="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,16,16,16">

        <StackPanel DockPanel.Dock="Top">
          <!-- Content as a TextBlock, not as a string: the label is too long for the column and
               must be able to break into two lines. -->
          <CheckBox IsChecked="{Binding Sky, Mode=TwoWay}">
            <TextBlock Text="{l:T En='Sky flat - thresholds for the sky, not for a panel', Ro='Sky flat - praguri pentru cer, nu pentru panou'}"
                       TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Style="{StaticResource Faint}" Margin="26,6,0,0"
                     Text="{l:T En='On a sky flat a modest level is RIGHT: the sky fades continuously and is full of faint stars, so the master comes out clean from the number of frames, not from a longer exposure. Without this switch, a sky flat at 22 % would be wrongly reported as underexposed.', Ro='La un flat pe cer un nivel modest e CORECT: cerul se stinge continuu si e plin de stele slabe, asa ca masterul iese curat din numarul de cadre, nu dintr-o expunere mai lunga. Fara acest comutator, un flat pe cer la 22 % ar fi raportat gresit ca subexpus.'}" />

          <TextBlock Style="{StaticResource Heading}" Margin="0,20,0,8" Text="{l:T En='RAW FLATS', Ro='FLAT-URI BRUTE'}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource FileName}}"
                         TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============================================================ result -->
    <Grid Grid.Column="1">
      <local:MessagePanel Margin="20" />

      <!-- the state before the first choice: the list has files, but none pressed -->
      <TextBlock MaxWidth="420" Margin="24"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Text="{l:T En='Choose a raw flat from the list to measure its exposure.', Ro='Alege un flat brut din lista ca sa-i masor expunerea.'}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasResult}" Value="False" />
                  <Condition Binding="{Binding HasError}" Value="False" />
                  <Condition Binding="{Binding IsBusy}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
        <!-- Wider than the other tabs: four drawings of 96 px need width so that the positions
             of the peaks can be compared between channels. -->
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="VERDICT" Style="{StaticResource Heading}" Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                <Border Background="{Binding Verdict, Converter={StaticResource VerdictToBrush}}"
                        CornerRadius="4" Padding="12,4">
                  <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictToWord}}" Foreground="#16161A"
                             FontSize="16" FontWeight="Bold" />
                </Border>
              </StackPanel>
              <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding Advice}" />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="{l:T En='LEVELS', Ro='NIVELURI'}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="110" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:T En='CENTRE 20 %, the brightest channel', Ro='CENTRU 20 %, canalul cel mai luminos'}" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0"
                             Text="{l:T En='this figure decides the exposure: in a flat the corners are always darker than the centre (that is the vignetting), so the level over the whole frame is pulled down by the corners and would fool you into exposing more, until the centre reaches saturation', Ro='aceasta cifra decide expunerea: intr-un flat colturile sunt mereu mai intunecate decat centrul (asta e vignetarea), asa ca nivelul pe tot cadrul e tras in jos de colturi si te-ar pacali sa expui mai mult, pana cand centrul ajunge la saturatie'}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Number}" FontWeight="SemiBold"
                           FontSize="15" Text="{Binding Centre}" VerticalAlignment="Top" />
              </Grid>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Muted}" Text="{l:T En='global median (informative)', Ro='mediana globala (informativ)'}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Number}"
                           Foreground="{StaticResource MutedBr}" Text="{Binding Global}" />
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Muted}" Text="{l:T En='clipping in the centre (&#x2265; 98 % of white)', Ro='clipping in centru (&#x2265; 98 % din white)'}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Number}"
                           Foreground="{StaticResource MutedBr}" Text="{Binding Clipping}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- ================================================== per-channel histograms -->
          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="{l:T En='HISTOGRAMS PER CHANNEL', Ro='HISTOGRAME PE CANAL'}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <!-- The drawings' source. A UNIQUE GroupName in the window: WPF groups radio buttons
                   by name everywhere, and a name shared with another tab would uncheck the other
                   one's chips. Disabled when the file has no preview. -->
              <ItemsControl ItemsSource="{Binding Source.Options}" Margin="0,0,0,12"
                            IsEnabled="{Binding Source.IsEnabled}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton GroupName="ExposureHistogramSource" Margin="0,0,18,0"
                                 Content="{Binding Label}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Histograms}"
                            ItemTemplate="{StaticResource ChannelHistogramRowTemplate}" />
              <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Caption}" />

              <!-- The raw / screen table: on both views, because it is the whole point. -->
              <StackPanel Margin="0,14,0,0"
                          Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,6"
                           Text="{l:T En='SENSOR vs SCREEN, CENTRE 20 %', Ro='SENZOR vs ECRAN, CENTRU 20 %'}" />
                <ItemsControl ItemsSource="{Binding Comparison}"
                              ItemTemplate="{StaticResource ScreenPairRowTemplate}" />
              </StackPanel>

              <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding SourceNote}"
                         Visibility="{Binding SourceNote, Converter={StaticResource NotNullToVis}}" />
              <!-- The reading of the raw figures, only on the raw view: under the screen's drawing,
                   a sentence about "the peak at 55 %" would contradict the curve above. -->
              <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" Text="{Binding Reading}"
                         Visibility="{Binding Source.IsPreviewSelected, Converter={StaticResource NotBoolToVis}}" />
            </StackPanel>
          </Border>

          <local:HistogramGuidePanel Margin="0,10,0,0" />

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="{l:T En='THE SCALE AND THE CHANNELS', Ro='SCALA SI CANALELE'}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Muted}" Text="{Binding Scale}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                         FontFamily="{StaticResource MonoFont}" Text="{Binding Channels}" />
              <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0"
                         Text="{Binding ChannelOrder}" />
            </StackPanel>
          </Border>

          <local:ReportPanel Margin="0,16,0,0" />

        </StackPanel>
      </ScrollViewer>

      <local:BusyOverlay />
    </Grid>
  </Grid>
</UserControl>
