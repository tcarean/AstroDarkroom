<!-- AboutWindow - the icon, the version, the copyright, the GPLv3 notice and the third-party
     components.

     Modal, centred on the parent window, without a maximise button: it is not a work screen,
     it is a notice to read and close. Esc closes it through IsCancel. No figure and no
     sentence is written here - everything comes through AboutViewModel, so that the text is
     the same as what the console prints in its help. -->

<Window x:Class="FlatCheck.Wpf.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf"
        Title="{Binding Title}"
        Icon="/FlatCheck.Wpf;component/Icon/flatcheck.ico"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display"
        Hyperlink.RequestNavigate="OpenLink">

  <StackPanel Margin="24,20,24,20">

    <!-- ============================================================ header -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Image x:Name="Logo" Grid.Column="0" Width="72" Height="72"
             VerticalAlignment="Top" Margin="0,2,20,0"
             RenderOptions.BitmapScalingMode="HighQuality" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="FlatCheck" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{Binding Tagline}" />
        <TextBlock Margin="0,10,0,0" Text="{Binding Banner}" FontFamily="{StaticResource MonoFont}" />
        <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Copyright}" />
      </StackPanel>
    </Grid>

    <!-- ============================================================ licence -->
    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource Heading}" Text="{Binding LicenceHeading}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{Binding Warranty}" />
        <TextBlock Margin="0,10,0,0">
          <Hyperlink NavigateUri="{Binding LicenseUrl}">
            <Run Text="{Binding LicenseLinkLabel, Mode=OneWay}" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- ============================================================ third-party components -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource Heading}" Text="{Binding ThirdPartyHeading}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,12" Text="{Binding ThirdPartyLead}" />
        <ItemsControl ItemsSource="{Binding Components}"
                      ItemTemplate="{StaticResource ComponentRowTemplate}" />
      </StackPanel>
    </Border>

    <!-- ============================================================ closing -->
    <Button Content="{l:T En='Close', Ro='Inchide'}" IsCancel="True" IsDefault="True" Click="Close"
            HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="96" />
  </StackPanel>
</Window>
