<!-- HistEqView - tabul "Histogram".

     Lista la stanga: masterul din process/ pe prima pozitie, marcat, apoi cadrele din
     flats/. Poza la dreapta, cu comutatorul de vederi deasupra.

     Ecranul de asteptare sta in coloana din DREAPTA, nu peste tot tabul: lista ramane
     apasabila cat timp se calculeaza, si un click pe alt fisier porneste alta rulare
     peste cea curenta (vezi HistEqTabViewModel). -->

<UserControl x:Class="FlatCheck.Wpf.HistEqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlatCheck.Wpf">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" MinWidth="220" />
      <ColumnDefinition Width="*" MinWidth="380" />
    </Grid.ColumnDefinitions>

    <!-- ============================================================ lista -->
    <Border Grid.Column="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,16,16,16">

        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,8" Text="MASTERUL SI FLAT-URILE" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,0,0,10"
                     Text="Masterul e stiva cadrelor de sub el: compara-l cu ele ca sa vezi ce s-a mediat si ce a ramas." />
        </StackPanel>

        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- Masterul se desparte de cadre printr-o linie sub el si un chip, nu
                   printr-o a doua lista: e acelasi fel de alegere, cu alt inteles. -->
              <Border x:Name="row" BorderBrush="{StaticResource BorderBr}" BorderThickness="0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource AccentBr}" CornerRadius="3"
                            Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsMaster, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding Tag}" Foreground="#16161A"
                                 FontSize="10" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Where}" />
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMaster}" Value="True">
                  <Setter TargetName="row" Property="BorderThickness" Value="0,0,0,1" />
                  <Setter TargetName="row" Property="Padding" Value="0,0,0,8" />
                  <Setter TargetName="row" Property="Margin" Value="0,0,0,4" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============================================================ poza -->
    <Grid Grid.Column="1">
      <local:MessagePanel Margin="20" />

      <!-- starea de dinainte de prima alegere -->
      <TextBlock MaxWidth="420" Margin="24"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Text="Alege masterul sau un flat din lista ca sa-l vad egalizat.">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasResult}" Value="False" />
                  <Condition Binding="{Binding HasError}" Value="False" />
                  <Condition Binding="{Binding IsBusy}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
        <StackPanel>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <!-- Vederile. GroupName UNIC in fereastra, ca la celelalte grupuri de
                   radio: WPF grupeaza dupa nume peste tot. Ascuns cand e un singur chip. -->
              <ItemsControl ItemsSource="{Binding View.Options}" Margin="0,0,0,12"
                            Visibility="{Binding View.IsVisible, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton GroupName="HistEqView" Margin="0,0,18,0"
                                 Content="{Binding Label}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- HighQuality: zgomotul egalizat face aliasing urat cu scalarea implicita. -->
              <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="4">
                <Image Source="{Binding Image, Converter={StaticResource PngToImage}}"
                       Stretch="Uniform" StretchDirection="Both"
                       RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>

              <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" Text="{Binding Caption}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding Caveat}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding MasterNote}"
                         Visibility="{Binding MasterNote, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
          </Border>

          <local:HistEqGuidePanel Margin="0,10,0,0" />

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="CADRUL SI CANALELE" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Muted}" Text="{Binding Frame}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                         FontFamily="{StaticResource MonoFont}" Text="{Binding Channels}" />
            </StackPanel>
          </Border>

          <local:ReportPanel Margin="0,16,0,0" />

        </StackPanel>
      </ScrollViewer>

      <!-- Ultimul copil al coloanei din dreapta, deci acopera poza si nu lista. -->
      <local:BusyOverlay />
    </Grid>
  </Grid>
</UserControl>
