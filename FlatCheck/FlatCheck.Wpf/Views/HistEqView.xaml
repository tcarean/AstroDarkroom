<!-- HistEqView - the "Histogram" tab.

     The list on the left: the master from masters/ or process/ in the first position, marked,
     then the frames from flats/. The picture on the right, with the view switch above it.

     The waiting screen sits in the RIGHT column, not over the whole tab: the list stays
     clickable while it computes, and a click on another file starts another run over the
     current one (see HistEqTabViewModel). -->

<UserControl x:Class="FlatCheck.Wpf.HistEqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FlatCheck.Wpf"
             xmlns:local="clr-namespace:FlatCheck.Wpf">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" MinWidth="220" />
      <ColumnDefinition Width="*" MinWidth="380" />
    </Grid.ColumnDefinitions>

    <!-- ============================================================ list -->
    <Border Grid.Column="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,16,16,16">

        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,8" Text="{l:T En='THE MASTER AND THE FLATS', Ro='MASTERUL SI FLAT-URILE'}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,0,0,10"
                     Text="{l:T En='The master is the stack of the frames under it: compare it with them to see what was averaged out and what stayed.', Ro='Masterul e stiva cadrelor de sub el: compara-l cu ele ca sa vezi ce s-a mediat si ce a ramas.'}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- The master is set apart from the frames by a line under it and a chip, not by a
                   second list: it is the same kind of choice, with another meaning. -->
              <Border x:Name="row" BorderBrush="{StaticResource BorderBr}" BorderThickness="0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border x:Name="chip" Background="{StaticResource AccentBr}" CornerRadius="3"
                            Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding Tag}" Foreground="#16161A"
                                 FontSize="10" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Where}" />
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMaster}" Value="True">
                  <Setter TargetName="row" Property="BorderThickness" Value="0,0,0,1" />
                  <Setter TargetName="row" Property="Padding" Value="0,0,0,8" />
                  <Setter TargetName="row" Property="Margin" Value="0,0,0,4" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============================================================ picture -->
    <Grid Grid.Column="1">
      <local:MessagePanel Margin="20" />

      <!-- the state before the first choice -->
      <TextBlock MaxWidth="420" Margin="24"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Text="{l:T En='Choose the master or a flat from the list to see it equalised.', Ro='Alege masterul sau un flat din lista ca sa-l vad egalizat.'}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasResult}" Value="False" />
                  <Condition Binding="{Binding HasError}" Value="False" />
                  <Condition Binding="{Binding IsBusy}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
        <StackPanel>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The views. A UNIQUE GroupName in the window, as for the other radio groups:
                     WPF groups by name everywhere. Hidden when there is a single chip. Then the
                     false-colours chip, Siril's color-map toggle: disabled on the RGB view, where
                     the table does not apply (ADR 0063). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ItemsControl ItemsSource="{Binding View.Options}" VerticalAlignment="Center"
                                Visibility="{Binding View.IsVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton GroupName="HistEqView" Margin="0,0,18,0"
                                     Content="{Binding Label}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <CheckBox Margin="6,0,0,0" VerticalAlignment="Center"
                            Content="{l:T En='False colours', Ro='Culori false'}"
                            IsChecked="{Binding View.Rainbow, Mode=TwoWay}"
                            IsEnabled="{Binding View.RainbowAvailable}" />
                </StackPanel>

                <!-- The zoom: the state is in the view-model, the panning in the control. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center"
                             Margin="0,0,10,0" Text="{Binding Zoom.Label}" />
                  <Button Content="&#x2212;" Padding="9,2" Margin="0,0,4,0" Command="{Binding Zoom.ZoomOut}" />
                  <Button Content="+" Padding="9,2" Margin="0,0,4,0" Command="{Binding Zoom.ZoomIn}" />
                  <Button Content="{l:T En='fit', Ro='potrivit'}" Padding="9,2" Margin="0,0,4,0" Command="{Binding Zoom.Fit}" />
                  <Button Content="100 %" Padding="9,2" Command="{Binding Zoom.Actual}" />
                </StackPanel>
              </Grid>

              <!-- The full-resolution raster, in a fixed viewport: smaller than before, but with
                   zoom and panning down to the sensor pixel. -->
              <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="4">
                <local:ZoomableImage Height="520"
                                     Source="{Binding Image}"
                                     IsFit="{Binding Zoom.IsFit, Mode=TwoWay}"
                                     Zoom="{Binding Zoom.Zoom, Mode=TwoWay}"
                                     EffectiveZoom="{Binding Zoom.EffectiveZoom, Mode=TwoWay}" />
              </Border>

              <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" Text="{Binding Caption}" />
              <!-- The legend of the false colours, from the core, only while the chip is on. -->
              <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" Text="{Binding Legend}"
                         Visibility="{Binding Legend, Converter={StaticResource NotNullToVis}}" />
              <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0"
                         Text="{l:T En='Wheel = zoom around the cursor, drag with the mouse = pan, double click = fit / 100 %. At 100 % one screen pixel is one sensor pixel; on Mosaic the mosaic\'s checkerboard shows, as in Siril.', Ro='Rotita = zoom in jurul cursorului, trage cu mouse-ul = deplasare, dublu click = potrivit / 100 %. La 100 % un pixel de pe ecran e un pixel de senzor; pe Mozaic se vede tabla de sah a mozaicului, ca in Siril.'}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding Caveat}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding MasterNote}"
                         Visibility="{Binding MasterNote, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
          </Border>

          <local:HistEqGuidePanel Margin="0,10,0,0" />

          <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="{l:T En='THE FRAME AND THE CHANNELS', Ro='CADRUL SI CANALELE'}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Muted}" Text="{Binding Frame}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                         FontFamily="{StaticResource MonoFont}" Text="{Binding Channels}" />
            </StackPanel>
          </Border>

          <local:ReportPanel Margin="0,16,0,0" />

        </StackPanel>
      </ScrollViewer>

      <!-- The last child of the right column, so it covers the picture and not the list. -->
      <local:BusyOverlay />
    </Grid>
  </Grid>
</UserControl>
