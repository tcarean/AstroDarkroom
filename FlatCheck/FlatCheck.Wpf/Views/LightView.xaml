<!-- LightView - tabul 3, testul end-to-end pe serie.

     Refuzul gardei de camp (INAPLICABIL) se afiseaza in acelasi loc ca un verdict, cu
     pastila neutra, si NU ca eroare. E un raspuns: unealta a stabilit ca pe datele astea
     intrebarea nu are raspuns masurabil. Sa arate ca un esec l-ar invata pe om ca
     aplicatia e stricata, cand tocmai l-a scutit de o concluzie falsa. -->

<UserControl x:Class="FlatCheck.Wpf.LightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlatCheck.Wpf">

  <Grid>
    <local:MessagePanel Margin="20" />

    <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="430" />
        <ColumnDefinition Width="2*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- ========================================================== sinteza -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20,18,10,18">
        <StackPanel>

          <TextBlock Style="{StaticResource Faint}" Text="{Binding Source}"
                     TextTrimming="CharacterEllipsis" />

          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="VERDICT" Style="{StaticResource Heading}" Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                <Border Background="{Binding Verdict, Converter={StaticResource VerdictToBrush}}"
                        CornerRadius="4" Padding="12,4">
                  <TextBlock Text="{Binding Verdict}" Foreground="#16161A"
                             FontSize="16" FontWeight="Bold" />
                </Border>
              </StackPanel>

              <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                         Text="{Binding Diagnosis}"
                         Visibility="{Binding Diagnosis, Converter={StaticResource NotNullToVis}}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                         Text="{Binding Reasons}"
                         Visibility="{Binding Reasons, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
          </Border>

          <!-- campul acoperit: la refuz e chiar motivul, deci se arata mereu -->
          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="camp acoperit" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Field}" />
              </Grid>
              <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" Foreground="#E3B341"
                         Text="{Binding FieldWarning}"
                         Visibility="{Binding FieldWarning, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
          </Border>

          <StackPanel Visibility="{Binding HasNumbers, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Heading}" Margin="2,22,0,8" Text="SINTEZA PE SERIE" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="componenta radiala, medie" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Number}" FontWeight="SemiBold"
                             Text="{Binding MeanRadial}" />
                </Grid>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="imprastiere (min .. max)" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Spread}" />
                </Grid>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="eroarea mediei" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Sem}" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="corelatie cu gradientul de cer" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Correlation}" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Faint}" Margin="2,10,0,0"
                       Text="Flat-ul e acelasi pe toate cadrele prin constructie - s-a impartit din fiecare. Deci tot ce se misca in timpul seriei e cer, nu flat, si de asta seria spune mai mult decat un cadru singur." />
          </StackPanel>

          <local:ReportPanel Margin="0,16,0,0" />

        </StackPanel>
      </ScrollViewer>

      <!-- ========================================================== cadrele -->
      <Grid Grid.Column="1" Margin="10,18,20,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="CADRE" />

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="86" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Faint}" Text="cadru" />
              <TextBlock Grid.Column="1" Style="{StaticResource Faint}" HorizontalAlignment="Right"
                         Text="radial" />
              <TextBlock Grid.Column="2" Style="{StaticResource Faint}" HorizontalAlignment="Right"
                         Text="cer" />
              <TextBlock Grid.Column="3" Style="{StaticResource Faint}" HorizontalAlignment="Right"
                         Text="tile-uri" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Frames}"
                            ItemTemplate="{StaticResource SeriesRowTemplate}" />
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0,12,0,0"
                Visibility="{Binding HasNumbers, Converter={StaticResource BoolToVis}}">
          <Image Source="{Binding Map, Converter={StaticResource PngToImage}}"
                 Stretch="Uniform" MaxHeight="220"
                 RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
      </Grid>
    </Grid>

    <local:BusyOverlay />
  </Grid>
</UserControl>
