<!-- MainWindow - the bar with the folder, then the five tabs.

     When the folder is not good, the tabs are not shown at all and the explanation appears in
     their place. It is deliberate: five empty panels would make the user open them one by one
     to understand that in fact a script has to be run in Siril.

     The window starts maximised: the map and the histograms are read at the screen's size.
     Height/Width remain the size it returns to after "Restaurare". -->

<Window x:Class="FlatCheck.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlatCheck.Wpf"
        Title="FlatCheck" Height="820" Width="1360" WindowState="Maximized"
        Icon="/FlatCheck.Wpf;component/Icon/flatcheck.ico"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <!-- "Despre" goes through ApplicationCommands.Help, whose default gesture is F1: the button
       and the key reach the same handler without a command on the view-model - which may not
       open windows, so as to stay testable. -->
  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="ShowAbout" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================================================ top bar -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1"
            Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Faint}" Text="FOLDER SESIUNE SIRIL" />
          <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                     Text="{Binding Folder}"
                     Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="(niciunul ales)"
                     Visibility="{Binding HasFolder, Converter={StaticResource NotBoolToVis}}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- locked while it runs: changing the folder in the middle would cancel the work
               started, and it is less confusing not to be able to than to lose it. -->
          <Button Content="Alege folder..." Click="ChooseFolder"
                  IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" />

          <!-- rightmost, at the edge of the bar; it stays active during the analysis too, because
               it touches nothing of what runs -->
          <Button Content="Despre" Command="Help" ToolTip="Versiune, licenta, componente (F1)"
                  Margin="10,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ content -->
    <Grid Grid.Row="1">

      <!-- no folder yet -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                  Margin="24">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasFolder}" Value="False" />
                  <Condition Binding="{Binding HasProblem}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <TextBlock Text="Alege folderul unei sesiuni" FontSize="17" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                   Text="Folderul de lucru din Siril, cel care contine subfolderele flats/, darks/, biases/, lights/ si process/ sau masters/. Analiza structurii si testul end-to-end pornesc singure imediat ce l-ai ales." />
        <Button Content="Alege folder..." Margin="0,22,0,0" HorizontalAlignment="Center"
                Click="ChooseFolder" />
      </StackPanel>

      <!-- folder chosen, but nothing can start on it -->
      <Border MaxWidth="620" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource Card}" BorderBrush="#5A3A3A" Background="#2A2224"
              Margin="24"
              Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="{Binding ProblemTitle}" FontSize="15" FontWeight="SemiBold"
                     Foreground="#F0857E" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding ProblemText}" />

          <!-- running the script from here; only when the problem is one that a script solves. The
               choice of the script is on the card, not in the run window - see
               PreprocessViewModel. -->
          <Border Style="{StaticResource Card}" Margin="0,16,0,0" DataContext="{Binding Preprocess}"
                  Visibility="{Binding IsOffered, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="RULEAZA SCRIPTUL DE AICI" />
              <TextBlock Style="{StaticResource Muted}" Text="{Binding Lead}" />

              <TextBlock Margin="0,10,0,0" Foreground="#F0C674" TextWrapping="Wrap"
                         Text="{Binding Warning}"
                         Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
              <TextBlock Margin="0,10,0,0" Foreground="#F0857E" TextWrapping="Wrap"
                         Text="{Binding Blocker}"
                         Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVis}}" />

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding Scripts}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          DisplayMemberPath="Name" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Ruleaza in Siril" Margin="10,0,0,0"
                        IsEnabled="{Binding CanRun}" Click="RunPreprocessing" />
              </Grid>
            </StackPanel>
          </Border>

          <Button Content="Alege alt folder..." Margin="0,20,0,0" HorizontalAlignment="Left"
                  Click="ChooseFolder" />
        </StackPanel>
      </Border>

      <!-- the five tabs -->
      <TabControl>
        <TabControl.Style>
          <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasFolder}" Value="True" />
                  <Condition Binding="{Binding HasProblem}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TabControl.Style>

        <TabItem Header="Structura">
          <local:StructureView DataContext="{Binding Structure}" />
        </TabItem>
        <TabItem Header="Ratio">
          <local:RatioView DataContext="{Binding Ratio}" />
        </TabItem>
        <TabItem Header="End to end">
          <local:LightView DataContext="{Binding Light}" />
        </TabItem>
        <TabItem Header="Expunere">
          <local:ExposureView DataContext="{Binding Exposure}" />
        </TabItem>
        <TabItem Header="Histogram">
          <local:HistEqView DataContext="{Binding HistEq}" />
        </TabItem>
        <TabItem Header="Netezire">
          <local:SmoothView DataContext="{Binding Smooth}" />
        </TabItem>
        <TabItem Header="Sintetic">
          <local:SyntheticView DataContext="{Binding Synthetic}" />
        </TabItem>
        <TabItem Header="Split">
          <local:SplitView DataContext="{Binding Split}" />
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
