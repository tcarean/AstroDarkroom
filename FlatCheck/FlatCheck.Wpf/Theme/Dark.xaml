<!-- Dark.xaml - the palette and the default styles.

     Why a dark theme: the tool is used at night, beside the mount, and a white window in the
     dark spoils the eye's adaptation for a quarter of an hour. The verdict colours are NOT
     defined here but in VerdictPalette.cs, because they are derived from Stats.Severity - a
     list of colours in XAML would have been a second definition of the verdicts' order. -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FlatCheck.Wpf">

  <!-- The converters sit HERE, not in App.xaml, so that the templates below can see them: a
       StaticResource of a dictionary is resolved in its own dictionary, not in the one that
       imports it. -->

  <local:PngBytesToImageConverter x:Key="PngToImage" />
  <local:BoolToVisibilityConverter x:Key="BoolToVis" />
  <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
  <local:InverseBoolConverter x:Key="Not" />
  <local:NotNullToVisibilityConverter x:Key="NotNullToVis" />
  <local:VerdictToBrushConverter x:Key="VerdictToBrush" />

  <!-- ============================================================ palette -->

  <SolidColorBrush x:Key="WindowBg"  Color="#1B1B1D" />
  <SolidColorBrush x:Key="PanelBg"   Color="#232326" />
  <SolidColorBrush x:Key="PanelBg2"  Color="#2B2B2F" />
  <SolidColorBrush x:Key="HoverBg"   Color="#33333A" />
  <SolidColorBrush x:Key="BorderBr"  Color="#3A3A40" />
  <SolidColorBrush x:Key="TextBr"    Color="#E4E4E7" />
  <SolidColorBrush x:Key="MutedBr"   Color="#9A9AA3" />
  <SolidColorBrush x:Key="FaintBr"   Color="#6E6E77" />
  <SolidColorBrush x:Key="AccentBr"  Color="#4EA8DE" />
  <SolidColorBrush x:Key="BadBr"     Color="#F85149" />

  <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>

  <!-- ============================================================ text -->

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- The tooltips: WPF draws them light, and the application's text is light, so they came
       out white on white (found on the sensor chips of the Sintetic tab). Background and border
       from the palette, normal text, a maximum width so that it breaks into lines. -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" MaxWidth="360">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="Foreground" Value="{StaticResource TextBr}" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="Foreground" Value="{StaticResource FaintBr}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- The links in "Despre". By default WPF makes them dark blue on a black background, that
       is unreadable; the theme's accent, underlined only when the mouse passes over. -->
  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource AccentBr}" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource AccentBr}" />
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The figures line up in a column only with a monospaced font. -->
  <Style x:Key="Number" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <!-- ============================================================ panels -->

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <!-- The text fields of the Sintetic tab (the search, the focal length, the aperture, the
       crop): a keyed style, like LogBox, because the TextBox is not a usual control of the
       application. -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBr}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBr}" />
  </Style>

  <!-- The log of the Siril run window: mono text, read-only, on the window's background. The
       only TextBox in the application, so a keyed style, not a default one. -->
  <Style x:Key="LogBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource WindowBg}" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBr}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBr}" />
  </Style>

  <!-- ============================================================ buttons -->

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ tabs -->

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{StaticResource WindowBg}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource WindowBg}"
                    BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True" Margin="12,6,12,0" />
            </Border>
            <ContentPresenter ContentSource="SelectedContent" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource MutedBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="bd" Background="Transparent" Padding="16,8"
                  BorderBrush="Transparent" BorderThickness="0,0,0,2">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextBr}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextBr}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ lists -->

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="10,6"
                  BorderBrush="Transparent" BorderThickness="3,0,0,0">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBg2}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ combo -->

  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="{StaticResource PanelBg2}"
                  BorderBrush="{StaticResource BorderBr}" BorderThickness="1" CornerRadius="4">
            <Path x:Name="ar" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{StaticResource MutedBr}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <TextBlock x:Name="ph" Margin="10,0,26,0" VerticalAlignment="Center"
                       Foreground="{StaticResource FaintBr}" Text="(nimic selectat)"
                       Visibility="Collapsed" IsHitTestVisible="False" />
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
              <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBr}"
                      BorderThickness="1" CornerRadius="4"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                <ScrollViewer>
                  <StackPanel IsItemsHost="True" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedItem" Value="{x:Null}">
              <Setter TargetName="ph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="10,6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ checkbox -->

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <!-- A Grid, not a horizontal StackPanel: there the content gets an infinite width when
               measured, so a long label would never break into two lines - it would be cut. The
               second column is "*", so the text knows how much room it has. -->
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="box" Width="17" Height="17" CornerRadius="3"
                    Background="{StaticResource PanelBg2}"
                    BorderBrush="{StaticResource BorderBr}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Path x:Name="tick" Stretch="Uniform" Margin="3"
                    Data="M 0 5 L 4 9 L 11 0" Stroke="#1B1B1D" StrokeThickness="2.2"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBr}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBr}" />
              <Setter TargetName="tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ progress -->

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{StaticResource AccentBr}" />
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
            <Grid>
              <Rectangle x:Name="PART_Track" />
              <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                         Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ scrollbar -->

  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="#4A4A52" CornerRadius="4" Margin="3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ row templates -->

  <!-- The verdict pill. The colour comes through VerdictToBrush, which derives it from
       Stats.Severity - so a new verdict from the core is coloured right without touching the
       XAML. The text is dark because the background is always saturated. -->
  <DataTemplate x:Key="VerdictChip">
    <Border Background="{Binding Converter={StaticResource VerdictToBrush}}"
            CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
      <TextBlock Text="{Binding}" Foreground="#16161A" FontSize="11" FontWeight="SemiBold" />
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="MetricRowTemplate">
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" MinWidth="96" />
        <ColumnDefinition Width="Auto" MinWidth="104" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Value}"
                 VerticalAlignment="Center" Margin="12,0,0,0" />

      <ContentControl Grid.Column="2" Margin="14,0,0,0" HorizontalAlignment="Left"
                      Content="{Binding Verdict}"
                      ContentTemplate="{StaticResource VerdictChip}"
                      Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}" />

      <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Faint}"
                 Margin="0,3,0,0" Text="{Binding Note}"
                 Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />

      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsKey}" Value="True">
              <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="ScaleRowTemplate">
    <Border CornerRadius="4" Padding="9,6" Margin="0,0,0,3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="102" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ContentControl Grid.Column="0" Content="{Binding Band}"
                        ContentTemplate="{StaticResource VerdictChip}"
                        HorizontalAlignment="Left" />
        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding Range}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding Meaning}"
                   VerticalAlignment="Center" />
      </Grid>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="Transparent" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
              <Setter Property="Background" Value="#2F2F35" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
    </Border>
  </DataTemplate>

  <!-- The fold button: a chevron plus the label from Content. It appeared written by hand a
       third time (the text report, the map guide, how to read the tab), so it sits here once. -->
  <Style x:Key="Disclosure" TargetType="ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="chev" Text="&#x25B8;" Foreground="{StaticResource MutedBr}"
                       VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBlock Text="{TemplateBinding Content}"
                       Foreground="{StaticResource MutedBr}" FontSize="12" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="chev" Property="Text" Value="&#x25BE;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chev" Property="Foreground" Value="{StaticResource AccentBr}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A row of the map guide: the name of the shape, then what it meant. The name first and
       bold, so that the list can be scanned for the shape seen on the screen. -->
  <DataTemplate x:Key="GuideRowTemplate">
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="{Binding Shape}" Foreground="{StaticResource TextBr}"
                 FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0"
                 Text="{Binding Meaning}" TextWrapping="Wrap" />
    </StackPanel>
  </DataTemplate>

  <!-- A third-party component in "Despre": the name and the role on the first line, the licence
       and the copyright under it, the link to the project last. The licence is what the LGPL
       asks to show, so it sits on its own line, not in a tooltip. The link has no handler here
       - a resource dictionary has no code-behind - the window catches it, through the routed
       event Hyperlink.RequestNavigate. -->
  <DataTemplate x:Key="ComponentRowTemplate">
    <StackPanel Margin="0,0,0,10">
      <TextBlock TextWrapping="Wrap">
        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
        <Run Text=" - " Foreground="{StaticResource FaintBr}" />
        <Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource MutedBr}" FontSize="12" />
      </TextBlock>
      <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Licence}" />
      <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" />
      <TextBlock Margin="0,2,0,0" FontSize="11">
        <Hyperlink NavigateUri="{Binding Url}">
          <Run Text="{Binding Url, Mode=OneWay}" />
        </Hyperlink>
      </TextBlock>
    </StackPanel>
  </DataTemplate>

  <!-- A channel on the histogram card: the identity on the left, the drawing on the right.

       The thresholds are bound LOCALLY (BandLo, BandHi, ...), from the row itself, not through
       a RelativeSource to the tab: bindings through ancestors compile and look fine until the
       template lands somewhere else in the tree, and then they break silently. The row carries
       them copied precisely so that nothing like that is needed. -->
  <DataTemplate x:Key="ChannelHistogramRowTemplate">
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="124" />
        <ColumnDefinition Width="*" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <Border x:Name="chip" Background="{Binding Colour}" CornerRadius="4"
                Padding="9,2" HorizontalAlignment="Left"
                BorderBrush="Transparent" BorderThickness="1.5">
          <TextBlock Text="{Binding Label}" Foreground="#16161A"
                     FontSize="12" FontWeight="Bold" />
        </Border>
        <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0"
                   Text="{Binding Position}"
                   Visibility="{Binding HasPosition, Converter={StaticResource BoolToVis}}" />
        <TextBlock Style="{StaticResource Number}" HorizontalAlignment="Left"
                   Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Centre}" />
        <TextBlock Style="{StaticResource Faint}" Text="centru 20 %" />
        <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" Text="{Binding Median}" />
        <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" Text="{Binding Note}"
                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
      </StackPanel>

      <Border Grid.Column="1" Background="{StaticResource PanelBg2}" CornerRadius="4"
              Padding="6,4">
        <local:HistogramCanvas Height="96"
                               Whole="{Binding Whole}" Centre="{Binding CentreCurve}"
                               Fill="{Binding Colour}" Marker="{Binding Marker}"
                               BandLo="{Binding BandLo}" BandHi="{Binding BandHi}"
                               TooLow="{Binding TooLow}" TooHigh="{Binding TooHigh}"
                               BandLabel="{Binding BandLabel}" />
      </Border>
    </Grid>

    <DataTemplate.Triggers>
      <!-- The channel that decides is set off with an outline, not with one more colour: the
           colours here identify a channel, they do not judge. -->
      <DataTrigger Binding="{Binding IsBrightest}" Value="True">
        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource TextBr}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- A row of the raw / screen table: the channel's pill, the figure from the sensor, the
       arrow, the figure on the screen, the difference. The same columns on every row, in a
       monospaced font, so that it can be read vertically. -->
  <DataTemplate x:Key="ScreenPairRowTemplate">
    <Grid Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="140" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="30" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="110" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Border Background="{Binding Colour}" CornerRadius="3" Width="10" Height="10"
                Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Channel}" FontSize="12" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="1" Style="{StaticResource Number}" FontSize="12"
                 FontWeight="SemiBold" Text="{Binding Raw}" />
      <TextBlock Grid.Column="2" Style="{StaticResource Number}" FontSize="12"
                 HorizontalAlignment="Center" Foreground="{StaticResource FaintBr}" Text="&#x2192;" />
      <TextBlock Grid.Column="3" Style="{StaticResource Number}" FontSize="12"
                 Text="{Binding Screen}" />
      <TextBlock Grid.Column="4" Style="{StaticResource Number}" FontSize="12"
                 Foreground="{StaticResource FaintBr}" Text="{Binding Gap}" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="SeriesRowTemplate">
    <Grid Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="180" />
        <ColumnDefinition Width="96" />
        <ColumnDefinition Width="96" />
        <ColumnDefinition Width="86" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                 FontFamily="{StaticResource MonoFont}" FontSize="12" />
      <TextBlock Grid.Column="1" Style="{StaticResource Number}" FontSize="12"
                 Text="{Binding Radial}" />
      <TextBlock Grid.Column="2" Style="{StaticResource Number}" FontSize="12"
                 Foreground="{StaticResource MutedBr}" Text="{Binding Sky}" />
      <TextBlock Grid.Column="3" Style="{StaticResource Number}" FontSize="12"
                 Foreground="{StaticResource FaintBr}" Text="{Binding Tiles}" />
    </Grid>
  </DataTemplate>

</ResourceDictionary>
