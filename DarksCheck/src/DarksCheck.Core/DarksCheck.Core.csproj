<Project Sdk="Microsoft.NET.Sdk">
  <!-- The core: everything that computes and everything that formats. No Console, no UI, no
       entry point: a compile boundary. Both applications call Runs/ only (the kit's ADR 0002).
       The version and the copyright come from Directory.Build.props, the same in every assembly. -->
  <PropertyGroup>
    <RootNamespace>DarksCheck.Core</RootNamespace>
    <!-- Numbers are formatted and parsed with the invariant culture whatever the Windows
         culture: "0.24", never "0,24" on a Romanian Windows. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Sdcb.LibRaw, only for camera raw files: no pure managed .NET library decodes the Bayer
       mosaic of a NEF. The native DLLs of the runtime.* packages sit beside the executable and
       are loaded lazily, from RawReader.cs alone; without them a FITS run is unaffected and a
       raw run says what is missing (ADR 0003, THIRD-PARTY-NOTICES.md). -->
  <!-- NLog, for the diagnostic log only (ADR 0025): the core logs at its seams (the two readers
       adapted from LightsCheck, Session/, Runs/, the two decoding loops of Analysis/), never in
       the rest of Analysis/, in Report/ or in the other copies of Imaging/; the two applications
       configure it, in code, through Logging/LogSetup.cs. Without a configuration (a library
       use) every call is a no-op; the test assemblies configure a capture at Trace
       (LogCapture). NLog.Targets.AtomicFile is its file target with the operating system's
       atomic append, so two windows writing one log lose no line (R-103). -->
  <ItemGroup>
    <PackageReference Include="Sdcb.LibRaw" />
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" />
    <PackageReference Include="Sdcb.LibRaw.runtime.linux64" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Targets.AtomicFile" />
  </ItemGroup>

  <!-- The core stays internal: its consumers are in this repository and compile with it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="darkscheck" />
    <InternalsVisibleTo Include="DarksCheck.Tests" />
    <InternalsVisibleTo Include="DarksCheck.Wpf" />
    <InternalsVisibleTo Include="DarksCheck.Wpf.Tests" />
  </ItemGroup>
</Project>
