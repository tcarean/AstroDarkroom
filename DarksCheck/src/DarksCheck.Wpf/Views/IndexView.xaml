<!-- IndexView: the label with its copy button, the INDEX rows of the report, and the partner
     folder to match against (chosen here, remembered between runs, applied on the next run). -->

<UserControl x:Class="DarksCheck.Wpf.IndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DarksCheck.Wpf"
             xmlns:local="clr-namespace:DarksCheck.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
    <StackPanel MaxWidth="1200" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{l:T En='LABEL', Ro='ETICHETA'}" />
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="22" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
            <Button Grid.Column="1" Content="{l:T En='Copy label', Ro='Copiaza eticheta'}" Margin="16,0,0,0" VerticalAlignment="Center" Click="CopyLabel"
                    ToolTip="{l:T En='Puts the label in the clipboard, for you to rename the folder with it; the program renames nothing', Ro='Pune eticheta in clipboard, ca sa redenumesti folderul cu ea; programul nu redenumeste nimic'}" />
          </Grid>
          <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding IndexLead}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="INDEX" />
          <ItemsControl ItemsSource="{Binding IndexRows}" ItemTemplate="{StaticResource ReportRow}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{l:T En='PARTNER', Ro='PARTENER'}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap"
                     Text="{l:T En='The partner is another folder of darks: a library or another session. The program compares the darks of the session with the master of the partner, on the pixels hot in both, and says by how many degrees the darks of the session are warmer or colder than it. The lights are compared with the partner through the darks of the session. If the session has no darks, those of the partner are used. The program remembers the partner you chose after you close it, and uses it in the next analysis.', Ro='Partenerul e alt folder de dark-uri: o biblioteca sau alta sesiune. Programul compara dark-urile sesiunii cu masterul partenerului, pe pixelii fierbinti in amandoua, si spune cu cate grade sunt dark-urile sesiunii mai calde sau mai reci decat el. Lights-urile se compara cu partenerul prin dark-urile sesiunii. Daca sesiunea nu are dark-uri, se folosesc cele ale partenerului. Programul tine minte partenerul ales si dupa ce il inchizi, si il foloseste la urmatoarea analiza.'}" />
          <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding PartnerText}" ToolTip="{Binding PartnerText}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsIdle}">
            <Button Content="{l:T En='Choose partner...', Ro='Alege partener...'}" Click="ChoosePartner" />
            <Button Content="{l:T En='No partner', Ro='Fara partener'}" Click="ClearPartner" Margin="10,0,0,0" IsEnabled="{Binding HasPartner}" />
            <Button Content="{l:T En='Analyse again', Ro='Analizeaza din nou'}" Click="Rerun" Margin="10,0,0,0" IsEnabled="{Binding HasFolder}"
                    ToolTip="{l:T En='Analyses the open folder again, with the current partner and settings', Ro='Analizeaza din nou folderul deschis, cu partenerul si setarile de acum'}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
