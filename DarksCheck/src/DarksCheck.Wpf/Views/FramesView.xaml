<!-- FramesView: the darks table, one row per frame with the console's cells (TABEL PE CADRE),
     and the three per-frame charts beside it: the hot pixels against the master (the warming of
     the series), how much each frame differs from the master and the random banding. -->

<UserControl x:Class="DarksCheck.Wpf.FramesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DarksCheck.Wpf"
             xmlns:local="clr-namespace:DarksCheck.Wpf">
  <UserControl.Resources>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="LeftCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Faint}">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="LeftHead" TargetType="TextBlock" BasedOn="{StaticResource Head}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- the attention colour of VerdictPalette.Warn, for a frame off the plateau (R-071) -->
    <SolidColorBrush x:Key="WarnBr" Color="#E3B341" />
    <SolidColorBrush x:Key="WarnBg" Color="#26E3B341" />
    <Style x:Key="FrameRowGrid" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Off}" Value="True">
          <Setter Property="Background" Value="{StaticResource WarnBg}" />
          <Setter Property="ToolTip" Value="{Binding Note}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PlateauCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Off}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource WarnBr}" />
          <Setter Property="FontWeight" Value="Bold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="FrameRow">
      <Grid Style="{StaticResource FrameRowGrid}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Index}" />
        <TextBlock Grid.Column="1" Style="{StaticResource LeftCell}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
        <TextBlock Grid.Column="2" Style="{StaticResource LeftCell}" Text="{Binding Time}" />
        <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Mean}" />
        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Sigma}" />
        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding Residual}" />
        <TextBlock Grid.Column="6" Style="{StaticResource Cell}" Text="{Binding Bands}" />
        <TextBlock Grid.Column="7" Style="{StaticResource Cell}" Text="{Binding Amp}" />
        <TextBlock Grid.Column="8" Style="{StaticResource PlateauCell}" Text="{Binding Plateau}" />
        <TextBlock Grid.Column="9" Style="{StaticResource Cell}" Text="{Binding Light}" />
        <TextBlock Grid.Column="10" Style="{StaticResource Cell}" Text="{Binding Side}" />
        <TextBlock Grid.Column="11" Style="{StaticResource Cell}" Text="{Binding Above}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="12" Style="{StaticResource LeftCell}" Foreground="{StaticResource WarnBr}" TextWrapping="Wrap" Text="{Binding Note}"
                   Visibility="{Binding Note, Converter={StaticResource NotNullToVis}}" />
        <TextBlock Grid.Column="12" Style="{StaticResource LeftCell}" Foreground="{StaticResource MutedBr}" TextTrimming="CharacterEllipsis" Text="{Binding Skipped}" ToolTip="{Binding Skipped}"
                   Visibility="{Binding Skipped, Converter={StaticResource NotNullToVis}}" />
        <TextBlock Grid.Column="12" Style="{StaticResource LeftCell}" Foreground="{StaticResource BadBr}" TextTrimming="CharacterEllipsis" Text="{Binding Error}" ToolTip="{Binding Error}"
                   Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="20,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" MinWidth="620" />
      <ColumnDefinition Width="2*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="{l:T En='FRAMES TABLE', Ro='TABEL PE CADRE'}" />
        <Grid Grid.Row="1" Margin="4,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Head}" Text="{l:T En='no.', Ro='nr'}" ToolTip="{l:T En='the frame number in the folder of darks, in the order of the files', Ro='numarul cadrului in folderul de dark-uri, in ordinea fisierelor'}" />
          <TextBlock Grid.Column="1" Style="{StaticResource LeftHead}" Text="{l:T En='file', Ro='fisier'}" ToolTip="{l:T En='the file name', Ro='numele fisierului'}" />
          <TextBlock Grid.Column="2" Style="{StaticResource LeftHead}" Text="{l:T En='time', Ro='ora'}" ToolTip="{l:T En='the time the exposure started, as written in the file (for a raw, the camera time; for a FITS from Siril, the UTC time)', Ro='ora la care a inceput expunerea, cum e scrisa in fisier (la un raw, ora aparatului; la un FITS de la Siril, ora UTC)'}" />
          <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="{l:T En='mean', Ro='medie'}" ToolTip="{l:T En='how far the frame is above the black, on average, in ADU', Ro='cat e cadrul, in medie, peste negru, in ADU'}" />
          <TextBlock Grid.Column="4" Style="{StaticResource Head}" Text="{l:T En='noise', Ro='zgomot'}" ToolTip="{Binding NoiseHeaderTip}" />
          <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="{l:T En='diff.', Ro='dif.'}" ToolTip="{l:T En='how much the frame differs from the master, in ADU (its noise against the master)', Ro='cat difera cadrul de master, in ADU (zgomotul lui fata de master)'}" />
          <TextBlock Grid.Column="6" Style="{StaticResource Head}" Text="{l:T En='bands', Ro='benzi'}" ToolTip="{l:T En='how many times more the rows differ from one another than the noise alone would give; 1 = no banding', Ro='de cate ori difera randurile intre ele mai mult decat ar da zgomotul singur; 1 = fara benzi'}" />
          <TextBlock Grid.Column="7" Style="{StaticResource Head}" Text="{l:T En='hot', Ro='fierb.'}" ToolTip="{l:T En='how hot the hot pixels of the master are in this frame, against the master (1 = the same); it shows how warm the sensor was', Ro='cat de fierbinti sunt in acest cadru pixelii fierbinti ai masterului, fata de master (1 = la fel); arata cat de cald era senzorul'}" />
          <TextBlock Grid.Column="8" Style="{StaticResource Head}" Text="{l:T En='plateau', Ro='platou'}" ToolTip="{Binding PlateauHeaderTip}" />
          <TextBlock Grid.Column="9" Style="{StaticResource Head}" Text="{l:T En='light', Ro='lumina'}" ToolTip="{l:T En='how much more light the frame has than the warming explains, in ADU-eq: light that comes and goes from one frame to the next (check 2)', Ro='cata lumina in plus are cadrul fata de cat explica incalzirea, in ADU-eq: lumina care vine si pleaca de la un cadru la altul (verificarea 2)'}" />
          <TextBlock Grid.Column="10" Style="{StaticResource Head}" Text="{l:T En='side', Ro='latura'}" ToolTip="{l:T En='how much the side with the most constant light (the edge and its two corners) differs from the centre in this frame, once the bias is taken off when there is one, glow included, in ADU-eq; what does not change from one frame to the next is the light in every frame (check 2)', Ro='cat difera de centru, in acest cadru, latura cu cea mai multa lumina constanta (marginea si cele doua colturi ale ei), dupa ce se scade bias-ul, daca exista, cu glow cu tot, in ADU-eq; ce nu se schimba de la un cadru la altul e lumina din toate cadrele (verificarea 2)'}" />
          <TextBlock Grid.Column="11" Style="{StaticResource Head}" Text="{Binding HotHeader}" ToolTip="{Binding HotHeaderTip}" />
          <TextBlock Grid.Column="12" Style="{StaticResource LeftHead}" Text="{Binding FrameTableNote}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FrameTableNote}" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Frames}" ItemTemplate="{StaticResource FrameRow}" Margin="4,0,0,0" />
        </ScrollViewer>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{l:T En='HOT PIXELS AGAINST THE MASTER', Ro='PIXELII FIERBINTI FATA DE MASTER'}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap" Text="{Binding WarmingNote}" />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="180" Points="{Binding WarmingPoints}" Guides="{Binding WarmingGuides}" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" TextWrapping="Wrap" Text="{l:T En='HOW MUCH EACH FRAME DIFFERS FROM THE MASTER (ADU)', Ro='CAT DIFERA FIECARE CADRU DE MASTER (ADU)'}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="{l:T En='The noise of each frame against the master; a frame above the dotted line is much noisier than the others (check 4).', Ro='Zgomotul fiecarui cadru fata de master; un cadru peste linia punctata e mult mai zgomotos decat celelalte (verificarea 4).'}" />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="180" Points="{Binding ResidualPoints}" Guides="{Binding ResidualGuides}" Minimum="0" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{l:T En='RANDOM BANDING (1 = NO BANDING)', Ro='BENZI ALEATOARE (1 = FARA BENZI)'}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="{l:T En='How many times more the rows of the frame differ from one another than the noise alone would give; 1 = no banding.', Ro='De cate ori difera randurile cadrului intre ele mai mult decat ar da zgomotul singur; 1 = fara benzi.'}" />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="160" Points="{Binding BandingPoints}" Guides="{Binding BandingGuides}" Minimum="0" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
