<!-- FramesView: the darks table, one row per frame with the console's cells (TABEL PE CADRE),
     and the three per-frame charts beside it: the residual sigma, the random banding and the
     amplitude of the hot pixels against the master (the warming of the series). -->

<UserControl x:Class="DarksCheck.Wpf.FramesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DarksCheck.Wpf">
  <UserControl.Resources>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="LeftCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Faint}">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="LeftHead" TargetType="TextBlock" BasedOn="{StaticResource Head}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- the attention colour of VerdictPalette.Warn, for a frame off the plateau (R-071) -->
    <SolidColorBrush x:Key="WarnBr" Color="#E3B341" />
    <SolidColorBrush x:Key="WarnBg" Color="#26E3B341" />
    <Style x:Key="FrameRowGrid" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Off}" Value="True">
          <Setter Property="Background" Value="{StaticResource WarnBg}" />
          <Setter Property="ToolTip" Value="{Binding Note}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PlateauCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Off}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource WarnBr}" />
          <Setter Property="FontWeight" Value="Bold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="FrameRow">
      <Grid Style="{StaticResource FrameRowGrid}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Index}" />
        <TextBlock Grid.Column="1" Style="{StaticResource LeftCell}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
        <TextBlock Grid.Column="2" Style="{StaticResource LeftCell}" Text="{Binding Time}" />
        <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Mean}" />
        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Sigma}" />
        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding Residual}" />
        <TextBlock Grid.Column="6" Style="{StaticResource Cell}" Text="{Binding Bands}" />
        <TextBlock Grid.Column="7" Style="{StaticResource Cell}" Text="{Binding Amp}" />
        <TextBlock Grid.Column="8" Style="{StaticResource PlateauCell}" Text="{Binding Plateau}" />
        <TextBlock Grid.Column="9" Style="{StaticResource Cell}" Text="{Binding Light}" />
        <TextBlock Grid.Column="10" Style="{StaticResource Cell}" Text="{Binding Side}" />
        <TextBlock Grid.Column="11" Style="{StaticResource Cell}" Text="{Binding Above}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="12" Style="{StaticResource LeftCell}" Foreground="{StaticResource WarnBr}" TextWrapping="Wrap" Text="{Binding Note}"
                   Visibility="{Binding Note, Converter={StaticResource NotNullToVis}}" />
        <TextBlock Grid.Column="12" Style="{StaticResource LeftCell}" Foreground="{StaticResource MutedBr}" TextTrimming="CharacterEllipsis" Text="{Binding Skipped}" ToolTip="{Binding Skipped}"
                   Visibility="{Binding Skipped, Converter={StaticResource NotNullToVis}}" />
        <TextBlock Grid.Column="12" Style="{StaticResource LeftCell}" Foreground="{StaticResource BadBr}" TextTrimming="CharacterEllipsis" Text="{Binding Error}" ToolTip="{Binding Error}"
                   Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="20,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" MinWidth="620" />
      <ColumnDefinition Width="2*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="TABEL PE CADRE" />
        <Grid Grid.Row="1" Margin="4,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Head}" Text="nr" ToolTip="numarul cadrului in folderul de dark-uri, in ordinea fisierelor" />
          <TextBlock Grid.Column="1" Style="{StaticResource LeftHead}" Text="fisier" ToolTip="numele fisierului" />
          <TextBlock Grid.Column="2" Style="{StaticResource LeftHead}" Text="ora" ToolTip="ora de start a expunerii, din metadatele fisierului" />
          <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="medie" ToolTip="media cadrului peste negru, ADU" />
          <TextBlock Grid.Column="4" Style="{StaticResource Head}" Text="sigma" ToolTip="sigma cadrului pe planul de referinta, ADU" />
          <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="rezid." ToolTip="sigma reziduului cadru - master, ADU" />
          <TextBlock Grid.Column="6" Style="{StaticResource Head}" Text="benzi" ToolTip="deviatia mediilor pe randuri, de cate ori zgomotul alb" />
          <TextBlock Grid.Column="7" Style="{StaticResource Head}" Text="amplit." ToolTip="amplitudinea pixelilor fierbinti ai masterului in cadru, fata de master" />
          <TextBlock Grid.Column="8" Style="{StaticResource Head}" Text="platou" ToolTip="gradele cadrului fata de platoul seriei, citite din pixelii fierbinti; un cadru la peste 1 grad de platou e de aruncat si are motivul in ultima coloana (verificarea 3)" />
          <TextBlock Grid.Column="9" Style="{StaticResource Head}" Text="lumina" ToolTip="lumina in plus fata de dreapta mediei cadrului pe incalzire, ADU-eq: ce se schimba de la un cadru la altul (verificarea 2)" />
          <TextBlock Grid.Column="10" Style="{StaticResource Head}" Text="latura" ToolTip="abaterea fata de centru, in acel cadru, a laturii cu cea mai multa lumina constanta (margine plus cele doua colturi), dupa bias cand exista bias-uri, glow inclus, ADU-eq; partea ei constanta e lumina din toate cadrele (verificarea 2)" />
          <TextBlock Grid.Column="11" Style="{StaticResource Head}" Text="{Binding HotHeader}" ToolTip="{Binding HotHeaderTip}" />
          <TextBlock Grid.Column="12" Style="{StaticResource LeftHead}" Text="{Binding FrameTableNote}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FrameTableNote}" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Frames}" ItemTemplate="{StaticResource FrameRow}" Margin="4,0,0,0" />
        </ScrollViewer>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="PIXELII FIERBINTI FATA DE MASTER" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap" Text="{Binding WarmingNote}" />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="180" Points="{Binding WarmingPoints}" Guides="{Binding WarmingGuides}" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="SIGMA REZIDUALA (ADU)" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="Zgomotul fiecarui cadru fata de master; peste linia punctata cadrul e un outlier (verificarea 4)." />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="180" Points="{Binding ResidualPoints}" Guides="{Binding ResidualGuides}" Minimum="0" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="BENZI ALEATOARE (x ZGOMOT ALB)" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="Deviatia mediilor pe randuri fata de cat ar da zgomotul alb; 1 = fara benzi." />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="160" Points="{Binding BandingPoints}" Guides="{Binding BandingGuides}" Minimum="0" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
