<UserControl x:Class="DarksCheck.Wpf.ScaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DarksCheck.Wpf">
  <!-- The tab "Explicatii scara ADU" (R-078): the scale rows and the four paragraphs of R-080, as the core wrote them. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{Binding ScaleTitle}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap"
                     Text="{l:T En='ADU is the unit in which the file writes how bright each pixel is. Here you see what 1 ADU means on the open set: how much the file holds, how much noise there is, where the thresholds start and what was found.', Ro='ADU e unitatea in care fisierul scrie cat de luminos e fiecare pixel. Aici vezi ce inseamna 1 ADU pe setul deschis: cat incape in fisier, cat zgomot e, de unde incep pragurile si ce s-a gasit.'}" />
          <ItemsControl ItemsSource="{Binding ScaleRows}" ItemTemplate="{StaticResource ReportRow}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{l:T En='WHY A FRACTION OF AN ADU MATTERS', Ro='DE CE CONTEAZA O FRACTIUNE DE ADU'}" />
          <ItemsControl ItemsSource="{Binding ScaleParagraphs}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,10" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
