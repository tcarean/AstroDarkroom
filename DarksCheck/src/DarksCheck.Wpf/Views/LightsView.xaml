<!-- LightsView: check 9, the lights against the dark: the report's rows, the lights-over-dark
     ratio per light with the five verdict bounds as guide lines, and the lights table. -->

<UserControl x:Class="DarksCheck.Wpf.LightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DarksCheck.Wpf"
             xmlns:local="clr-namespace:DarksCheck.Wpf">
  <UserControl.Resources>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="LeftCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Faint}">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="LeftHead" TargetType="TextBlock" BasedOn="{StaticResource Head}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <DataTemplate x:Key="LightRow">
      <Grid Margin="0,0,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="76" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Index}" />
        <TextBlock Grid.Column="1" Style="{StaticResource LeftCell}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
        <TextBlock Grid.Column="2" Style="{StaticResource LeftCell}" Text="{Binding Time}" />
        <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Sky}" />
        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding LocalSigma}" />
        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding Candidates}" />
        <TextBlock Grid.Column="6" Style="{StaticResource Cell}" Text="{Binding Isolated}" />
        <TextBlock Grid.Column="7" Style="{StaticResource Cell}" Text="{Binding Amp}" />
        <TextBlock Grid.Column="8" Style="{StaticResource Cell}" Text="{Binding Q25}" />
        <TextBlock Grid.Column="9" Style="{StaticResource Cell}" Text="{Binding Q75}" />
        <TextBlock Grid.Column="10" Style="{StaticResource LeftCell}" Foreground="{StaticResource MutedBr}" TextTrimming="CharacterEllipsis" Text="{Binding Skipped}" ToolTip="{Binding Skipped}"
                   Visibility="{Binding Skipped, Converter={StaticResource NotNullToVis}}" />
        <TextBlock Grid.Column="10" Style="{StaticResource LeftCell}" Foreground="{StaticResource BadBr}" TextTrimming="CharacterEllipsis" Text="{Binding Error}" ToolTip="{Binding Error}"
                   Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="20,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="460" />
        <ColumnDefinition Width="1*" MinWidth="420" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{l:T En='9. LIGHTS AGAINST THE DARK', Ro='9. LIGHTS FATA DE DARK'}" />
          <ItemsControl ItemsSource="{Binding LightRows}" ItemTemplate="{StaticResource ReportRow}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}"
              Visibility="{Binding HasLights, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{l:T En='LIGHTS / DARK, PER FRAME', Ro='LIGHTS / DARK, PE CADRU'}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap" Text="{Binding LightsChartLead}" />
          <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
            <local:SeriesChart Height="220" Points="{Binding LightPoints}" Guides="{Binding LightGuides}" Minimum="0" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,0"
            Visibility="{Binding HasLights, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="{l:T En='LIGHTS TABLE', Ro='TABEL PE LIGHTS'}" />
        <Grid Grid.Row="1" Margin="4,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Head}" Text="{l:T En='no.', Ro='nr'}" ToolTip="{l:T En='the light number in the lights folder, in the order of the files', Ro='numarul light-ului in folderul lights, in ordinea fisierelor'}" />
          <TextBlock Grid.Column="1" Style="{StaticResource LeftHead}" Text="{l:T En='file', Ro='fisier'}" ToolTip="{l:T En='the file name', Ro='numele fisierului'}" />
          <TextBlock Grid.Column="2" Style="{StaticResource LeftHead}" Text="{l:T En='time', Ro='ora'}" ToolTip="{l:T En='the time the exposure started, from the file metadata', Ro='ora de start a expunerii, din metadatele fisierului'}" />
          <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="{l:T En='sky', Ro='cer'}" ToolTip="{l:T En='the sky median above the black, ADU', Ro='mediana cerului peste negru, ADU'}" />
          <TextBlock Grid.Column="4" Style="{StaticResource Head}" Text="sigma" ToolTip="{l:T En='sigma of the local excess, the detector scale, ADU', Ro='sigma excesului local, scara detectorului, ADU'}" />
          <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="{l:T En='candidates', Ro='candidati'}" ToolTip="{Binding DataContext.CandidatesTip, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <TextBlock Grid.Column="6" Style="{StaticResource Head}" Text="{l:T En='isolated', Ro='izolati'}" ToolTip="{Binding DataContext.IsolatedTip, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <TextBlock Grid.Column="7" Style="{StaticResource Head}" Text="{l:T En='ampl.', Ro='amplit.'}" ToolTip="{l:T En='lights / dark at the master hot pixels, median', Ro='lights / dark la pixelii fierbinti ai masterului, mediana'}" />
          <TextBlock Grid.Column="8" Style="{StaticResource Head}" Text="q25" ToolTip="{l:T En='lower quartile of the lights / dark ratio on the hot pixels', Ro='quartila de jos a raportului lights / dark pe pixelii fierbinti'}" />
          <TextBlock Grid.Column="9" Style="{StaticResource Head}" Text="q75" ToolTip="{l:T En='upper quartile of the lights / dark ratio on the hot pixels', Ro='quartila de sus a raportului lights / dark pe pixelii fierbinti'}" />
          <TextBlock Grid.Column="10" Style="{StaticResource LeftHead}" Text="{Binding LightTableNote}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LightTableNote}" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Lights}" ItemTemplate="{StaticResource LightRow}" Margin="4,0,0,0" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
