<!-- Rows.xaml: DarksCheck's own templates over LightsCheck's theme (Dark.xaml, a copy kept as
     it is, ADR 0009). It merges the theme itself, so a StaticResource below finds the chip
     template and the converters: a StaticResource resolves in its own dictionary and the ones
     that dictionary merges, not in the one that imports it. -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DarksCheck.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Dark.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- A row's figures as a small table (R-024, R-051): the core's column names over its rows,
       the columns sized together, and the core's note under them. -->
  <DataTemplate x:Key="ReportTable">
    <StackPanel Grid.IsSharedSizeScope="True" Margin="0,2,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn0" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn1" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn2" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding Header[0]}" Margin="0,0,22,2" />
        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding Header[1]}" TextAlignment="Right" Margin="0,0,22,2" />
        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding Header[2]}" TextAlignment="Right" Margin="0,0,0,2" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn0" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn1" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn2" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding [0]}" Margin="0,0,22,1" />
              <TextBlock Grid.Column="1" Text="{Binding [1]}" TextAlignment="Right" Margin="0,0,22,1" />
              <TextBlock Grid.Column="2" Text="{Binding [2]}" TextAlignment="Right" Margin="0,0,0,1" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource Muted}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
  </DataTemplate>

  <!-- A report row (R-071): the label, the verdict chip when the row carries a verdict word,
       and the rest of the text: its statements one under the other, or its table when it has
       one. Shared by every tab that lists rows. -->
  <DataTemplate x:Key="ReportRow">
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" />
      <ContentControl Grid.Column="1" Content="{Binding Verdict}" ContentTemplate="{StaticResource VerdictChip}"
                      Margin="0,0,10,0" VerticalAlignment="Top"
                      Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}" />
      <StackPanel Grid.Column="2">
        <!-- the statements, one under the other, the row's bold parts (the masters' noise, the light found, ADR 0016) as bold runs -->
        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock local:Emphasis.Text="{Binding}" local:Emphasis.Bold="{Binding DataContext.Bold, RelativeSource={RelativeSource AncestorType=ItemsControl}}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl Content="{Binding Table}" ContentTemplate="{StaticResource ReportTable}" Focusable="False"
                        Visibility="{Binding HasTable, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- A settings field of the top bar (R-075): the theme's field, its border red while the
       text is not a positive number, so the eye sees that the default will be used. -->
  <Style x:Key="SettingField" TargetType="TextBox" BasedOn="{StaticResource Field}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="False">
        <Setter Property="BorderBrush" Value="{StaticResource BadBr}" />
        <Setter Property="ToolTip" Value="{local:T En='Not a positive number (with a dot as the separator): the default value is used', Ro='Nu e un numar pozitiv (cu punct): se foloseste valoarea implicita'}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
