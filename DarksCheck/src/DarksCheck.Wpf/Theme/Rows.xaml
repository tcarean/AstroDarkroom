<!-- Rows.xaml: DarksCheck's own templates over LightsCheck's theme (Dark.xaml, a copy kept as
     it is, ADR 0009). It merges the theme itself, so a StaticResource below finds the chip
     template and the converters: a StaticResource resolves in its own dictionary and the ones
     that dictionary merges, not in the one that imports it. -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DarksCheck.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Dark.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- A row's figures as a small table (R-024, R-051): the core's column names over its rows,
       the columns sized together, and the core's note under them. Five columns, the widest
       table (check 9's); a narrower one leaves the last ones empty (TableVm fills its cells). -->
  <DataTemplate x:Key="ReportTable">
    <StackPanel Grid.IsSharedSizeScope="True" Margin="0,2,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn0" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn1" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn2" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn3" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn4" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding HeaderCells[0]}" Margin="0,0,0,2" />
        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding HeaderCells[1]}" TextAlignment="Right" Margin="22,0,0,2" />
        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding HeaderCells[2]}" TextAlignment="Right" Margin="22,0,0,2" />
        <TextBlock Grid.Column="3" Style="{StaticResource Muted}" Text="{Binding HeaderCells[3]}" TextAlignment="Right" Margin="22,0,0,2" />
        <TextBlock Grid.Column="4" Style="{StaticResource Muted}" Text="{Binding HeaderCells[4]}" TextAlignment="Right" Margin="22,0,0,2" />
      </Grid>
      <ItemsControl ItemsSource="{Binding RowCells}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn0" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn1" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn2" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn3" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="TableColumn4" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding [0]}" Margin="0,0,0,1" />
              <TextBlock Grid.Column="1" Text="{Binding [1]}" TextAlignment="Right" Margin="22,0,0,1" />
              <TextBlock Grid.Column="2" Text="{Binding [2]}" TextAlignment="Right" Margin="22,0,0,1" />
              <TextBlock Grid.Column="3" Text="{Binding [3]}" TextAlignment="Right" Margin="22,0,0,1" />
              <TextBlock Grid.Column="4" Text="{Binding [4]}" TextAlignment="Right" Margin="22,0,0,1" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource Muted}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
  </DataTemplate>

  <!-- The chip of a row that must stand out (R-124): the verdict word on the theme's red, larger
       than the ordinary chip. -->
  <DataTemplate x:Key="AlertChip">
    <Border Background="{StaticResource BadBr}" CornerRadius="3" Padding="9,3" VerticalAlignment="Center">
      <TextBlock Text="{Binding}" Foreground="#16161A" FontSize="14" FontWeight="Bold" />
    </Border>
  </DataTemplate>

  <!-- A report row (R-071): the label, the verdict chip when the row carries a verdict word,
       and the rest of the text: its statements one under the other, or its table when it has
       one. A row the core marks as an alert (R-124: darks that do not have the lights' settings)
       has its chip and its text large and red. Shared by every tab that lists rows. -->
  <DataTemplate x:Key="ReportRow">
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" />
      <ContentControl x:Name="Chip" Grid.Column="1" Content="{Binding Verdict}" ContentTemplate="{StaticResource VerdictChip}"
                      Margin="0,0,10,0" VerticalAlignment="Top"
                      Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}" />
      <StackPanel Grid.Column="2">
        <!-- the statements, one under the other, the row's bold parts (the masters' noise, the light found, ADR 0016) as bold runs -->
        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock local:Emphasis.Text="{Binding}" local:Emphasis.Bold="{Binding DataContext.Bold, RelativeSource={RelativeSource AncestorType=ItemsControl}}" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DataContext.Alert, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BadBr}" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- the row's choice above its table (R-123): check 9's limit of the stack's noise, the core's label and options -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                    Visibility="{Binding HasChoice, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource Muted}" Text="{Binding Choice.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Choice.Options}" SelectedIndex="{Binding Choice.SelectedIndex, Mode=TwoWay}"
                    MinWidth="72" VerticalAlignment="Center" AutomationProperties.Name="{Binding Choice.Label}" />
        </StackPanel>
        <ContentControl Content="{Binding Table}" ContentTemplate="{StaticResource ReportTable}" Focusable="False"
                        Visibility="{Binding HasTable, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Alert}" Value="True">
        <Setter TargetName="Chip" Property="ContentTemplate" Value="{StaticResource AlertChip}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- A settings field of the top bar (R-075): the theme's field, its border red while the
       text is not a positive number, so the eye sees that the default will be used. -->
  <Style x:Key="SettingField" TargetType="TextBox" BasedOn="{StaticResource Field}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="False">
        <Setter Property="BorderBrush" Value="{StaticResource BadBr}" />
        <Setter Property="ToolTip" Value="{local:T En='Not a positive number (with a dot as the separator): the default value is used', Ro='Nu e un numar pozitiv (cu punct): se foloseste valoarea implicita'}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
