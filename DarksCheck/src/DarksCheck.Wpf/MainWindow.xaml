<!-- MainWindow: the top bar (banner, folder, settings, buttons), then the tabs; the same
     layout as LightsCheck's and FlatCheck's windows. Without a usable folder the tabs stay
     hidden and the explanation takes their place. -->

<Window x:Class="DarksCheck.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarksCheck.Wpf"
        Title="DarksCheck" Height="820" Width="1360" WindowState="Maximized"
        Icon="/DarksCheck.Wpf;component/Icon/darkscheck.ico"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="ShowAbout" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================================================ the top bar -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Faint}" Text="FOLDER SESIUNE SIRIL SAU BIBLIOTECA DE DARK-URI" />
          <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Folder}"
                     Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="(niciunul ales)"
                     Visibility="{Binding HasFolder, Converter={StaticResource NotBoolToVis}}" />
        </StackPanel>

        <!-- the settings the files do not carry (R-075, R-076), remembered between runs -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                    IsEnabled="{Binding IsIdle}">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Style="{StaticResource Faint}" Text="FIRE" ToolTip="Cate cadre se decodeaza in paralel; gol = jumatate din nuclee" />
            <TextBox Style="{StaticResource Field}" Width="48" Margin="0,3,0,0" Text="{Binding ThreadsText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Style="{StaticResource Faint}" Text="CADRE MAX" ToolTip="{Binding MaxFramesTip}" />
            <TextBox Style="{StaticResource SettingField}" Tag="{Binding MaxFramesIsValid}" Width="56" Margin="0,3,0,0" Text="{Binding MaxFramesText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Style="{StaticResource Faint}" Text="CASTIG / TREAPTA ISO" ToolTip="{Binding IsoFactorTip}" />
            <TextBox Style="{StaticResource SettingField}" Tag="{Binding IsoFactorIsValid}" Width="56" Margin="0,3,0,0" Text="{Binding IsoFactorText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Faint}" Text="GRADE / DUBLARE" ToolTip="{Binding DoublingTip}" />
            <TextBox Style="{StaticResource SettingField}" Tag="{Binding DoublingIsValid}" Width="56" Margin="0,3,0,0" Text="{Binding DoublingText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Alege folder..." Click="ChooseFolder" IsEnabled="{Binding IsIdle}" />
          <Button Content="Opreste" Click="Stop" Margin="10,0,0,0"
                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
          <Button Content="Scrie fisierele..." Click="ExportFiles" Margin="10,0,0,0"
                  ToolTip="Raportul, CSV-urile cu toate cifrele si hartile, intr-un folder la alegere; nu in folderul sesiunii sau al partenerului"
                  IsEnabled="{Binding HasResult}" />
          <Button Content="Despre" Command="Help" ToolTip="Versiune, licenta, componente (F1)" Margin="10,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- what was written, that the run was stopped, that the partner changed -->
    <Border Grid.Row="1" Background="{StaticResource PanelBg2}" Padding="20,6"
            Visibility="{Binding Status, Converter={StaticResource NotNullToVis}}">
      <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" />
    </Border>

    <!-- ============================================================ the content -->
    <Grid Grid.Row="2">

      <!-- no folder yet -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="24">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasFolder}" Value="False" />
                  <Condition Binding="{Binding HasProblem}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center" Text="{Binding EmptyLead}" />
        <Button Content="Alege folder..." Margin="0,22,0,0" HorizontalAlignment="Center" Click="ChooseFolder" />
      </StackPanel>

      <!-- a folder that cannot be analysed -->
      <Border MaxWidth="620" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource Card}" BorderBrush="#5A3A3A" Background="#2A2224" Margin="24"
              Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="{Binding ProblemTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#F0857E" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding ProblemText}" />
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Alege alt folder..." Click="ChooseFolder" />
            <Button Content="Alege partener..." Margin="10,0,0,0" Click="ChoosePartnerAndRerun"
                    ToolTip="O biblioteca sau alta sesiune de dark-uri; folderul deschis e analizat din nou cu ea (o sesiune cu lights fara dark-uri ia dark-urile partenerului)" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- the tabs -->
      <TabControl>
        <TabControl.Style>
          <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasResult}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TabControl.Style>
        <TabItem Header="Rezumat">
          <local:SummaryView />
        </TabItem>
        <TabItem Header="Cadre">
          <local:FramesView />
        </TabItem>
        <TabItem Header="Harti">
          <local:MapsView />
        </TabItem>
        <TabItem Header="Pixeli fierbinti">
          <local:HotPixelsView />
        </TabItem>
        <TabItem Header="Lights">
          <local:LightsView />
        </TabItem>
        <TabItem Header="Index">
          <local:IndexView />
        </TabItem>
        <TabItem Header="Explicatii scara ADU">
          <local:ScaleView />
        </TabItem>
        <TabItem Header="Raport">
          <Border Style="{StaticResource Card}" Margin="20" Padding="0">
            <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Background="Transparent" Foreground="{StaticResource MutedBr}"
                     BorderThickness="0" Padding="14"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
          </Border>
        </TabItem>
      </TabControl>

      <!-- the wait screen over everything while the frames are decoded and measured -->
      <Border Background="#E01B1B1D" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="24">
          <TextBlock Text="{Binding BusyMessage}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
          <ProgressBar Width="320" Margin="0,18,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
          <Button Content="Opreste" Click="Stop" Margin="0,18,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
