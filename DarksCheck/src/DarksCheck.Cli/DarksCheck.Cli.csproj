<Project Sdk="Microsoft.NET.Sdk">
  <!-- The console, darkscheck.exe: options, dispatch, exit code. Everything that computes or
       formats is in DarksCheck.Core; Program.Run(args, stdout, stderr) is what the tests drive. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DarksCheck.Cli</RootNamespace>
    <AssemblyName>darkscheck</AssemblyName>
    <!-- Read from darkscheck.runtimeconfig.json at run time: the console formats numbers with
         "." whatever the Windows culture (R-005). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The same icon file as the window's, drawn per size by Icon/make_icon.py. -->
    <ApplicationIcon>..\..\Icon\darkscheck.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DarksCheck.Core\DarksCheck.Core.csproj" />
    <InternalsVisibleTo Include="DarksCheck.Tests" />
    <InternalsVisibleTo Include="DarksCheck.Wpf.Tests" />
  </ItemGroup>
</Project>
