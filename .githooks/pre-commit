#!/bin/sh
# Git pre-commit hook: the deterministic gate. Works in two layouts:
#   - standalone repo: the project is the git root, scripts/verify.ps1 is at the root;
#   - monorepo: several project folders under one git root, each with its own scripts/verify.ps1.
# For every staged file it walks up to the nearest folder holding scripts/verify.ps1, then per
# project runs scripts/check-staged.ps1 (staging rules) and scripts/verify.ps1 (the gate).
# Folders without a verify script are not checked.
# Installed by scripts/install-hooks.ps1. Skipping it (--no-verify) is forbidden by CLAUDE.md.
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

staged="$(mktemp)"
projects="$(mktemp)"
trap 'rm -f "$staged" "$projects"' EXIT
git diff --cached --name-only --diff-filter=ACMR > "$staged"

while IFS= read -r f; do
  [ -n "$f" ] || continue
  d="$(dirname "$f")"
  while :; do
    if [ -f "$d/scripts/verify.ps1" ]; then
      echo "$d" >> "$projects"
      break
    fi
    [ "$d" = "." ] && break
    d="$(dirname "$d")"
  done
done < "$staged"

status=0
for p in $(sort -u "$projects"); do
  if [ -f "$root/$p/scripts/check-staged.ps1" ]; then
    echo "pre-commit: check-staged $p"
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/$p/scripts/check-staged.ps1" || { status=1; continue; }
  fi
  echo "pre-commit: verify $p"
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/$p/scripts/verify.ps1" || status=1
done

if [ $status -ne 0 ]; then
  echo "pre-commit: gate failed; commit refused." >&2
fi
exit $status
