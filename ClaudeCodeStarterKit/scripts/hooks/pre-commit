#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# pre-commit - git's last check before it records a commit: runs the gate of every project
# the commit touches.
#
# WHAT IT DOES
#   1. Lists the files staged for the commit.
#   2. For each file, walks up its folders to the nearest one that has scripts/verify.ps1:
#      that folder is the project the file belongs to. A file with no such folder above it
#      (for example in a project that has not adopted the kit) is not checked.
#   3. For each project found, once: runs scripts/verify.ps1 (the gate). Whether the commit
#      needs a CHANGELOG line is a judgment, not checked here (the kit's ADR 0023).
#   Works in both layouts: a standalone repository (the project is the git root, found as
#   ".") and a monorepo (several project folders under one git root).
#
# WHO CALLS IT
#   git itself, on every git commit, yours or Claude's, because core.hooksPath points at this
#   file's folder (set by scripts/install-hooks.ps1). In a monorepo git runs the copy in
#   <git root>/.githooks/: edit this file, then run the kit's install-hooks.ps1 to refresh
#   the copy. git commit --no-verify skips it; CLAUDE.md forbids that (rule 4).
#
# RESULT
#   exit 0  every touched project is green; git records the commit
#   exit 1  something failed; git refuses the commit, and the output names the project
#
# A POSIX sh script (Git for Windows runs it with its own sh). It must keep Unix (LF) line
# endings; .gitattributes makes sure of that.

# Work from the root of the repository: staged file paths are relative to it.
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

# Two temporary files, deleted automatically when the script ends (trap ... EXIT).
staged="$(mktemp)"
projects="$(mktemp)"
trap 'rm -f "$staged" "$projects"' EXIT
# Staged files: A = added, C = copied, M = modified, R = renamed (deleted files are left out).
git diff --cached --name-only --diff-filter=ACMR > "$staged"

# Step 2: the project of each staged file, one line per file in $projects.
while IFS= read -r f; do
  [ -n "$f" ] || continue
  d="$(dirname "$f")"
  while :; do
    if [ -f "$d/scripts/verify.ps1" ]; then
      echo "$d" >> "$projects"
      break
    fi
    [ "$d" = "." ] && break
    d="$(dirname "$d")"
  done
done < "$staged"

# Step 3: each project once (sort -u drops the duplicates); any failure sets status=1.
status=0
for p in $(sort -u "$projects"); do
  echo "pre-commit: verify $p"
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/$p/scripts/verify.ps1" || status=1
done

if [ $status -ne 0 ]; then
  echo "pre-commit: gate failed; commit refused." >&2
fi
exit $status
