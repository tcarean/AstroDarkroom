{
  "$comment": "Project-level Claude Code settings, versioned. Machine-specific grants go to settings.local.json (git-ignored). 'ask' makes every commit, merge and push prompt the owner, whatever was approved earlier (rule 13). Hooks: PreToolUse runs check-staged + verify before any git commit the model attempts and blocks --no-verify; PostToolUse records which files this session edited; Stop refuses to end a turn that edited src/ or tests/ until verify ran green and CHANGELOG.md changed.",
  "permissions": {
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format*)",
      "Bash(dotnet restore*)",
      "Bash(dotnet run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "PowerShell(dotnet build*)",
      "PowerShell(dotnet test*)",
      "PowerShell(dotnet format*)",
      "PowerShell(dotnet restore*)",
      "PowerShell(dotnet run*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git branch*)",
      "PowerShell(git add*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-testdata.ps1)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-staged.ps1)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mutate.ps1*)",
      "PowerShell(dotnet tool restore*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "PowerShell(git commit*)",
      "PowerShell(git merge*)",
      "PowerShell(git push*)",
      "PowerShell(git rebase*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "PowerShell(git push --force*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git commit --no-verify*)",
      "Read(**/*.secrets.json)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/claude-commit-gate.ps1",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/claude-track-edits.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hooks/claude-stop-gate.ps1",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
