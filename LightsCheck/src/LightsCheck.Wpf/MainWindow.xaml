<!-- MainWindow: the top bar (banner, folder, inputs, buttons), then the tabs; the same layout
     as FlatCheck's window. Without a usable folder the tabs stay hidden and the explanation
     takes their place. -->

<Window x:Class="LightsCheck.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightsCheck.Wpf"
        Title="LightsCheck" Height="820" Width="1360" WindowState="Maximized"
        Icon="/LightsCheck.Wpf;component/Icon/lightscheck.ico"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="ShowAbout" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================================================ the top bar -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Faint}" Text="{local:T En='SIRIL SESSION FOLDER', Ro='FOLDER SESIUNE SIRIL'}" />
          <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Folder}"
                     Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{local:T En='(none chosen)', Ro='(niciunul ales)'}"
                     Visibility="{Binding HasFolder, Converter={StaticResource NotBoolToVis}}" />
        </StackPanel>

        <!-- the inputs a raw does not carry, with the D3300's values (ADR 0002) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                    IsEnabled="{Binding IsIdle}">
          <StackPanel x:Name="PixelInput" Margin="0,0,12,0" ToolTip="{x:Static local:MainViewModel.PixelTip}" ToolTipService.ShowOnDisabled="True">
            <TextBlock Style="{StaticResource Faint}" Text="PIXEL (um)" />
            <TextBox Style="{StaticResource Field}" Width="64" Margin="0,3,0,0" Text="{Binding PixelText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel x:Name="ThreadsInput" ToolTip="{x:Static local:MainViewModel.ThreadsTip}" ToolTipService.ShowOnDisabled="True">
            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='THREADS', Ro='FIRE'}" />
            <TextBox Style="{StaticResource Field}" Width="48" Margin="0,3,0,0" Text="{Binding ThreadsText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel x:Name="EastInput" Margin="12,0,0,0" ToolTip="{x:Static local:MainViewModel.EastTip}" ToolTipService.ShowOnDisabled="True">
            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='EAST', Ro='EST'}" />
            <ComboBox Width="52" Margin="0,3,0,0" ItemsSource="{Binding EastChoices}" SelectedItem="{Binding EastArrow}" />
          </StackPanel>
          <StackPanel x:Name="NorthInput" Margin="12,0,0,0" ToolTip="{x:Static local:MainViewModel.NorthTip}" ToolTipService.ShowOnDisabled="True">
            <TextBlock Style="{StaticResource Faint}" Text="{local:T En='NORTH', Ro='NORD'}" />
            <ComboBox Width="52" Margin="0,3,0,0" ItemsSource="{Binding NorthChoices}" SelectedItem="{Binding NorthArrow}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{local:T En='Choose folder...', Ro='Alege folder...'}" Click="ChooseFolder" IsEnabled="{Binding IsIdle}" />
          <Button Content="{local:T En='Stop', Ro='Opreste'}" Click="Stop" Margin="10,0,0,0"
                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
          <Button Content="{local:T En='Write the files...', Ro='Scrie fisierele...'}" Click="ExportFiles" Margin="10,0,0,0"
                  ToolTip="{local:T En='The report, the CSV with every figure and the reject list, into a folder of your choice', Ro='Raportul, CSV-ul cu toate cifrele si lista de respins, intr-un folder la alegere'}"
                  IsEnabled="{Binding HasResult}" />
          <Button Content="{local:T En='About', Ro='Despre'}" Command="Help" ToolTip="{local:T En='Version, licence, components (F1)', Ro='Versiune, licenta, componente (F1)'}" Margin="10,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- what was written, or that the run was stopped -->
    <Border Grid.Row="1" Background="{StaticResource PanelBg2}" Padding="20,6"
            Visibility="{Binding Status, Converter={StaticResource NotNullToVis}}">
      <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" />
    </Border>

    <!-- ============================================================ the content -->
    <Grid Grid.Row="2">

      <!-- no folder yet -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasFolder}" Value="False" />
                  <Condition Binding="{Binding HasProblem}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center" Text="{Binding EmptyLead}" />
        <Button Content="{local:T En='Choose folder...', Ro='Alege folder...'}" Margin="0,22,0,0" HorizontalAlignment="Center" Click="ChooseFolder" />
      </StackPanel>

      <!-- a folder that cannot be analysed -->
      <Border MaxWidth="620" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource Card}" BorderBrush="#5A3A3A" Background="#2A2224" Margin="24"
              Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="{Binding ProblemTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#F0857E" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding ProblemText}" />
          <Button Content="{local:T En='Choose another folder...', Ro='Alege alt folder...'}" Margin="0,20,0,0" HorizontalAlignment="Left" Click="ChooseFolder" />
        </StackPanel>
      </Border>

      <!-- the tabs; their style is the theme's for AccessibleTabControl, an implicit style
           applying to its exact type only (R-067, ADR 0028) -->
      <local:AccessibleTabControl>
        <local:AccessibleTabControl.Style>
          <Style TargetType="local:AccessibleTabControl" BasedOn="{StaticResource {x:Type local:AccessibleTabControl}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasResult}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </local:AccessibleTabControl.Style>
        <TabItem Header="{local:T En='Summary', Ro='Rezumat'}">
          <local:SummaryView />
        </TabItem>
        <TabItem Header="{local:T En='Frames', Ro='Cadre'}">
          <local:FramesView />
        </TabItem>
        <TabItem Header="Dithering">
          <local:DitherView />
        </TabItem>
        <TabItem Header="{local:T En='Quality', Ro='Calitate'}">
          <local:QualityView />
        </TabItem>
        <TabItem Header="{local:T En='Rejected', Ro='Respinse'}">
          <local:RejectedView />
        </TabItem>
        <TabItem Header="{local:T En='Report', Ro='Raport'}">
          <Border Style="{StaticResource Card}" Margin="20" Padding="0">
            <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Background="Transparent" Foreground="{StaticResource MutedBr}"
                     BorderThickness="0" Padding="14"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
          </Border>
        </TabItem>
      </local:AccessibleTabControl>

      <!-- the wait screen over everything while the frames are measured -->
      <Border Background="#E01B1B1D" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="24">
          <TextBlock Text="{Binding BusyMessage}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
          <ProgressBar Width="320" Margin="0,18,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
          <Button Content="{local:T En='Stop', Ro='Opreste'}" Click="Stop" Margin="0,18,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
