<!-- DitherView: the map of positions, the steps per frame, the nearest-other-frame distance,
     and the DITHERING card: the report's scalar rows (pauses and moves, the longest stretch,
     how close the frames are, the area of the positions, axes, scale, pattern, verdict), its
     five tables (how often, how far, direction, how close the frames are at each distance,
     runs), laid out as fixed-width cells, and under them the core's explanation of walking
     noise, the focal length and the darks (R-047), all in plain words (R-077). -->

<UserControl x:Class="LightsCheck.Wpf.DitherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LightsCheck.Wpf">
  <UserControl.Resources>
    <DataTemplate x:Key="ReportRow">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1">
          <ContentControl Content="{Binding Verdict}" ContentTemplate="{StaticResource VerdictChip}" HorizontalAlignment="Left" Margin="0,0,0,4"
                          Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="20,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" MinWidth="460" />
      <ColumnDefinition Width="1*" MinWidth="420" />
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{local:T En='POSITION MAP', Ro='HARTA POZITIILOR'}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="{local:T En='Each dot is a frame, placed where it sat relative to the first frame. A line joins it to the next frame, and its number is written beside it. The colour shows how the frame is: green good, yellow marginal, red bad. Two frames 10 px or more apart no longer put their hot pixels in the same place, so these no longer add up into walking noise.', Ro='Fiecare punct e un cadru, pus acolo unde a stat fata de primul cadru. O linie il leaga de cadrul urmator, iar numarul lui e scris langa el. Culoarea arata cum e cadrul: verde bun, galben la limita, rosu slab. Doua cadre aflate la 10 px sau mai mult unul de altul nu-si mai pun pixelii calzi in acelasi loc, asa ca acestia nu se mai aduna in walking noise.'}" />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:DitherMap Height="460" Points="{Binding MapPoints}" XLabel="{Binding MapXLabel}" YLabel="{Binding MapYLabel}" />
            </Border>
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{local:T En='A hollow circle instead of a solid dot: the frame is in a run of at least 3 frames in a row that stayed in the same spot (less than 10 px from the first of the run). Walking noise comes from such runs. On the Frames tab, the \'same spot\' column says which one of its run the frame is.', Ro='Un cerc gol in loc de punct plin: cadrul e intr-un grup de cel putin 3 cadre la rand care au stat in acelasi loc (la mai putin de 10 px de primul din grup). Din astfel de grupuri vine walking noise-ul. In tabul Cadre, coloana \'acelasi loc\' spune al catelea e cadrul in grupul lui.'}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{local:T En='HOW FAR IT MOVED FROM THE FRAME BEFORE', Ro='CAT S-A MUTAT FATA DE CADRUL DINAINTE'}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="{local:T En='Yellow bar: a dither move, that is, the frame moved by at least 5 px. Grey bar: no move; the frame only slid a little, by the drift.', Ro='Bara galbena: o miscare de dithering, adica cadrul s-a mutat cu cel putin 5 px. Bara gri: nicio miscare; cadrul a alunecat doar putin, cat driftul.'}" />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="200" Bars="True" Points="{Binding StepPoints}" Guides="{Binding StepGuides}" Title="px" Minimum="0" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{local:T En='DISTANCE TO THE NEAREST OTHER FRAME', Ro='DISTANTA LA CEL MAI APROPIAT ALT CADRU'}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="{local:T En='How close each frame is to the nearest other frame of the session, whenever that one was taken. Under 10 px, the two put their hot pixels in the same place.', Ro='Cat de aproape e fiecare cadru de cel mai apropiat alt cadru din sesiune, oricand ar fi fost facut acela. Sub 10 px, cele doua isi pun pixelii calzi in acelasi loc.'}" />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="200" Bars="True" Points="{Binding NearestPoints}" Guides="{Binding StepGuides}" Title="px" Minimum="0" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="DITHERING" />
          <ItemsControl ItemsSource="{Binding DitherRows}" ItemTemplate="{StaticResource ReportRow}" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding DitherTables}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Style="{StaticResource Muted}" Text="{Binding Title}" Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource Faint}" FontSize="11" Width="100" Margin="0,0,4,2" TextWrapping="Wrap" Text="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Width="100" Margin="0,0,4,2" Text="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding DitherExplanation}" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding Text}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Emphasis}" Value="True">
                          <Setter Property="FontWeight" Value="Bold" />
                          <Setter Property="Foreground" Value="{StaticResource TextBr}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
