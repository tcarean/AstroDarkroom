<!-- DitherView: the map of positions, the steps per frame, the nearest-other-frame distance,
     and the DITHERING rows of the report (how often, how far, directions, coverage, verdict). -->

<UserControl x:Class="LightsCheck.Wpf.DitherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LightsCheck.Wpf">
  <UserControl.Resources>
    <DataTemplate x:Key="ReportRow">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1">
          <ContentControl Content="{Binding Verdict}" ContentTemplate="{StaticResource VerdictChip}" HorizontalAlignment="Left" Margin="0,0,0,4"
                          Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="20,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" MinWidth="460" />
      <ColumnDefinition Width="1*" MinWidth="420" />
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="HARTA POZITIILOR" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="Fiecare cadru, acolo unde a stat fata de primul, legat de urmatorul si numerotat; culoarea e clasa cadrului (verde bun, galben la limita, rosu slab). Grila e la 10 px: distanta de la care doua cadre nu mai impart aceiasi pixeli calzi si acelasi walking noise." />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:DitherMap Height="460" Points="{Binding MapPoints}" XLabel="{Binding MapXLabel}" YLabel="{Binding MapYLabel}" />
            </Border>
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Inel in loc de punct plin = cadru dintr-un sir de 3 sau mai multe cadre consecutive in acelasi loc (10 px), sirurile care fac walking noise; coloana 'acelasi loc' din tabul Cadre spune al catelea e." />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="PASUL FATA DE CADRUL ANTERIOR" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="Galben = o miscare de dithering (pas de cel putin 5 px); gri = driftul dintre doua cadre fara miscare." />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="200" Bars="True" Points="{Binding StepPoints}" Guides="{Binding StepGuides}" Title="px" Minimum="0" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="DISTANTA LA CEL MAI APROPIAT ALT CADRU" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"
                       Text="Cat de aproape sta fiecare cadru de oricare altul din sesiune; sub 10 px impart aceiasi pixeli." />
            <Border Background="{StaticResource PanelBg2}" CornerRadius="4" Padding="6,4">
              <local:SeriesChart Height="200" Bars="True" Points="{Binding NearestPoints}" Guides="{Binding StepGuides}" Title="px" Minimum="0" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="DITHERING" />
          <ItemsControl ItemsSource="{Binding DitherRows}" ItemTemplate="{StaticResource ReportRow}" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding DitherTables}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Style="{StaticResource Muted}" Text="{Binding Title}" Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource Faint}" FontSize="11" Width="118" Margin="0,0,6,2" TextWrapping="Wrap" Text="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Width="118" Margin="0,0,6,2" Text="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
