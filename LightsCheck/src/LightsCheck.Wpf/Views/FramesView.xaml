<!-- FramesView: one row per frame, the selected one shows its star cut-outs on the right so
     the eye can check the trail the figure reports. -->

<UserControl x:Class="LightsCheck.Wpf.FramesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LightsCheck.Wpf">
  <UserControl.Resources>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Faint}">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <DataTemplate x:Key="FrameRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="78" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Index}" />
        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding File}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Time}" />
        <ContentControl Grid.Column="3" Content="{Binding Class}" ContentTemplate="{StaticResource VerdictChip}" HorizontalAlignment="Left" Margin="0,0,8,0" />
        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Elongation}" />
        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding Fwhm}" />
        <TextBlock Grid.Column="6" Style="{StaticResource Cell}" Text="{Binding Stars}" />
        <TextBlock Grid.Column="7" Style="{StaticResource Cell}" Text="{Binding Background}" />
        <TextBlock Grid.Column="8" Style="{StaticResource Cell}" Text="{Binding Pause}" />
        <TextBlock Grid.Column="9" Style="{StaticResource Cell}" Text="{Binding Step}" />
        <TextBlock Grid.Column="10" Style="{StaticResource Cell}" Text="{Binding Dx}" />
        <TextBlock Grid.Column="11" Style="{StaticResource Cell}" Text="{Binding Dy}" />
        <TextBlock Grid.Column="12" Style="{StaticResource Cell}" Text="{Binding Move}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Move}" />
        <TextBlock Grid.Column="13" Style="{StaticResource Cell}" Text="{Binding Spot}" />
        <TextBlock Grid.Column="14" Style="{StaticResource Cell}" Text="{Binding Reasons}" Foreground="{StaticResource MutedBr}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reasons}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="20,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" MinWidth="640" />
      <ColumnDefinition Width="1*" MinWidth="300" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="78" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="280" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Head}" Text="{local:T En='no', Ro='nr'}" />
          <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="{local:T En='file', Ro='fisier'}" />
          <TextBlock Grid.Column="2" Style="{StaticResource Head}" Text="{local:T En='time', Ro='ora'}" />
          <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="{local:T En='class', Ro='clasa'}" />
          <TextBlock Grid.Column="4" Style="{StaticResource Head}" Text="{local:T En='elong.', Ro='alung.'}" ToolTip="{local:T En='how elongated the stars are, typically (1 = round)', Ro='cat de alungite sunt stelele, de obicei (1 = rotunde)'}" />
          <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="FWHM" ToolTip="{local:T En='the stars\' width (FWHM), typically, in px', Ro='latimea stelelor (FWHM), de obicei, in px'}" />
          <TextBlock Grid.Column="6" Style="{StaticResource Head}" Text="{local:T En='stars', Ro='stele'}" />
          <TextBlock Grid.Column="7" Style="{StaticResource Head}" Text="{local:T En='bg', Ro='fond'}" ToolTip="{local:T En='the sky background on green, in ADU above the black level', Ro='fondul cerului pe verde, in ADU peste nivelul de negru'}" />
          <TextBlock Grid.Column="8" Style="{StaticResource Head}" Text="{local:T En='pause', Ro='pauza'}" ToolTip="{local:T En='how many seconds passed since the end of the frame before', Ro='cate secunde au trecut de la sfarsitul cadrului dinainte'}" />
          <TextBlock Grid.Column="9" Style="{StaticResource Head}" Text="{local:T En='step', Ro='pas'}" ToolTip="{local:T En='how far it moved from the frame before, in px', Ro='cat s-a mutat fata de cadrul dinainte, in px'}" />
          <TextBlock Grid.Column="10" Style="{StaticResource Head}" Text="{Binding DxHeader}" ToolTip="{local:T En='where it sat relative to frame 1, in px, along the image\'s X or Y axis; in brackets, the mount\'s axis', Ro='unde a stat fata de cadrul 1, in px, pe axa X sau Y a imaginii; in paranteza, axa monturii'}" />
          <TextBlock Grid.Column="11" Style="{StaticResource Head}" Text="{Binding DyHeader}" ToolTip="{local:T En='where it sat relative to frame 1, in px, along the image\'s X or Y axis; in brackets, the mount\'s axis', Ro='unde a stat fata de cadrul 1, in px, pe axa X sau Y a imaginii; in paranteza, axa monturii'}" />
          <TextBlock Grid.Column="12" Style="{StaticResource Head}" Text="dithering" ToolTip="{local:T En='how the mount was moved for the dither: along which axis, by how many pixels, which way on the sky and with which SynScan arrow (EAST and NORTH in the top bar say which arrow is which)', Ro='cum a fost mutata montura la dithering: pe ce axa, cu cati pixeli, incotro pe cer si cu ce sageata SynScan (EST si NORD din bara de sus spun care sageata e care)'}" />
          <TextBlock Grid.Column="13" Style="{StaticResource Head}" Text="{local:T En='same spot', Ro='acelasi loc'}" ToolTip="{local:T En='which frame in a row in the same spot (less than 10 px) it is, of how many, and from which frame the run starts; walking noise comes from such runs', Ro='al catelea cadru la rand in acelasi loc (la mai putin de 10 px), din cate, si de la ce cadru incepe grupul; din astfel de grupuri vine walking noise-ul'}" />
          <TextBlock Grid.Column="14" Style="{StaticResource Head}" Text="{local:T En='reasons', Ro='motive'}" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                 ItemTemplate="{StaticResource FrameRow}" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="4,3" />
              <Setter Property="Foreground" Value="{StaticResource TextBr}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#3A4A5A" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Grid>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{local:T En='STAR CUT-OUTS', Ro='DECUPAJE DE STELE'}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{local:T En='Choose a frame in the list: its brightest stars appear here, from the centre and the four corners, enlarged, from the green channel. Each cut-out is brightened on its own, so the star\'s shape shows well.', Ro='Alege un cadru din lista: aici apar cele mai luminoase stele ale lui, din centru si din cele patru colturi, marite, din canalul verde. Fiecare decupaj e luminat separat, ca sa se vada bine forma stelei.'}" />
          <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding CropsNote}"
                     Visibility="{Binding CropsNote, Converter={StaticResource NotNullToVis}}" />
          <ItemsControl ItemsSource="{Binding Crops}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,12,12" Width="130">
                  <Image Source="{Binding Image}" Width="125" Height="125" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                  <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Caption}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
