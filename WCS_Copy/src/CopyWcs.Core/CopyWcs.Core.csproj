<Project Sdk="Microsoft.NET.Sdk">
  <!-- The core: the FITS header engine, the key lists, the copy run and its texts, the version
       and the copyright read from the assembly. No Console, no UI, no entry point: a compile
       boundary (the kit's ADR 0002; ADR 0001). The version and the copyright come from
       Directory.Build.props, the same in every assembly. The number culture is the
       application's business: the console and the tests set InvariantGlobalization, a library
       cannot (the property has no effect without a runtimeconfig). -->
  <PropertyGroup>
    <RootNamespace>CopyWcs</RootNamespace>
  </PropertyGroup>

  <!-- The core stays internal: its consumers are in this repository and compile with it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="copywcs" />
    <InternalsVisibleTo Include="CopyWcs.Tests" />
  </ItemGroup>
</Project>
