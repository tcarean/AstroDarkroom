<Project Sdk="Microsoft.NET.Sdk">
  <!-- The console, copywcs.exe: options, dispatch, exit code, printing. Everything that reads,
       selects or writes a card is in CopyWcs.Core; CopyWcsCli.Run(args, stdout, stderr) is what
       the tests drive, and Main is a shim around it that opens and closes the diagnostic log
       (ADR 0009). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CopyWcs</RootNamespace>
    <AssemblyName>copywcs</AssemblyName>
    <!-- The same icon as the window's, so Explorer shows one tool (ADR 0007). -->
    <ApplicationIcon>..\..\Icon\copywcs.ico</ApplicationIcon>
    <!-- Read from copywcs.runtimeconfig.json at run time: the console formats numbers with
         "." whatever the Windows culture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CopyWcs.Core\CopyWcs.Core.csproj" />
    <InternalsVisibleTo Include="CopyWcs.Tests" />
    <!-- The window's tests compare the window with the console, run in process. -->
    <InternalsVisibleTo Include="CopyWcs.Wpf.Tests" />
  </ItemGroup>
</Project>
