<!-- Dark.xaml: the palette and the default styles. Copied from AstroDarkroom's App.xaml (the
     palette, the text styles, the card, the tooltip, the button) and LightsCheck's
     Theme/Dark.xaml (the hyperlink, the text field, the check box, the list, the scroll bar),
     trimmed to the controls this window uses; a fix goes there first (ADR 0007). The radio
     button is this project's, drawn after the check box: no sibling has a plain one.
     Dark because the tool is used at night, beside the mount, like the siblings'. -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================ palette -->

  <SolidColorBrush x:Key="WindowBg"  Color="#1B1B1D" />
  <SolidColorBrush x:Key="PanelBg"   Color="#232326" />
  <SolidColorBrush x:Key="PanelBg2"  Color="#2B2B2F" />
  <SolidColorBrush x:Key="HoverBg"   Color="#33333A" />
  <SolidColorBrush x:Key="BorderBr"  Color="#3A3A40" />
  <SolidColorBrush x:Key="TextBr"    Color="#E4E4E7" />
  <SolidColorBrush x:Key="MutedBr"   Color="#9A9AA3" />
  <SolidColorBrush x:Key="FaintBr"   Color="#6E6E77" />
  <SolidColorBrush x:Key="AccentBr"  Color="#4EA8DE" />
  <SolidColorBrush x:Key="WarnBr"    Color="#E3B341" />
  <SolidColorBrush x:Key="BadBr"     Color="#F85149" />

  <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>

  <!-- ============================================================ text -->

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="Foreground" Value="{StaticResource FaintBr}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- The links in About. By default WPF makes them dark blue on a black background, that
       is unreadable; the theme's accent, underlined only when the mouse passes over. -->
  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource AccentBr}" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource AccentBr}" />
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Tooltips: WPF draws them light, and the application's text is light, so they would be
       white on white; the palette's panel instead. -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" MaxWidth="360" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ panels -->

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <!-- The three file boxes: the path is typed or pasted, or filled by the Browse button. -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBr}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBr}" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ buttons -->

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="Background" Value="{StaticResource PanelBg2}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ check box -->

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <!-- A Grid, not a horizontal StackPanel: there the content gets an infinite width when
               measured, so a long label would never break into two lines - it would be cut. The
               second column is "*", so the text knows how much room it has. -->
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="box" Width="17" Height="17" CornerRadius="3"
                    Background="{StaticResource PanelBg2}"
                    BorderBrush="{StaticResource BorderBr}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Path x:Name="tick" Stretch="Uniform" Margin="3"
                    Data="M 0 5 L 4 9 L 11 0" Stroke="#1B1B1D" StrokeThickness="2.2"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBr}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBr}" />
              <Setter TargetName="tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ radio button -->

  <!-- In place or a new file: the check box's drawing with a circle and a dot, so the two
       choices read as one pair. -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ring" Width="17" Height="17" CornerRadius="8.5"
                    Background="{StaticResource PanelBg2}"
                    BorderBrush="{StaticResource BorderBr}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Ellipse x:Name="dot" Width="7" Height="7" Fill="#1B1B1D" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ring" Property="Background" Value="{StaticResource AccentBr}" />
              <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBr}" />
              <Setter TargetName="dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ lists -->

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource WindowBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBr}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                  BorderBrush="Transparent" BorderThickness="3,0,0,0">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBg2}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ scrollbar -->

  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="#4A4A52" CornerRadius="4" Margin="3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A third-party component in the About window, DarksCheck's template (ADR 0009): the name
       and the role on the first line, the licence and the copyright under it (the Faint style
       wraps them), the link to the project last. The licence sits on its own line, not in a
       tooltip. The link has no handler here - a resource dictionary has no code-behind - the
       window catches it, through the routed event Hyperlink.RequestNavigate. -->
  <DataTemplate x:Key="ComponentRowTemplate">
    <StackPanel Margin="0,0,0,10">
      <TextBlock TextWrapping="Wrap">
        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
        <Run Text=" - " Foreground="{StaticResource FaintBr}" />
        <Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource MutedBr}" FontSize="12" />
      </TextBlock>
      <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0" Text="{Binding Licence}" />
      <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" />
      <TextBlock Margin="0,2,0,0" FontSize="11">
        <Hyperlink NavigateUri="{Binding Url}">
          <Run Text="{Binding Url, Mode=OneWay}" />
        </Hyperlink>
      </TextBlock>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
