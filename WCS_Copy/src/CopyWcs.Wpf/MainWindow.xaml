<!-- MainWindow: one column. The three file rows (a label, a box, a Browse button, the facts
     read from the header under it), the output choice, the two options, the buttons, then the
     outcome card: the core's refusal, warnings, cards and closing lines, as it gives them
     (ADR 0007). Every label is a pair, {l:T En='...', Ro='...'}. -->

<Window x:Class="CopyWcs.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CopyWcs.Wpf"
        Title="CopyWcs" Height="640" Width="800"
        Icon="/CopyWcs.Wpf;component/Icon/copywcs.ico"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="ShowAboutCommand" />
  </Window.CommandBindings>
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================================================ the source -->
    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Muted}" Text="{l:T En='Plate-solved source (FITS)', Ro='Sursa plate-solved (FITS)'}" />
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource Field}" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="88" Content="{l:T En='Browse...', Ro='Alege...'}" Click="BrowseSource" />
      </Grid>
      <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" MinHeight="15" Text="{Binding SourceFacts}" />
    </StackPanel>

    <!-- ============================================================ the destination -->
    <StackPanel Grid.Row="1" Margin="0,10,0,0">
      <TextBlock Style="{StaticResource Muted}" Text="{l:T En='Destination (FITS)', Ro='Destinatia (FITS)'}" />
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource Field}" Text="{Binding Dest, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="88" Content="{l:T En='Browse...', Ro='Alege...'}" Click="BrowseDest" />
      </Grid>
      <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" MinHeight="15" Text="{Binding DestFacts}" />
    </StackPanel>

    <!-- ============================================================ in place, or a new file -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <RadioButton Content="{l:T En='Write into the destination', Ro='Scrie in destinatie'}" IsChecked="{Binding WriteInPlace}" />
        <RadioButton Margin="20,0,0,0" Content="{l:T En='Write a new file', Ro='Scrie un fisier nou'}" IsChecked="{Binding WritesNewFile}" />
      </StackPanel>
      <Grid Margin="0,6,0,0" IsEnabled="{Binding WritesNewFile}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource Field}" Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="88" Content="{l:T En='Browse...', Ro='Alege...'}" Click="BrowseOutput" />
      </Grid>
    </StackPanel>

    <!-- ============================================================ the options and the buttons -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <CheckBox IsChecked="{Binding IncludeOptical}" Content="{l:T En='Copy the optical metadata too (FOCALLEN, XPIXSZ, ...)', Ro='Copiaza si metadatele optice (FOCALLEN, XPIXSZ, ...)'}" />
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding Force}" Content="{l:T En='Continue even when the dimensions differ', Ro='Continua chiar daca dimensiunile difera'}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
        <Button MinWidth="110" IsEnabled="{Binding CanPreview}" Content="{l:T En='Preview', Ro='Previzualizare'}" Click="Preview" />
        <Button Margin="8,0,0,0" MinWidth="96" IsEnabled="{Binding CanCopy}" Content="{l:T En='Copy', Ro='Copiaza'}" Click="CopyCards" />
        <Button Margin="20,0,0,0" MinWidth="88" Content="{l:T En='About', Ro='Despre'}" Click="ShowAbout" />
      </StackPanel>
    </Grid>

    <!-- ============================================================ the outcome -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0"
            Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- the refusal: the heading is the window's one word, the line is the core's -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource Heading}" Foreground="{StaticResource BadBr}" Opacity="1" Text="{Binding RefusedHeading}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Warnings}" Focusable="False"
                      Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Foreground="{StaticResource WarnBr}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding Mode=OneWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2" Margin="0,0,0,8" Text="{Binding Heading}"
                   Visibility="{Binding HasHeading, Converter={StaticResource BoolToVis}}" />

        <ListBox Grid.Row="3" ItemsSource="{Binding Cards}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="Padding" Value="8,2" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>

        <ItemsControl Grid.Row="4" Margin="0,10,0,0" ItemsSource="{Binding Notes}" Focusable="False"
                      Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding Mode=OneWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </Grid>
</Window>
