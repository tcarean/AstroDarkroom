<!-- MainWindow: the band at the top, FlatCheck's top bar copied (ADR 0008): the banner and the
     copyright, what the tool does, Help, which opens the wiki manual at the section of what the
     card shows, as F1 does (ADR 0016), and the window's one About button. Under it one column:
     the three file rows (a label, a box, a Browse button, the facts read from the header under
     it), the output choice, the two options, the buttons, then the outcome card: a run's
     in-progress line while one is in flight (ADR 0026), else the core's refusal, warnings, cards
     and closing lines, as it gives them (ADR 0007). Every label is a
     pair, {l:T En='...', Ro='...'}. -->

<Window x:Class="CopyWcs.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CopyWcs.Wpf"
        Title="CopyWcs" Height="700" Width="820"
        Icon="/CopyWcs.Wpf;component/Icon/copywcs.ico"
        MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================================================ the band -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Faint}" Text="{Binding Copyright}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- what the tool does, where FlatCheck shows its folder -->
        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,20,0"
                   Text="{l:T En='Copies the plate solve (WCS) from a FITS solved in Siril into the same image processed elsewhere, card by card, without touching its pixels.', Ro='Copiaza plate solve-ul (WCS) dintr-un FITS rezolvat in Siril in aceeasi imagine procesata in alta parte, card cu card, fara sa-i atinga pixelii.'}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Help: the theme's drawn icon, then the word; F1 reaches the same handler through the
               window's PreviewKeyDown. The automation name is the word, since the content is not
               a plain string. Live during a run, as About is: it touches nothing of what runs;
               off with the whole window once a close is held (R-050). -->
          <Button x:Name="HelpButton" Click="HelpClick"
                  AutomationProperties.Name="{l:T En='Help', Ro='Ajutor'}"
                  ToolTip="{l:T En='The manual, at the section about what is on screen (F1)', Ro='Manualul, la sectiunea despre ce e pe ecran (F1)'}">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource HelpIcon}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{l:T En='Help', Ro='Ajutor'}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- as wide as the Browse buttons under it, so the right edges line up -->
          <Button x:Name="AboutButton" Margin="8,0,0,0" MinWidth="88" Click="ShowAbout"
                  Content="{l:T En='About', Ro='Despre'}" ToolTip="{l:T En='Version, licence, components', Ro='Versiune, licenta, componente'}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20,16,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ============================================================ the source -->
      <StackPanel Grid.Row="0">
        <TextBlock Style="{StaticResource Muted}" Text="{l:T En='Plate-solved source (FITS)', Ro='Sursa plate-solved (FITS)'}" />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource Field}" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="88" Content="{l:T En='Browse...', Ro='Alege...'}" Click="BrowseSource" />
        </Grid>
        <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" MinHeight="15" Text="{Binding SourceFacts}" />
      </StackPanel>

      <!-- ============================================================ the destination -->
      <StackPanel Grid.Row="1" Margin="0,10,0,0">
        <TextBlock Style="{StaticResource Muted}" Text="{l:T En='Destination (FITS)', Ro='Destinatia (FITS)'}" />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource Field}" Text="{Binding Dest, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="88" Content="{l:T En='Browse...', Ro='Alege...'}" Click="BrowseDest" />
        </Grid>
        <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" MinHeight="15" Text="{Binding DestFacts}" />
      </StackPanel>

      <!-- ============================================================ in place, or a new file -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton Content="{l:T En='Write into the destination', Ro='Scrie in destinatie'}" IsChecked="{Binding WriteInPlace}" />
          <RadioButton Margin="20,0,0,0" Content="{l:T En='Write a new file', Ro='Scrie un fisier nou'}" IsChecked="{Binding WritesNewFile}" />
        </StackPanel>
        <Grid Margin="0,6,0,0" IsEnabled="{Binding WritesNewFile}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource Field}" Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="88" Content="{l:T En='Browse...', Ro='Alege...'}" Click="BrowseOutput" />
        </Grid>
      </StackPanel>

      <!-- ============================================================ the options and the buttons -->
      <Grid Grid.Row="3" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <CheckBox IsChecked="{Binding IncludeOptical}" Content="{l:T En='Copy the optical metadata too (FOCALLEN, XPIXSZ, ...)', Ro='Copiaza si metadatele optice (FOCALLEN, XPIXSZ, ...)'}" />
          <CheckBox Margin="0,8,0,0" IsChecked="{Binding Force}" Content="{l:T En='Continue even when the dimensions differ or the image is mirrored', Ro='Continua chiar daca dimensiunile difera sau imaginea e oglindita'}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
          <Button MinWidth="110" IsEnabled="{Binding CanPreview}" Content="{l:T En='Preview', Ro='Previzualizare'}" Click="Preview" />
          <Button Margin="8,0,0,0" MinWidth="96" IsEnabled="{Binding CanCopy}" Content="{l:T En='Copy', Ro='Copiaza'}" Click="CopyCards" />
        </StackPanel>
      </Grid>

      <!-- ============================================================ the outcome -->
      <!-- shown while there is an outcome or a run in flight; emptied when a box or an option
           changes and when a run starts, which it then says is in progress (R-053) -->
      <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0"
              Visibility="{Binding HasCard, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- the run in flight: the window's one line, a pair, the card holding nothing else -->
          <TextBlock Grid.Row="0" Style="{StaticResource Muted}" Text="{Binding RunningLine}"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

          <!-- the refusal: the heading is the window's one word, the line is the core's -->
          <StackPanel Grid.Row="1" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Heading}" Foreground="{StaticResource BadBr}" Opacity="1" Text="{Binding RefusedHeading}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding Error}" />
          </StackPanel>

          <ItemsControl Grid.Row="2" ItemsSource="{Binding Warnings}" Focusable="False"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Foreground="{StaticResource WarnBr}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding Mode=OneWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Grid.Row="3" Margin="0,0,0,8" Text="{Binding Heading}"
                     Visibility="{Binding HasHeading, Converter={StaticResource BoolToVis}}" />

          <ListBox Grid.Row="4" ItemsSource="{Binding Cards}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,2" />
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>

          <ItemsControl Grid.Row="5" Margin="0,10,0,0" ItemsSource="{Binding Notes}" Focusable="False"
                        Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding Mode=OneWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
