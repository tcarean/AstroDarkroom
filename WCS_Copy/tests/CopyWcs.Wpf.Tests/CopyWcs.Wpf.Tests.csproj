<Project Sdk="Microsoft.NET.Sdk">
  <!-- The window's tests. A project of its own, not a folder in CopyWcs.Tests: it must target
       net8.0-windows to load WPF, and CopyWcs.Tests, which checks the core and the console,
       stays portable (ADR 0007). What is tested: the view-model against the console (the
       preview's cards, the copy's bytes, the refusals), the windows loading and rendering in
       both languages with no binding error, the command line, the icon. What is not: how it
       looks.
       No <InvariantGlobalization>: WPF cannot bind without culture data (FlatCheck's ADR 0037);
       App.ForceInvariantNumbers pins the culture on the test thread instead. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CopyWcs.Wpf.Tests</RootNamespace>
    <!-- CA1707: underscores in test names are the convention here, not a defect. CA1305: the
         linked FitsTestData formats header cards with ToString(); CopyWcs.Tests is clean
         because its InvariantGlobalization switch tells the analyzer the culture is fixed, and
         this project cannot have that switch (see above), so the rule is silenced here only. -->
    <NoWarn>$(NoWarn);CA1707;CA1305</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <!-- A WPF project gets no System.IO in its implicit usings (Path would collide with
       System.Windows.Shapes.Path); the tests handle files, so it is added here. -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CopyWcs.Wpf\CopyWcs.Wpf.csproj" />
    <ProjectReference Include="..\..\src\CopyWcs.Core\CopyWcs.Core.csproj" />
    <ProjectReference Include="..\..\src\CopyWcs.Cli\CopyWcs.Cli.csproj" />
  </ItemGroup>
  <!-- The FITS generator and the temp folder are linked from CopyWcs.Tests, not copied: two
       generators would mean a test here and one there work on slightly different files
       without anyone knowing. -->
  <ItemGroup>
    <Compile Include="..\CopyWcs.Tests\FitsTestData.cs" Link="Shared\FitsTestData.cs" />
    <Compile Include="..\CopyWcs.Tests\TempWorkspace.cs" Link="Shared\TempWorkspace.cs" />
    <Compile Include="..\CopyWcs.Tests\TestData.cs" Link="Shared\TestData.cs" />
  </ItemGroup>
  <!-- LogCapture configures the diagnostic log for the whole test assembly, at Trace, and lets a
       test read its own lines (ADR 0009): linked, so the window's tests and the console's run
       every log line the same way. -->
  <ItemGroup>
    <Compile Include="..\CopyWcs.Tests\LogCapture.cs" Link="Shared\LogCapture.cs" />
  </ItemGroup>
</Project>
