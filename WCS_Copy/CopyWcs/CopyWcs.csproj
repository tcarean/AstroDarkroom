<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>copywcs</AssemblyName>
    <RootNamespace>CopyWcs</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Versiunea uneltei. Se incrementeaza MANUAL, de mana, la fiecare feature/fix.
         E singura sursa de adevar: VersionInfo o citeste din assembly, nu o hardcodeaza. -->
    <Version>1.0.0</Version>

    <!-- Copyright-ul si licenta. <Copyright> ajunge in AssemblyCopyrightAttribute, de
         unde il citeste LicenseInfo.Copyright si il tipareste sub banner, la fiecare
         rulare - deci asta e singurul loc de schimbat. Programul e GPLv3; textul complet
         e in LICENSE, la radacina repo-ului. -->
    <Copyright>Copyright (C) 2026 Tudor Carean</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CopyWcs.Tests" />
  </ItemGroup>

</Project>
