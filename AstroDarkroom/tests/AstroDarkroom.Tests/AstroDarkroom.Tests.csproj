<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AstroDarkroom.Tests</RootNamespace>
    <!-- CA1707: underscores in test names are the convention here, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- The core alone: the window is a thin adapter with no tests (ADR 0001). -->
    <ProjectReference Include="..\..\src\AstroDarkroom.Core\AstroDarkroom.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The manifest, the requirements and the build props travel with the test binaries, so a
         test never depends on the working directory. -->
    <Content Include="..\testdata\fixtures\**" LinkBase="testdata\fixtures" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\testdata\manifest.json" Link="testdata\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\validation.json" Link="docs\validation.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\requirements.md" Link="docs\requirements.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Directory.Build.props" Link="Directory.Build.props" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
