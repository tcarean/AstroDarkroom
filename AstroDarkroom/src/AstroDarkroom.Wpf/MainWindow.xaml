<!-- MainWindow: the suite's banner, one card per app of the catalogue with its "Deschide"
     button, and the bottom bar with "Despre". Everything shown comes from AppRow, built from
     the core; the window's own code starts the process the core planned. -->

<Window x:Class="AstroDarkroom.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AstroDarkroom.Wpf"
        Title="Astro Darkroom" Width="680" SizeToContent="Height"
        Icon="/AstroDarkroom;component/Icon/astrodarkroom.ico"
        MinWidth="520" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="ShowAbout" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================================================ the top bar -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image x:Name="Logo" Grid.Column="0" Width="40" Height="40" Margin="0,0,16,0"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Banner" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0,2,0,0"
                     Text="Uneltele de astrofoto, in ordinea in care se folosesc. Deschide una din randul ei." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ the apps -->
    <ItemsControl x:Name="Rows" Grid.Row="1" Margin="20,16,20,6" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:AppRow}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{Binding Description}" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                  <TextBlock Style="{StaticResource Faint}" Text="{Binding VersionHint}" />
                  <TextBlock Style="{StaticResource Faint}" Margin="10,0,0,0" Foreground="{StaticResource WarnBr}"
                             Text="{Binding UnreleasedHint}" />
                </StackPanel>
              </StackPanel>
              <!-- ShowOnDisabled: the reason an app cannot start is the one thing a disabled
                   button must still tell. -->
              <Button Grid.Column="1" Content="Deschide" MinWidth="104" VerticalAlignment="Center"
                      IsEnabled="{Binding IsAvailable}" ToolTip="{Binding ButtonHint}"
                      ToolTipService.ShowOnDisabled="True" Click="OpenApp" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ============================================================ the bottom bar -->
    <Border Grid.Row="2" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FolderLine" Grid.Column="0" Style="{StaticResource Faint}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <Button Grid.Column="1" Content="Despre" Command="Help" ToolTip="Versiune, licenta, componente (F1)" />
      </Grid>
    </Border>
  </Grid>
</Window>
