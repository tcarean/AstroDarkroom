<!-- MainWindow: the suite's banner, one card per app of the catalogue with its open button,
     and the bottom bar with the language selector and the about button. Everything shown comes
     from AppRow, built from the core; the labels are assigned by the code behind in the current
     language (Relabel), so no user text is written here; the window's own code starts the
     process the core planned. -->

<Window x:Class="AstroDarkroom.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AstroDarkroom.Wpf"
        xmlns:core="clr-namespace:AstroDarkroom.Core;assembly=AstroDarkroom.Core"
        Title="Astro Darkroom" Width="680" SizeToContent="Height"
        Icon="/AstroDarkroom;component/Icon/astrodarkroom.ico"
        MinWidth="520" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="ShowAbout" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================================================ the top bar -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image x:Name="Logo" Grid.Column="0" Width="40" Height="40" Margin="0,0,16,0"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Banner" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0,2,0,0" />
          <!-- What the suite needs on the machine, in one line (R-009); the details are in About. -->
          <TextBlock x:Name="PrerequisitesLine" Style="{StaticResource Faint}" Margin="0,4,0,0" />
          <!-- The Visual C++ runtime LibRaw's DLLs need, shown only when Windows could not load it
               at start (R-018): the text, then Microsoft's link. The runs touch, so no space slips in. -->
          <TextBlock x:Name="RuntimeWarning" Style="{StaticResource Muted}" Foreground="{StaticResource WarnBr}"
                     Margin="0,6,0,0" Visibility="Collapsed"><Run x:Name="RuntimeWarningText" /><Hyperlink x:Name="RuntimeLink" Foreground="{StaticResource AccentBr}" RequestNavigate="OpenRuntimeLink"><Run x:Name="RuntimeLinkText" /></Hyperlink></TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ the apps -->
    <ItemsControl x:Name="Rows" Grid.Row="1" Margin="20,16,20,6" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:AppRow}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- The app's own icon (R-010), dimmed like the button when the file is missing. -->
              <Image Grid.Column="0" Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,14,0"
                     VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                  <Style TargetType="Image">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{Binding Description}" />
                <TextBlock Style="{StaticResource Faint}" Margin="0,5,0,0" Text="{Binding VersionHint}" />
              </StackPanel>
              <!-- ShowOnDisabled: the reason an app cannot start is the one thing a disabled
                   button must still tell. -->
              <Button Grid.Column="2" Content="{Binding OpenLabel}" MinWidth="104" VerticalAlignment="Center"
                      IsEnabled="{Binding IsAvailable}" ToolTip="{Binding ButtonHint}"
                      ToolTipService.ShowOnDisabled="True" Click="OpenApp" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ============================================================ the bottom bar -->
    <Border Grid.Row="2" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderBr}" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FolderLine" Grid.Column="0" Style="{StaticResource Faint}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <!-- The language selector (R-006): each language named in itself, with its flag drawn
             in App.xaml (ADR 0007), so a user finds theirs whatever the current language; the
             choice is remembered (R-007). The TextBlocks drop the implicit style so they take
             the button's Foreground, which the style changes when checked. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
          <RadioButton x:Name="EnglishChoice" Style="{StaticResource LanguageChoice}"
                       GroupName="Language" Tag="{x:Static core:UiLanguage.English}" Checked="LanguageChecked">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource FlagEnglish}" Style="{StaticResource Flag}" />
              <TextBlock Style="{x:Null}" Text="English" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="RomanianChoice" Style="{StaticResource LanguageChoice}" Margin="4,0,0,0"
                       GroupName="Language" Tag="{x:Static core:UiLanguage.Romanian}" Checked="LanguageChecked">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource FlagRomanian}" Style="{StaticResource Flag}" />
              <TextBlock Style="{x:Null}" Text="Romana" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <Button x:Name="AboutButton" Grid.Column="2" Command="Help" />
      </Grid>
    </Border>
  </Grid>
</Window>
