<Project Sdk="Microsoft.NET.Sdk">
  <!-- The launcher's window, AstroDarkroom.exe: one row per app of the catalogue and the
       "Despre" window. A thin adapter over AstroDarkroom.Core, which decides what is shown and
       what is started; this project binds and calls Process.Start (ADR 0001). net8.0-windows +
       UseWPF makes it Windows-only. Not named ".App": the repository's root .gitignore ignores
       "*.app". -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AstroDarkroom.Wpf</RootNamespace>
    <AssemblyName>AstroDarkroom</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The executable's icon (Explorer, the taskbar); the windows take the same file through
         the <Resource> below and Icon= in their XAML. Drawn per size by Icon/make_icon.py. -->
    <ApplicationIcon>..\..\Icon\astrodarkroom.ico</ApplicationIcon>
    <!-- The LibraryImports are source-generated as unsafe code: DarkTitleBar's
         (DwmSetWindowAttribute, ADR 0004) and ScreenArea's (MonitorFromWindow, GetMonitorInfoW,
         R-016); nothing else in the project is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AstroDarkroom.Core\AstroDarkroom.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The launcher's own icon and the copies of the six components' (R-010, ADR 0011;
         SuiteTests keeps them equal to the components' files), each shown beside its row
         through Icons.LargestFrame. -->
    <Resource Include="..\..\Icon\*.ico" Link="Icon\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- GPLv3 wants a copy of the licence to travel with every copy of the program, and
         "Despre" says it is in LICENSE beside the executable, so it has to be there: in the
         build output and in whatever is published from it. The components publish the same
         text under the same name, so the suite's merge sees equal bytes, not a collision. -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- The licences of everything others wrote that the suite folder ships, whole (R-017, ADR
         0014): the repository's Markdown, beside the executables under the name "Despre" gives
         (ThirdParty.NoticesFile), a .txt that Windows opens with a double click. No component
         publishes a file of that name. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- A self-contained publish carries the .NET runtime, so it carries the runtime's licence and
       its third-party notices too, copied unchanged from the Microsoft.NETCore.App runtime pack
       the publish resolved, under the names THIRD-PARTY-NOTICES.txt gives them (R-017, ADR
       0014). The WindowsDesktop pack's LICENSE has the same words and the pack no notices file.
       A pack without the two files stops the publish rather than ship the runtime without them. -->
  <Target Name="PublishDotnetLicenceTexts" AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="ResolveFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_NetCoreRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <PropertyGroup>
      <_NetCoreRuntimePackDirectory>@(_NetCoreRuntimePack->'%(PackageDirectory)')</_NetCoreRuntimePackDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NetCoreRuntimePackDirectory)\LICENSE.TXT') or !Exists('$(_NetCoreRuntimePackDirectory)\THIRD-PARTY-NOTICES.TXT')"
           Text="The Microsoft.NETCore.App runtime pack ('$(_NetCoreRuntimePackDirectory)') has no LICENSE.TXT or THIRD-PARTY-NOTICES.TXT; the suite folder does not ship the runtime without them (R-017)." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_NetCoreRuntimePackDirectory)\LICENSE.TXT" RelativePath="DOTNET-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(_NetCoreRuntimePackDirectory)\THIRD-PARTY-NOTICES.TXT" RelativePath="DOTNET-THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
