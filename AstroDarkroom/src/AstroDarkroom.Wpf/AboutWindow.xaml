<!-- AboutWindow: the icon, the banner, the copyright, the GPLv3 notice (section 5(d)), the
     suite's date and the version of every component bundled, from release.json. Modal; Enter
     and Esc close it. Every text is assigned by the code behind in the current language; the
     product name is the same in both. -->

<Window x:Class="AstroDarkroom.Wpf.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/AstroDarkroom;component/Icon/astrodarkroom.ico"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

  <StackPanel Margin="24,20,24,20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image x:Name="Logo" Grid.Column="0" Width="72" Height="72" VerticalAlignment="Top" Margin="0,2,20,0"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Astro Darkroom" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="Tagline" Style="{StaticResource Muted}" Margin="0,4,0,0" />
        <TextBlock x:Name="Banner" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}" />
        <TextBlock x:Name="Copyright" Style="{StaticResource Faint}" Margin="0,2,0,0" />
      </StackPanel>
    </Grid>

    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock x:Name="LicenceHeading" Style="{StaticResource Heading}" />
        <TextBlock x:Name="Warranty" Style="{StaticResource Muted}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock x:Name="ComponentsHeading" Style="{StaticResource Heading}" />
        <TextBlock x:Name="ReleaseLine" Style="{StaticResource Muted}" Margin="0,0,0,10" />
        <ItemsControl x:Name="Components" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}" />
                <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" Text="{Binding Version, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Faint}" Foreground="{StaticResource WarnBr}"
                           Text="{Binding Note, Mode=OneWay}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Button x:Name="CloseButton" IsCancel="True" IsDefault="True" Click="CloseClick"
            HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="96" />
  </StackPanel>
</Window>
