<!-- App: the palette and the few styles both windows share. Dark, like the components'
     windows (the tool is used at night, beside the mount); the same colours as LightsCheck's
     Theme/Dark.xaml, reduced to what a list of rows and an About box need. -->

<Application x:Class="AstroDarkroom.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBg"  Color="#1B1B1D" />
    <SolidColorBrush x:Key="PanelBg"   Color="#232326" />
    <SolidColorBrush x:Key="PanelBg2"  Color="#2B2B2F" />
    <SolidColorBrush x:Key="HoverBg"   Color="#33333A" />
    <SolidColorBrush x:Key="BorderBr"  Color="#3A3A40" />
    <SolidColorBrush x:Key="TextBr"    Color="#E4E4E7" />
    <SolidColorBrush x:Key="MutedBr"   Color="#9A9AA3" />
    <SolidColorBrush x:Key="FaintBr"   Color="#6E6E77" />
    <SolidColorBrush x:Key="AccentBr"  Color="#4EA8DE" />
    <SolidColorBrush x:Key="WarnBr"    Color="#E3B341" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBr}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBr}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Foreground" Value="{StaticResource FaintBr}" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBr}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Tooltips: WPF draws them light, and the application's text is light, so they would
         be white on white; the palette's panel instead. -->
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource PanelBg2}" />
      <Setter Property="Foreground" Value="{StaticResource TextBr}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HasDropShadow" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" MaxWidth="360" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBr}" />
      <Setter Property="Background" Value="{StaticResource PanelBg2}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The language selector of the main window (R-006): two RadioButtons drawn like the
         buttons, the checked one lit by the accent border; a plain ComboBox would bring the
         system's light chrome into the dark window. -->
    <Style x:Key="LanguageChoice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedBr}" />
      <Setter Property="Background" Value="{StaticResource PanelBg2}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBr}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBr}" />
                <Setter Property="Foreground" Value="{StaticResource TextBr}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The flags on the language buttons (ADR 0007), drawn as vectors: Windows renders the
         emoji flags as two letters, and a bitmap would blur at every DPI. Both are drawn at
         their official proportions and shown 13 px high, aliased, so the stripes stay crisp.
         The United States flag for English: thirteen stripes and the blue canton, the stars
         as a grid of dots that reads as the lighter field they are at this size. -->
    <DrawingImage x:Key="FlagEnglish">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H19 V10 H0 Z" />
          <GeometryDrawing Brush="#B22234"
                           Geometry="M0,0 H19 V0.769 H0 Z M0,1.538 H19 V2.308 H0 Z M0,3.077 H19 V3.846 H0 Z M0,4.615 H19 V5.385 H0 Z M0,6.154 H19 V6.923 H0 Z M0,7.692 H19 V8.462 H0 Z M0,9.231 H19 V10 H0 Z" />
          <GeometryDrawing Brush="#3C3B6E" Geometry="M0,0 H7.6 V5.385 H0 Z" />
          <GeometryDrawing Brush="#FFFFFF">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <EllipseGeometry Center="0.76,0.67" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="2.28,0.67" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="3.8,0.67" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="5.32,0.67" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="6.84,0.67" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="0.76,2.02" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="2.28,2.02" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="3.8,2.02" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="5.32,2.02" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="6.84,2.02" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="0.76,3.37" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="2.28,3.37" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="3.8,3.37" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="5.32,3.37" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="6.84,3.37" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="0.76,4.71" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="2.28,4.71" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="3.8,4.71" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="5.32,4.71" RadiusX="0.3" RadiusY="0.3" />
                <EllipseGeometry Center="6.84,4.71" RadiusX="0.3" RadiusY="0.3" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The Romanian tricolour: cobalt blue, chrome yellow, vermilion, 2:3. -->
    <DrawingImage x:Key="FlagRomanian">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#002B7F" Geometry="M0,0 H5 V10 H0 Z" />
          <GeometryDrawing Brush="#FCD116" Geometry="M5,0 H10 V10 H5 Z" />
          <GeometryDrawing Brush="#CE1126" Geometry="M10,0 H15 V10 H10 Z" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="Flag" TargetType="Image">
      <Setter Property="Height" Value="13" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
    </Style>

    <!-- The scroll bars, first that of "Despre" on a screen too small for it (R-016): WPF draws
         them light, so LightsCheck's dark style, whole, a thin thumb and invisible page buttons,
         its horizontal form included, since an implicit style applies to every scroll bar. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="#4A4A52" CornerRadius="4" Margin="3" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="11" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
